<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <ResourceId>/subscriptions/a4e17822-d794-4a64-9661-6957205c0f3e/resourcegroups/brokeriqdev-resource-group/providers/Microsoft.Web/sites/BrokerIqWebDev</ResourceId>
    <ResourceGroup>brokeriqdev-resource-group</ResourceGroup>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://brokeriqwebdev.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <ProjectGuid>96f6903e-ca4e-4a8f-89ac-614a362fa529</ProjectGuid>
    <MSDeployServiceURL>brokeriqwebdev.scm.azurewebsites.net:443</MSDeployServiceURL>
