@using System.Net
@using System.Text
@using BrokerIQ.Dto.Enum;
@using BrokerIQ.Online.Models;
@using BrokerIQ.Online.Server.Extensions;
@using BrokerIQ.Online.Server.Models;
@using BrokerIQ.Online.Services.Interface;
@using System.IO;
@using Microsoft.Extensions.Options;
@using BrokerIQ.Online.Server.AppSettings;

@inject IBrokerDefinedMessageService BrokerDefinedMessageService
@inject IDialogService DialogService
@inject IOptions<FileUploadSettings> FileUploadSettingsOption;
@inject IChatService ChatService;

<MudDialog DisableSidePadding="true">
    <DialogContent>
        <MudContainer Style="max-height: 800px; overflow-y: scroll">
            <div class="control_wrapper mb-5">
                <MudSelect T="string"
                           Label="Select Message Template"
                           Placeholder="Select Message Template"
                           Clearable="true"
                           @bind-Value="SelectedTemplateMessage"
                           AdornmentColor="Color.Primary">
                    @foreach (string message in @BrokerDefinedMessages)
                    {
                        <MudSelectItem Value="@message">@message</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="col-sm-6 control_wrapper mb-5" style="display:flex; flex-direction: row;">
                <MudDatePicker Label="Replace INSERT_DATE in template" @bind-Date="SelectedTemplateDateReplacement" />
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" @onclick="@InsertTemplateMessage" class="btn btn-primary mb-2">Send To Chat</MudButton>
            </div>

            <div class="col-sm-6 mt-1">
                <div class="card">
                    <div class="card-body">
                        <label class="card-title">Upload pdf files</label>
                        <MudPaper @ondragenter="@(() => DragEnterStyle = "drag-enter")"
                                  @ondragleave="@(() => DragEnterStyle = null)"
                                  @ondragend="@(() => DragEnterStyle = null)"
                                  Class=@("drag-drop-zone " + DragEnterStyle)>

                            <InputFile OnChange="LoadFiles" multiple class="drag-drop-input" accept="application/pdf" />
                            <MudText Typo="Typo.subtitle1">Drag and drop pdf files here to attach to chat</MudText>
                        </MudPaper>
                        @if (LoadedChatFiles.Any())
                        {
                            var filename = LoadedChatFiles[0].Name;
                            <MudButton Variant="Variant.Filled" Color="Color.Error" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DeleteChatDocument())" class="btn btn-link">Remove @filename</MudButton>
                        }
                    </div>
                </div>
            </div>

            <div class="col-sm-6 mt-1">
                <div class="card">
                    <div class="card-body">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" @onclick="@(f => NewChat())" class="btn btn-primary mb-2">
                            New Chat Message
                        </MudButton>
                    </div>
                </div>
            </div>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"  OnClick="Ok">Send</MudButton>
    </DialogActions>
</MudDialog>


@code 
{
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public List<(string, int)> Customers { get; set; }

    public string SelectedTemplateMessage { get; set; }

    public List<string> BrokerDefinedMessages = new List<string>();

    public DateTime? SelectedTemplateDateReplacement { get; set; }

    protected List<IBrowserFile> LoadedChatFiles = new();

    public string LoadFileStatus { get; set; }

    private FileUploadSettings fileUploadSettings { get; set; }

    public string DragEnterStyle { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Loading = false;

        PopulateBrokerDefinedMessages();

