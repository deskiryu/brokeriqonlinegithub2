@using System.Net
@using System.Text
@using BrokerIQ.Dto.Enum;
@using BrokerIQ.Online.Models;
@using BrokerIQ.Online.Server.Extensions;
@using BrokerIQ.Online.Server.Models;
@using BrokerIQ.Online.Services.Interface;
@using System.IO;
@using Microsoft.Extensions.Options;
@using BrokerIQ.Online.Server.AppSettings;

@inject IBrokerDefinedMessageService BrokerDefinedMessageService
@inject IDialogService DialogService
@inject IOptions<FileUploadSettings> FileUploadSettingsOption;
@inject IChatService ChatService;
@inject IAlertService AlertService;

<MudDialog DisableSidePadding="true">
    <DialogContent>
        <MudContainer Style="max-height: 800px; overflow-y: scroll">
            <div class="row">

                <div class="col-sm-6 mt-1">
                    <div class="card">
                        <div class="card-body">
                            <label class="card-title">Upload pdf files</label>
                            <MudPaper @ondragenter="@(() => DragEnterStyle = "drag-enter")"
                            @ondragleave="@(() => DragEnterStyle = null)"
                            @ondragend="@(() => DragEnterStyle = null)" Class=@("drag-drop-zone " + DragEnterStyle)>
                                <InputFile OnChange="LoadFiles" multiple class="drag-drop-input"
                                    accept="application/pdf" />
                                <MudText Typo="Typo.subtitle1">Drag and drop pdf files here to attach to chat</MudText>
                            </MudPaper>
                            @if (LoadedChatFiles.Any())
                            {
                                var filename = LoadedChatFiles[0].Name;
                                <MudButton Variant="Variant.Filled" Color="Color.Error"
                                    Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DeleteChatDocument())"
                                    class="btn btn-link">Remove @filename</MudButton>
                            }
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                Style="@($"color:{Colors.Shades.Black};")" @onclick="@(f => NewChat())"
                                class="btn btn-primary mb-2">
                                Compose Chat Message
                            </MudButton>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 mt-1">
                    <div class="card">
                        <div class="card-body">
                            <p>Will be sent to: </p>
                            @foreach (var user in CustomerNames)
                            {
                                <MudText Style="white-space: pre-line;">@user</MudText>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"
            OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>


@code
{
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public List<(string, int)> Customers { get; set; }

    [Parameter] public int BrokerID { get; set; }

    protected List<IBrowserFile> LoadedChatFiles = new();

    public string LoadFileStatus { get; set; }

    private FileUploadSettings fileUploadSettings { get; set; }

    public string DragEnterStyle { get; set; }

    public List<string> CustomerNames { get; set; }

    public List<int> CustomerIds { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Loading = false;
        fileUploadSettings = this.FileUploadSettingsOption.Value;
        CustomerNames = Customers.Select(x => x.Item1).ToList();
        CustomerIds = Customers.Select(x => x.Item2).ToList();

    }

    private bool Loading = false;

    private void Ok()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel()
    {
        MudDialog.Close(DialogResult.Cancel());
    }

    protected async Task LoadFiles(InputFileChangeEventArgs e)
    {
        if (e.FileCount > 1)
        {
            var dialogParams = new DialogParameters();
            dialogParams.Add("Message", $"Only one document per chat message");
            await DialogService.Show<AlertDialog>("Send Notification", dialogParams).Result;

        }
        LoadedChatFiles.Clear();
        foreach (var file in e.GetMultipleFiles(1))
        {
            try
            {
                var ext = Path.GetExtension(file.Name);
                if (ext != ".pdf")
                {
                    throw new Exception("Pdf files only");
                }
                LoadedChatFiles.Add(file);
            }
            catch (Exception ex)
            {
                LoadFileStatus = ex.Message;

                break;
            }
        }
    }

    protected async Task DeleteChatDocument()
    {
        LoadedChatFiles.Clear();
    }

    protected async Task NewChat(string messageToshow = "")
    {
        bool succeeded = false;

        var fileAttached = false;
        var sdoc = new ChatDocument();
        var dialogParams = new DialogParameters();

        try
        {
            if (LoadedChatFiles.Any())
            {
                var fileName = "";
                var memoryStream = new MemoryStream();
                var file = LoadedChatFiles[0];
                if (file != null)
                {
                    fileAttached = true;
                    fileName = LoadedChatFiles[0].Name;

                    if (file.Size > this.fileUploadSettings.MaxFileSize)
                    {
                        dialogParams.Add("Oversize", "true");
                        fileAttached = false;
                    }
                    else
                    {
                        await file.OpenReadStream(this.fileUploadSettings.MaxFileSize).CopyToAsync(memoryStream);

                        sdoc.FileName = fileName;
                        sdoc.File = memoryStream.ToArray();

                        dialogParams.Add("Filenames", new List<string> { sdoc.FileName });
                        dialogParams.Add("MemoryStreams", new List<MemoryStream> { memoryStream });
                    }
                }
            }
        }
        catch
        {
            fileAttached = false;
        }

        dialogParams.Add("PrePopulatedMessage", messageToshow);

        var result = await DialogService.Show<MessageSendDialog>("Send Chat", dialogParams).Result;
        if (!result.Cancelled)
        {
            var message = result.Data.ToString();

            try
            {
                if (!string.IsNullOrEmpty(message))
                {
                    if (fileAttached)
                    {
                        succeeded = (await ChatService.SendMultipleWithDoc(message, CustomerIds, BrokerID, sdoc));
                    }
                    else
                    {
                        succeeded = (await ChatService.SendMultiple(message, CustomerIds, BrokerID));
                    }
                }
            }
            catch
            {
                succeeded = false;
            }
        }

        if (!succeeded)
        {
            AlertService.Error("Chat sending failed for some or all clients, check the chat to see.");
        }
        else
        {
            AlertService.Success("Chat successfully sent.");
        }
        MudDialog.Close(DialogResult.Ok("true"));

        return;
    }
    protected async Task SendAppLinks()
    {
        bool succeeded = false;

        var fileAttached = false;
        var sdoc = new ChatDocument();
        var dialogParams = new DialogParameters();
        dialogParams.Add("Message", $"App links will be sent to the chat for customers from the list. Proceed?");
        var result = await DialogService.Show<ConfirmCancelDialog>("Insurance Add", dialogParams).Result;
        var agreed = !result.Cancelled;

        if (agreed)
        {
            try
            {
                succeeded = (await ChatService.SendMultipleAppLink(CustomerIds, BrokerID));
            }
            catch
            {
                succeeded = false;
            }
        }

        if (!succeeded)
        {
            AlertService.Error("Chat app link sending failed for some or all clients, check the chat to see.");
        }
        else
        {
            AlertService.Success("Chat app link successfully sent.");
        }
        MudDialog.Close(DialogResult.Ok("true"));
        return;
    }
}