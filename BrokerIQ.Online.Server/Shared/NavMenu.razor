@using System.Net

@using BrokerIQ.Online.Models
@using BrokerIQ.Online.Services
@using BrokerIQ.Online.Server.AppSettings;
@using BrokerIQ.Online.AppSettings;
@using BrokerIQ.Online.Services.Interface
@using BrokerIQ.Online.Server.Components
@using BrokerIQ.Online.Server.Helper
@using BrokerIQ.Online.Server.Extensions
@using BrokerIQ.Online.Server.Models

@using Microsoft.Extensions.Options;


@inject LoggedInAppState MyLoggedInAppState
@inject MessageCountState MyMessageCountState
@inject INotificationService NotificationService
@inject IOptions<ReviewItAPIDetails> api

@implements IDisposable

@inject IJSRuntime js

@functions {
    async void ChangeIcon(string iconName)
    {
        await ExtensionClass.ChangeIcon(js, iconName);
    }
}

<div class="collapse">
    <ul class="nav flex-column">

        @if (IsLoggedIn)
        {
            <li class="nav-item px-2 d-flex align-center">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <i class="fa-solid fa-house" aria-hidden="true"></i> Home
                </NavLink>
            </li>



            @if (!User.IsMinorAdmin)
            {
                <li class="nav-item px-2 d-flex align-center">
                    <NavLink class="nav-link" href="clientlist">
                        <i class="fa-solid fa-list" aria-hidden="true"></i> Clients
                    </NavLink>
                    <TutorialVideoIcon Visible="@ShowClientListTutorial" VideoUrl="@tutorialVideos.CustomersVideoUrl" />
                </li>
            }

            @if (User.IsAdmin || User.IsMinorAdmin)
            {
                <li class="nav-item px-2 d-flex align-center">
                    <NavLink class="nav-link" href="videolist">
                        <i class="fa-solid fa-tv" aria-hidden="true"></i> Videos (admin)
                    </NavLink>
                </li>
            }

            <li class="nav-item px-2 d-flex align-center">
                <NavLink class="nav-link" href="videolist2">
                    <i class="fa-solid fa-tv" aria-hidden="true"></i> Videos
                </NavLink>
                <TutorialVideoIcon Visible="@ShowVideoListTutorial" VideoUrl="@tutorialVideos.VideosVideoUrl" />
            </li>

            @if (!User.IsMinorAdmin && HasAudioFunctionality())
            {
                <li class="nav-item px-2 d-flex align-center">
                    <NavLink class="nav-link" href="audiolist">
                        <i class="fa-solid fa-bullhorn" aria-hidden="true"></i> Voice Recordings
                    </NavLink>
                    <TutorialVideoIcon Visible="@ShowAudioListTutorial" VideoUrl="@tutorialVideos.AudioVideoUrl" />
                </li>
            }

            <li class="nav-item px-2 d-flex align-center">
                <NavLink class="nav-link" href="notifications">
                    <i class="fa-solid fa-phone" aria-hidden="true"></i> Tracking outbound
                </NavLink>
                <TutorialVideoIcon Visible="@ShowNotificationsTutorial" VideoUrl="@tutorialVideos.NotificationsVideoUrl" />
            </li>

            <li class="nav-item px-2 d-flex align-center">
                <NavLink class="nav-link" href="emailinvitations">
                    <i class="fa-solid fa-envelope-open" aria-hidden="true"></i> Invitations
                </NavLink>
                <TutorialVideoIcon Visible="@ShowInvitationsTutorial" VideoUrl="@tutorialVideos.InvitationsVideoUrl" />
            </li>

            <li class="nav-item px-2 d-flex align-center">
                <NavLink class="nav-link" href="referrals">
                    <i class="fa-solid fa-link" aria-hidden="true"></i> Referrals
                </NavLink>
                <TutorialVideoIcon Visible="@ShowReferralsTutorial" VideoUrl="@tutorialVideos.ReferralsVideoUrl" />
            </li>


            <li class="nav-item px-2 d-flex align-center">
                <NavLink class="nav-link" href="messagelist">
                    <MudBadge Content="@NewMessageCount" Overlap="true" Color="@(NewMessageHide ? Color.Inherit : Color.Error)" Dot="@NewMessageHide" Origin="Origin.CenterCenter">
                        <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                    </MudBadge>
                    Action stream
                </NavLink>
                <TutorialVideoIcon Visible="@ShowMessageListTutorial" VideoUrl="@tutorialVideos.MessageListVideoUrl" />
            </li>

            @if (User.IsAdmin || User.IsMinorAdmin)
            {
                <li class="nav-item px-2 d-flex align-center">
                    <NavLink class="nav-link" href="brokerlist">
                        <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i> Brokers
                    </NavLink>
                </li>
            }
            else
            {
                <li class="nav-item px-2 d-flex align-center">
                    <NavLink class="nav-link" href="brokeredit\0">
                        <i class="fa-solid fa-table-cells-large" aria-hidden="true"></i> Details
                    </NavLink>
                    <TutorialVideoIcon Visible="@ShowBrokerTutorial" VideoUrl="@tutorialVideos.BrokerVideoUrl" />
                </li>
            }

            @if (User.IsAdmin || User.IsMinorAdmin || User.IsBroker || User.IsAdminStaff)
            {
                <li class="nav-item px-2 d-flex align-center">
                    <NavLink class="nav-link" href="brokerstafflist">
                        <i class="fa-solid fa-users" aria-hidden="true"></i> Employees
                    </NavLink>
                    <TutorialVideoIcon Visible="@ShowEmployeesTutorial" VideoUrl="@tutorialVideos.EmployeesVideoUrl" />
                </li>

            }

            @if (!User.IsMinorAdmin)
            {
                <li class="nav-item px-2 d-flex align-center">
                    <NavLink class="nav-link" href="settingsedit">
                        <i class="fa-solid fa-gear" aria-hidden="true"></i> Settings
                    </NavLink>
                    <TutorialVideoIcon Visible="@ShowSettingsTutorial" VideoUrl="@tutorialVideos.SettingsVideoUrl" />
                </li>
            }

            @if(api.Value.ShowWorkflows)            {
                <li class="nav-item px-2 d-flex align-center">
                    <NavLink class="nav-link" href="workflows">
                        <i class="fa-solid fa-diagram-project" aria-hidden="true"></i> Workflows
                    </NavLink>
                </li>
            }

            @if (!User.IsAdmin && !User.IsMinorAdmin)
            {
                <li class="nav-item px-2 d-flex align-center">
                    <NavLink class="nav-link" href=@($"charts/_dashboard/0")>
                    <i class="fa-solid fa-chart-line" aria-hidden="true"></i> Dashboard
                    </NavLink>
                </li>
            }

            <li class="nav-item px-2 d-flex align-center">
                <NavLink class="nav-link" href="trainingvideolist">
                    <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i> Training Videos
                </NavLink>
            </li>

            <li class="nav-item px-2 d-flex align-center">
                <NavLink class="nav-link" href="account/logout">
                    <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Logout
                </NavLink>
            </li>

            <li style="height:40px" />

            <li class="nav-item px-2 d-flex align-center">
                <NavLink class="nav-link" href="https://brokeriq.co.uk/report-an-issue/" target="_blank">
                    <i class="fa-solid fa-lightbulb" aria-hidden="true"></i> Report An Issue
                </NavLink>
            </li>
        }
        else
        {
            <li class="nav-item px-2 d-flex align-center">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <i class="fa-solid fa-house" aria-hidden="true"></i> Home
                </NavLink>
            </li>

            <li class="nav-item px-2 d-flex align-center">
                <NavLink class="nav-link" href="account/login">
                    <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> Login
                </NavLink>
            </li>

            <li style="height:40px" />

            <li class="nav-item px-2 d-flex align-center">
                <NavLink class="nav-link" href="https://brokeriq.co.uk/report-an-issue" target="_blank">
                    <i class="fa-solid fa-lightbulb" aria-hidden="true"></i> Report An Issue
                </NavLink>
            </li>
        }
    </ul>
</div>

@code {
    [Inject]
    IAccountService AccountService { get; set; }

    [Inject]
    IBrokerService BrokerService { get; set; }

    [Inject]
    NavigationManager Navigator { get; set; }

    [Inject]
    public IOptions<TutorialVideos> TutorialVideosOption { get; set; }

    protected TutorialVideos tutorialVideos { get; set; }

    private bool IsLoggedIn = false;

    private User User { get; set; }

    private int NewMessageCount;

    private bool NewMessageHide;

    private Broker Broker;

    private System.Threading.Timer _timer;

    protected override async Task OnInitializedAsync()
    {
        tutorialVideos = TutorialVideosOption.Value;

        IsLoggedIn = await AccountService.IsLoggedIn();

        User = await AccountService.GetUser();

        if (User is not null && (User.IsBroker || User.IsAdminStaff || User.IsBrokerStaff))
        {
            Broker = await BrokerService.GetBroker(User.MasterBrokerId, eagerload: true);
        }

        NewMessageHide = true;
        if (IsLoggedIn)
        {
            _timer = new System.Threading.Timer(async _ =>
            {

                await UpdateMessageCount();
                await InvokeAsync(StateHasChanged);

            }, null, 1000, 5000);
        }
        else
        {
            _timer?.Dispose();
        }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private async Task UpdateMessageCount()
    {
        NewMessageHide = true;

        if (User.IsAdmin == false && User.IsMinorAdmin == false)
        {
            var response = await NotificationService.GetNewBrokerNotificationsCountByBrokerId();
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigator.NavigateTo($"account/logout");
                return;
            }

            NewMessageCount = response.Data;
            NewMessageHide = NewMessageCount == 0;
        }
    }

    private bool HasAudioFunctionality()
    {
        if (Broker is null) return false;

        return Broker.BrokerIdentifier.HasAudio;
    }

    private bool ShowClientListTutorial { get { return Navigator.ToBaseRelativePath(Navigator.Uri).Equals("clientlist"); } }

    private bool ShowVideoListTutorial { get { return Navigator.ToBaseRelativePath(Navigator.Uri).Equals("videolist2"); } }

    private bool ShowAudioListTutorial { get { return Navigator.ToBaseRelativePath(Navigator.Uri).Equals("audiolist"); } }

    private bool ShowNotificationsTutorial { get { return Navigator.ToBaseRelativePath(Navigator.Uri).Equals("notifications"); } }

    private bool ShowInvitationsTutorial { get { return Navigator.ToBaseRelativePath(Navigator.Uri).Equals("emailinvitations"); } }

    private bool ShowReferralsTutorial { get { return Navigator.ToBaseRelativePath(Navigator.Uri).Equals("referrals"); } }

    private bool ShowMessageListTutorial { get { return Navigator.ToBaseRelativePath(Navigator.Uri).Equals("messagelist"); } }

    private bool ShowBrokerTutorial { get { return Navigator.ToBaseRelativePath(Navigator.Uri).Equals("brokeredit/0"); } }

    private bool ShowEmployeesTutorial { get { return Navigator.ToBaseRelativePath(Navigator.Uri).Equals("brokerstafflist"); } }

    private bool ShowSettingsTutorial { get { return Navigator.ToBaseRelativePath(Navigator.Uri).Equals("settingsedit/0"); } }
}
