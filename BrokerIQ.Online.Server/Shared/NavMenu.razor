@using BrokerIQ.Online.Models
@using BrokerIQ.Online.Services.Interface
@using BrokerIQ.Online.Server.Helper
@using BrokerIQ.Online.Server.Extensions

@inject LoggedInAppState MyLoggedInAppState
@inject MessageCountState MyMessageCountState
@inject INotificationService NotificationService

@implements IDisposable

@inject IJSRuntime js

@functions {
    async void ChangeIcon(string iconName)
    {
        await Extensions.ChangeIcon(js, iconName);
    }
}

<div class="top-row pl-4 navbar navbar-dark">
    <a class="navbar-brand" href="">
        <img src="https://secureservercdn.net/160.153.137.91/84h.fdf.myftpupload.com/wp-content/uploads/2022/05/iq-test-logo.png?time=1658393204"
            width="" height="" alt="BrokerIQ" class="white-logo default-logo"></a>
    <button class="navbar-toggler" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <ul class="nav flex-column">

        @if (IsLoggedIn)
        {
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="oi oi-home" aria-hidden="true"></span> Home
                </NavLink>
            </li>

            @if (!User.IsMinorAdmin)
            {
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="clientlist">
                        <span class="oi oi-list-rich" aria-hidden="true"></span> Clients
                    </NavLink>
                </li>
            }

            @if (User.IsAdmin || User.IsMinorAdmin)
            {
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="videolist">
                    <span class="oi oi-monitor" aria-hidden="true"></span> Videos (admin)
                </NavLink>
            </li>
            }

            <li class="nav-item px-3">
                <NavLink class="nav-link" href="videolist2">
                    <span class="oi oi-monitor" aria-hidden="true"></span> Videos 
                </NavLink>
            </li>

            @if (!User.IsMinorAdmin)
            {
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="audiolist">
                        <span class="oi oi-bullhorn" aria-hidden="true"></span> Voice Recordings
                    </NavLink>
                </li>


                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="notifications">
                        <span class="oi oi-phone" aria-hidden="true"></span> Notifications
                    </NavLink>
                </li>

                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="emailinvitations">
                        <span class="oi oi-envelope-open" aria-hidden="true"></span> Invitations
                    </NavLink>
                </li>

                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="referrals">
                        <span class="oi oi-envelope-open" aria-hidden="true"></span> Referrals
                    </NavLink>
                </li>

                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="messagelist">
                        @if (NewMessageHide)
                        {
                            ChangeIcon("_content/BrokerIQ.Online.Server/favicon.ico");
                            <MudBadge Content="@NewMessageCount" Overlap="true" Color="Color.Inherit" Dot="true">
                                <MudIcon Icon="@Icons.Material.Filled.Email" Style="color: #d7d7d7; margin-left:-3px" />
                                &nbsp;&nbsp;Reminders&nbsp;&nbsp;&nbsp;
                            </MudBadge>
                        }
                        else
                        {
                            ChangeIcon("_content/BrokerIQ.Online.Server/favicon-alert.ico");
                            <MudBadge Content="@NewMessageCount" Overlap="true" Color="Color.Error " Dot="false">
                                <MudIcon Icon="@Icons.Material.Filled.Email" Style="color: #d7d7d7; margin-left:-3px" />
                                &nbsp;&nbsp;Reminders&nbsp;&nbsp;&nbsp;
                            </MudBadge>
                        }
                    </NavLink>
                </li>
            }

            @if (User.IsAdmin || User.IsMinorAdmin)
            {
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="brokerlist">
                        <span class="oi oi-grid-two-up" aria-hidden="true"></span> Brokers
                    </NavLink>
                </li>
            }
            else
            {
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="brokeredit\0">
                        <span class="oi oi-grid-two-up" aria-hidden="true"></span> Details
                    </NavLink>
                </li>
            }

            @if (User.IsAdmin || User.IsMinorAdmin || User.IsBroker)
            {
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="brokerstafflist">
                        <span class="oi oi-people" aria-hidden="true"></span> Employees
                    </NavLink>
                </li>
            }

            @if (!User.IsAdmin && !User.IsMinorAdmin)
            {
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="templateedit\0">
                        <span class="oi oi-cog" aria-hidden="true"></span> Settings
                    </NavLink>
                </li>
            }

            <li class="nav-item px-3">
                <NavLink class="nav-link" href="trainingvideolist">
                    <span class="oi oi-monitor" aria-hidden="true"></span> Training Videos
                </NavLink>
            </li>

            <li class="nav-item px-3">
                <NavLink class="nav-link" href="account/logout">
                    <span class="oi oi-account-logout" aria-hidden="true"></span> Logout
                </NavLink>
            </li>

            <li style="height:40px" />

            <li class="nav-item px-3">
                <NavLink class="nav-link" href="https://brokeriq.co.uk/report-an-issue/" target="_blank">
                    <span class="oi oi-lightbulb" aria-hidden="true"></span> Report An Issue
                </NavLink>
            </li>
        }
        else
        {
            <li class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="oi oi-home" aria-hidden="true"></span> Home
                </NavLink>
            </li>

            <li class="nav-item px-3">
                <NavLink class="nav-link" href="account/login">
                    <span class="oi oi-account-login" aria-hidden="true"></span> Login
                </NavLink>
            </li>

            <li style="height:40px" />

            <li class="nav-item px-3">
                <NavLink class="nav-link" href="https://brokeriq.co.uk/report-an-issue" target="_blank">
                    <span class="oi oi-lightbulb" aria-hidden="true"></span> Report An Issue
                </NavLink>
            </li>
        }
    </ul>
</div>

@code {
    [Inject]
    IAccountService AccountService { get; set; }

    private bool IsLoggedIn = false;
    private User User { get; set; }

    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private int NewMessageCount;
    private bool NewMessageHide;

    private System.Threading.Timer _timer;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }


    protected override async Task OnInitializedAsync()
    {
        IsLoggedIn = await AccountService.IsLoggedIn();

        User = await AccountService.GetUser();

        MyLoggedInAppState.OnChange += OnMyChangeHandler;
        MyMessageCountState.OnMessageCountChange += OnMyMessageCountChangeHandler;

        NewMessageHide = true;
        if (IsLoggedIn)
        {
            _timer = new System.Threading.Timer(async _ =>
           {

               await UpdateMessageCount();
               await InvokeAsync(StateHasChanged);

           }, null, 2000, 5000);           
        }
        else
        {
            _timer?.Dispose();
        }
    }

    public void Dispose()
    {
        MyLoggedInAppState.OnChange -= OnMyChangeHandler;
        MyMessageCountState.OnMessageCountChange -= OnMyMessageCountChangeHandler;
        _timer?.Dispose();
    }

    private async void OnMyChangeHandler()
    {
        // InvokeAsync is inherited, it syncs the call back to the render thread
        await InvokeAsync(async () =>
        {
            await UpdateMessageCount();
            
        });
    }

    private async void OnMyMessageCountChangeHandler()
    {
        // InvokeAsync is inherited, it syncs the call back to the render thread
        await InvokeAsync(async () =>
        {
            await UpdateMessageCount();
        });
    }

    private async Task UpdateMessageCount()
    {
        NewMessageHide = true;

        if (User.IsAdmin == false && User.IsMinorAdmin == false)
        {
            var count = await NotificationService.GetNewBrokerNotificationsCountByBrokerId();
            NewMessageCount = count;
            NewMessageHide = NewMessageCount == 0;
        }
    }
}
