@using System.Net
@using System.Text
@using BrokerIQ.Dto.Enum;
@using BrokerIQ.Online.Models;
@using BrokerIQ.Online.Server.Extensions;
@using BrokerIQ.Online.Server.Models;
@using BrokerIQ.Online.Services.Interface;
@using System.IO;
@using Microsoft.Extensions.Options;
@using BrokerIQ.Online.Server.AppSettings;

@inject IBrokerDefinedMessageService BrokerDefinedMessageService
@inject IDialogService DialogService
@inject IOptions<FileUploadSettings> FileUploadSettingsOption;
@inject IChatService ChatService;
@inject IAlertService AlertService;

<MudDialog DisableSidePadding="true">
    <DialogContent>
        <MudContainer Style="max-height: 800px; overflow-y: scroll">
            <div class="row">
                <div class="col-sm-12 mt-1">
                    <div class="card">
                        <div class="card-body">
                            <p>Video @VideoName will be sent to the chat stream of : </p>
                            @foreach (var user in CustomerNames)
                            {
                                <MudText Style="white-space: pre-line;">@user</MudText>
                            }
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-body">
                                <MudInputString @bind-Value="Message" Placeholder="Type a message for your video (optional)" Style="width:100%" />

                        </div>
                    </div>
                </div>
            </div>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"
            OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"
                   OnClick="NewChatSend">Send</MudButton>
    </DialogActions>
</MudDialog>


@code
{
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public List<(string, int)> Customers { get; set; }

    [Parameter] public int BrokerID { get; set; }

    [Parameter] public string VideoUrl { get; set; }

    [Parameter] public string VideoName { get; set; }

    [Parameter] public string VideoThumbnailData { get; set; }

    public string Message { get; set; }

    public List<string> CustomerNames { get; set; }

    public List<int> CustomerIds { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Loading = false;

        CustomerNames = Customers.Select(x => x.Item1).ToList();
        CustomerIds = Customers.Select(x => x.Item2).ToList();

    }

    private bool Loading = false;

    private void Ok()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel()
    {
        MudDialog.Close(DialogResult.Cancel());
    }


    protected async Task NewChatSend()
    {
        bool succeeded = false;

        succeeded = (await ChatService.SendMultipleVideoLink(Message, CustomerIds, BrokerID, VideoUrl, VideoThumbnailData));


        if (!succeeded)
        {
            AlertService.Error("Chat sending failed for some or all clients, check the chat to see.");
        }
        else
        {
            AlertService.Success("Chat successfully sent.");
        }
        MudDialog.Close(DialogResult.Ok("true"));

        return;
    }

    protected async Task NewChat(string messageToshow = "")
    {
        bool succeeded = false;

        var fileAttached = false;
        var sdoc = new ChatDocument();
        var dialogParams = new DialogParameters();

        dialogParams.Add("PrePopulatedMessage", messageToshow);

        var result = await DialogService.Show<MessageSendDialog>("Send Chat", dialogParams).Result;
        if (!result.Cancelled)
        {
            var message = result.Data.ToString();

            try
            {
                if (!string.IsNullOrEmpty(message))
                {
                    if (fileAttached)
                    {
                        succeeded = (await ChatService.SendMultipleWithDoc(message, CustomerIds, BrokerID, sdoc));
                    }
                    else
                    {
                        succeeded = (await ChatService.SendMultiple(message, CustomerIds, BrokerID));
                    }
                }
            }
            catch
            {
                succeeded = false;
            }
        }

        if (!succeeded)
        {
            AlertService.Error("Chat sending failed for some or all clients, check the chat to see.");
        }
        else
        {
            AlertService.Success("Chat successfully sent.");
        }
        MudDialog.Close(DialogResult.Ok("true"));

        return;
    }
}