@inherits LayoutComponentBase
@using BrokerIQ.Online.Server.Helper
@inject IDialogService DialogService
@inject LoggedInAppState AppState
@inject IJSRuntime jsRuntime

<MudDialogProvider />
<MudSnackbarProvider />
<MudThemeProvider Theme="MyCustomTheme" />

<MudLayout>
    <MudAppBar Elevation="1" Style="background-color:var(--color-surface); color:var(--color-nav-text);">
        <div class="appbar-brand">
            <img src="https://brokeriq.co.uk/wp-content/uploads/2025/07/yahLogosmall.png" alt="Yavia logo" class="appbar-brand__logo">
            <span class="appbar-brand__text">Yavia</span>
        </div>
        <MudSpacer />
        <MudText Typo="Typo.subtitle1" Style="color:var(--color-nav-text);">@(AppState.LoggedIn ? AppState.FullName : string.Empty)</MudText>
        <MudButton Color="Color.Primary" Style="color:var(--color-nav-text);" Variant="Variant.Outlined" @onclick="OpenDialog">About</MudButton>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="@DrawerVariant.Mini" Style="@DrawerStyle">
        <div class="@SidebarCssClass">
            <NavMenu DrawerOpen="@_drawerOpen" />
        </div>

        <MudPaper Style="text-align: right; background-color:var(--color-surface);border-radius: 0 !important;">
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowLeft" Style="color:var(--color-nav-text);" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" hidden="@(!_drawerOpen)" />
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight" Style="color:var(--color-nav-text);" Edge="Edge.End" OnClick="@((e) => DrawerToggle())" hidden="@_drawerOpen" />
        </MudPaper>
    </MudDrawer>

    <MudMainContent>
        <MudAlert Severity="Severity.Normal" CloseIconClicked="(() => CookieAlertClosed())" Style="@CookieBannerStyle" ShowCloseIcon="true">We use cookies to improve your experience on our website.</MudAlert>

        <div class="p-1">
            <Alert />
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code{
    private const string COOKIE_ALERT = "cookieAlert";

    private const string DRAWER_STATE = "_drawerOut";

    public string CookieBannerStyle { get; set; }

    public string DrawerStyle { get; set; } = "overflow-x: hidden; width: 250px;";

    bool _drawerOpen = true;

    private string SidebarCssClass => _drawerOpen ? "sidebar" : "sidebar sidebar--collapsed";
    async void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
        var width = _drawerOpen ? 250 : 56;
        DrawerStyle = $"overflow-x: hidden; width: {width}px;";

        await jsRuntime.InvokeVoidAsync("localStorage.setItem", DRAWER_STATE, _drawerOpen.ToString());
    }

    MudTheme MyCustomTheme = new MudTheme()
    {
        Palette = new Palette()
        {
            Primary = "#CEBFFA",
            PrimaryLighten = "#E4DAFD",
            PrimaryDarken = "#A997E8",
            Secondary = "#8E7EDC",
            Tertiary = "#6B5CC6",
            AppbarBackground = "#E4DAFD",
            AppbarText = "#1F2937",
            DrawerBackground = "#F8FAFC",
            DrawerText = "#1F2937",
            Surface = "#FFFFFF",
            Background = "#F8FAFC",
            TextPrimary = "#1F2937",
            TextSecondary = "#475569"
        },

        LayoutProperties = new LayoutProperties()
        {
            DrawerWidthLeft = "260px",
            DrawerWidthRight = "300px"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += AppStateChangeHandler;

        var value = await jsRuntime.InvokeAsync<string>("localStorage.getItem", DRAWER_STATE);
        Console.WriteLine($"Drawer State : {value ?? string.Empty}");
        if (value != null)
        {
            bool.TryParse(value, out _drawerOpen);
            _drawerOpen = !_drawerOpen;
            DrawerToggle();
        }

        value = await jsRuntime.InvokeAsync<string>("localStorage.getItem", COOKIE_ALERT);
        bool.TryParse(value, out bool hasBeenClosed);

        CookieBannerStyle = hasBeenClosed ? "display : none" : string.Empty;
    }

    private void AppStateChangeHandler()
    {
        StateHasChanged();
    }

    private void OpenDialog()
    {
        DialogService.Show<VersionDialog>("About BrokerIQ");
    }

    private async Task CookieAlertClosed()
    {
        await jsRuntime.InvokeVoidAsync("localStorage.setItem", COOKIE_ALERT, "true");

        CookieBannerStyle = "display : none";

        StateHasChanged();
    }
    }
