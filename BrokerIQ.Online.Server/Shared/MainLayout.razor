@inherits LayoutComponentBase
@using BrokerIQ.Online.Server.Helper
@using Microsoft.Extensions.Options;
@using BrokerIQ.Online.AppSettings

@inject IDialogService DialogService
@inject LoggedInAppState AppState
@inject IOptions<ReviewItAPIDetails> api
@inject IJSRuntime jsRuntime

<MudDialogProvider />
<MudSnackbarProvider />
@if (api.Value.IsYAHTheme)
{
    <MudThemeProvider Theme="MyCustomThemeYah" />
}
else
{
    <MudThemeProvider Theme="MyCustomTheme2" />
}

<MudLayout>
    <MudAppBar Elevation="1" Style="@(api.Value.IsYAHTheme ? "background-color:#2d2141;" : $"background-color:{Colors.Shades.Black};")">

        @if (api.Value.IsYAHTheme)
        {
            <img src="https://brokeriq.co.uk/wp-content/uploads/2024/07/yahLogo15239.png" alt="BrokerIQ" class="white-logo default-logo">
        }
        else
        {
            <img src="https://brokeriq.co.uk/wp-content/uploads/2022/05/iq-test-logo.png" alt="BrokerIQ" class="white-logo default-logo">
        }
        <MudSpacer />
        <MudText Typo="Typo.subtitle1" Style="@($"color:{Colors.Shades.White};")">@(AppState.LoggedIn ? AppState.FullName : string.Empty)</MudText>
        <MudButton Color="Color.Primary" Style="@($"color:{Colors.Shades.White};")" Variant="Variant.Outlined" @onclick="OpenDialog">About</MudButton>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="@DrawerVariant.Mini" Style="@DrawerStyle">
        <div class="@(api.Value.IsYAHTheme? "sidebar sidebar-yah" : "sidebar")">
            <NavMenu />
        </div>

        <MudPaper Style="@(api.Value.IsYAHTheme ? "text-align: right; background-color:#2d2141;border-radius: 0 !important;" : "text-align: right; background-color:#353c3b;border-radius: 0 !important;")">
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowLeft" Style="@($"color:{Colors.Shades.White};")" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" hidden="@(!_drawerOpen)" />
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight" Style="@($"color:{Colors.Shades.White};")" Edge="Edge.End" OnClick="@((e) => DrawerToggle())" hidden="@_drawerOpen" />
        </MudPaper>
    </MudDrawer>

    <MudMainContent>
        <MudAlert Severity="Severity.Normal" CloseIconClicked="(() => CookieAlertClosed())" Style="@CookieBannerStyle" ShowCloseIcon="true">We use cookies to improve your experience on our website.</MudAlert>

        <div class="p-1">
            <Alert />
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code{
    private const string COOKIE_ALERT = "cookieAlert";

    private const string DRAWER_STATE = "_drawerOut";

    public string CookieBannerStyle { get; set; }

    public string DrawerStyle { get; set; } = "overflow-x: hidden; width: 250px;";

    bool _drawerOpen = true;
    async void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
        var width = _drawerOpen ? 250 : 56;
        DrawerStyle = $"overflow-x: hidden; width: {width}px;";

        await jsRuntime.InvokeVoidAsync("localStorage.setItem", DRAWER_STATE, _drawerOpen.ToString());
    }

    MudTheme MyCustomTheme2 = new MudTheme()
    {
        Palette = new Palette()
        {
            Primary = Colors.Yellow.Default,
            Secondary = Colors.Shades.Black,
            Tertiary = Colors.Blue.Default,

            AppbarBackground = Colors.Red.Default,
            TextPrimary = Colors.Shades.Black,
            TextSecondary = Colors.Shades.Black,
            Background = Colors.Grey.Lighten4,

        },

        LayoutProperties = new LayoutProperties()
        {
            DrawerWidthLeft = "260px",
            DrawerWidthRight = "300px"
        }
    };

    MudTheme MyCustomThemeYah = new MudTheme()
    {
        Palette = new Palette()
        {
            Primary = Colors.DeepPurple.Lighten4,
            Secondary = Colors.Shades.Black,
            Tertiary = Colors.Blue.Default,

            AppbarBackground = Colors.Red.Default,
            TextPrimary = Colors.Shades.Black,
            TextSecondary = Colors.Shades.Black,
            Background = Colors.Grey.Lighten4,

        },

        LayoutProperties = new LayoutProperties()
        {
            DrawerWidthLeft = "260px",
            DrawerWidthRight = "300px"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += AppStateChangeHandler;

        var value = await jsRuntime.InvokeAsync<string>("localStorage.getItem", DRAWER_STATE);
        Console.WriteLine($"Drawer State : {value ?? string.Empty}");
        if (value != null)
        {
            bool.TryParse(value, out _drawerOpen);
            _drawerOpen = !_drawerOpen;
            DrawerToggle();
        }

        value = await jsRuntime.InvokeAsync<string>("localStorage.getItem", COOKIE_ALERT);
        bool.TryParse(value, out bool hasBeenClosed);

        CookieBannerStyle = hasBeenClosed ? "display : none" : string.Empty;
    }

    private void AppStateChangeHandler()
    {
        StateHasChanged();
    }

    private void OpenDialog()
    {
        DialogService.Show<VersionDialog>("About BrokerIQ");
    }

    private async Task CookieAlertClosed()
    {
        await jsRuntime.InvokeVoidAsync("localStorage.setItem", COOKIE_ALERT, "true");

        CookieBannerStyle = "display : none";

        StateHasChanged();
    }
    }