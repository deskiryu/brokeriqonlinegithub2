@inherits LayoutComponentBase
@using BrokerIQ.Online.Server.Helper

@inject IDialogService DialogService
@inject LoggedInAppState AppState

<div class="sidebar">
    <NavMenu />
</div>

<div class="main">
    <div class="top-row px-4" style="background-color:black">
        <MudButton Color="Color.Primary" Style="@($"color:{Colors.Shades.White};")" Class="mr-2" Variant="Variant.Outlined" @onclick="OpenDialog" >About</MudButton>
        @if (AppState.LoggedIn)
        {
            <MudText Typo="Typo.subtitle1" Style="@($"color:{Colors.Shades.White};")" >@AppState.FullName</MudText>
        }
    </div>

    <div class="content px-4">
        <Alert />
        @Body
    </div>
</div>

<MudDialogProvider />
<MudSnackbarProvider/>
<MudThemeProvider Theme="MyCustomTheme2" />



@code{
    MudTheme MyCustomTheme2 = new MudTheme()
    {
        Palette = new Palette()
        {
            Primary = Colors.Yellow.Default,
            Secondary = Colors.Shades.Black,
            Tertiary = Colors.Blue.Default,
            
            AppbarBackground = Colors.Red.Default,
            TextPrimary = Colors.Shades.Black,
            TextSecondary = Colors.Shades.Black,
            Background=Colors.Grey.Lighten4,
            
        },

        LayoutProperties = new LayoutProperties()
        {
            DrawerWidthLeft = "260px",
            DrawerWidthRight = "300px"
        }
    };

    protected override void OnInitialized()
    {
        AppState.OnChange += AppStateChangeHandler;
    }

    private void AppStateChangeHandler()
    {
        StateHasChanged();
    }

        private void OpenDialog()
    {
        DialogService.Show<VersionDialog>("About BrokerIQ");
    }
}