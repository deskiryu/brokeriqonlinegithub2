@code{
    private const string COOKIE_ALERT = "cookieAlert";

    public string CookieBannerStyle { get; set; }

    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    MudTheme MyCustomTheme2 = new MudTheme()
    {
        Palette = new Palette()
        {
            Primary = Colors.Yellow.Default,
            Secondary = Colors.Shades.Black,
            Tertiary = Colors.Blue.Default,

            AppbarBackground = Colors.Red.Default,
            TextPrimary = Colors.Shades.Black,
            TextSecondary = Colors.Shades.Black,
            Background = Colors.Grey.Lighten4,

        },

        LayoutProperties = new LayoutProperties()
        {
            DrawerWidthLeft = "260px",
            DrawerWidthRight = "300px"
        }
    };


    MudTheme MyCustomThemeYah = new MudTheme()
    {
        Palette = new Palette()
        {
            Primary = Colors.DeepPurple.Lighten4,
            Secondary = Colors.Shades.Black,
            Tertiary = Colors.Blue.Default,

            AppbarBackground = Colors.Red.Default,
            TextPrimary = Colors.Shades.Black,
            TextSecondary = Colors.Shades.Black,
            Background = Colors.Grey.Lighten4,

        },

        LayoutProperties = new LayoutProperties()
        {
            DrawerWidthLeft = "260px",
            DrawerWidthRight = "300px"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += AppStateChangeHandler;

        var value = await jsRuntime.InvokeAsync<string>("localStorage.getItem", COOKIE_ALERT);
        bool.TryParse(value, out bool hasBeenClosed);

        CookieBannerStyle = hasBeenClosed ? "display : none" : string.Empty;
    }

    private void AppStateChangeHandler()
    {
        StateHasChanged();
    }

    private void OpenDialog()
    {
        DialogService.Show<VersionDialog>("About BrokerIQ");
    }

    private async Task CookieAlertClosed()
    {
        await jsRuntime.InvokeVoidAsync("localStorage.setItem", COOKIE_ALERT, "true");

        CookieBannerStyle = "display : none";

        StateHasChanged();
    }
}