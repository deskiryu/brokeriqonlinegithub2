@inherits LayoutComponentBase
@inject IDialogService DialogService

<div class="sidebar">
    <NavMenu />
</div>

<div class="main">
    <div class="top-row px-4" style="background-color:black">
        <MudButton Color="Color.Primary" Style="@($"color:{Colors.Shades.White};")" Variant="Variant.Text" @onclick="OpenDialog" class="float-right" >About</MudButton>
    </div>

    <div class="content px-4">
        <Alert />
        @Body
    </div>
</div>

<MudDialogProvider />
<MudThemeProvider Theme="MyCustomTheme" />


@code{
    MudTheme MyCustomTheme = new MudTheme()
    {
        Palette = new Palette()
        {
            Primary = Colors.Yellow.Default,
            Secondary = Colors.Shades.Black,
            Tertiary = Colors.Blue.Default,
            
            AppbarBackground = Colors.Red.Default,
            TextPrimary = Colors.Shades.Black,
            TextSecondary = Colors.Shades.Black,
            Background=Colors.Grey.Lighten4,
            
        },

        LayoutProperties = new LayoutProperties()
        {
            DrawerWidthLeft = "260px",
            DrawerWidthRight = "300px"
        }
    };

    private void OpenDialog()
    {
        DialogService.Show<VersionDialog>("About BrokerIQ");
    }
}