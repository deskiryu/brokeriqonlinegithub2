@using BrokerIQ.Online.Server.Components

<MudDialog>
    <DialogContent>
        <MudTextField T="string" Label="Note" Required="true" RequiredError="Please fill in the note content" @bind-Value="Text" Lines="5" Immediate="true" />
        @if (ShowReminderControls)
        {
            <MudCheckBox T="bool" Label="Set note reminder" @bind-Checked="HasNoteReminder" />
            <MudDatePicker T="DateTime?" Label="Reminder Date" @bind-Date="ReminderDate" Disabled="DisableReminderDate" />
            <TimeOfDay @bind-Value="ReminderTime" Disabled="DisableReminderDate" />
            <MudSpacer />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton OnClick="Confirm" Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black}")" Disabled="TextIsEmpty">OK</MudButton>
    </DialogActions>
</MudDialog>