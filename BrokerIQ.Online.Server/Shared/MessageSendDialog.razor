@using System.ComponentModel.DataAnnotations
@using System.IO

@using BrokerIQ.Online.Server.Extensions
@using BrokerIQ.Online.Services.Interface
@using BrokerIQ.Online.Server.Components

@inject IJSRuntime js

@functions {
    async void PreviewFile(MemoryStream ms)
    {
        await Extensions.PreviewFile(js, ms);
    }
}

<MudDialog>
    <DialogContent>
        <MudContainer Style="overflow-y: scroll">
            <MudTextField T="string" Label="Message to send" Required="true" RequiredError="Please fill in the message" @bind-Value="model.MessageToSend" Lines="5" AutoGrow="true" Immediate="true" />
            <div class="row">
                <div class="col-sm-2 mt-auto">
                    <MudIconButton Icon="@Icons.Material.Filled.InsertLink" Variant="Variant.Filled" Size="Size.Small"
                                   Color="Color.Primary" Style="@($"color:{Colors.Grey.Darken1};")" OnClick="InsertLink"
                                   Disabled="@model.HideLinkButton">
                    </MudIconButton>
                </div>
                <div class="col-sm-10">
                    <MudTextField T="string" Placeholder="Link address" @bind-Value="model.Link" Disabled="@model.HideLinkButton" />
                </div>
            </div>
            <div>
                @if (@OverSized)
                {
                    <br />
                    <MudText>Some files were too big</MudText>
                }

                @if (FileNameAndStreams.Any())
                {
                    <br />
                    <MudText>Attachments :</MudText>
                    @foreach (var fileName in FileNameAndStreams)
                    {
                        <div class="row">
                            <div class="col-sm-2">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Preview" Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="f => PreviewFile(fileName.Item2)">Preview Pdf</MudIconButton>
                            </div>
                            <div class="col-sm-10">
                                <MudText Style="font-weight: bold;">@fileName.Item1</MudText>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <br />
                    <MudText>No file(s) attached</MudText>
                }
                @if (AllowScheduledMessage)
                {
                    <div class="row">
                        <div class="col-sm-6 mt-auto">
                            <MudDatePicker Clearable="AllowNullDateValues" Placeholder="Deliver message on" @bind-Date="@model.DeliveryDate"
                                           MinDate="DateTime.Today" />
                        </div>
                        <div class="col-sm-6 mt-auto">
                            <TimeOfDay @bind-Value="@model.DeliveryTime" />
                        </div>
                    </div>
                }
            </div>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="SendMessage" Disabled="DetailsAreInvalid">Send</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject]
    public IDialogService DialogService { get; set; }

    [Inject]
    public IAlertService AlertService { get; set; }

    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public List<string> FileNames { get; set; }

    [Parameter] public List<MemoryStream> MemoryStreams { get; set; }

    [Parameter] public string Oversize { get; set; }

    [Parameter] public string PrePopulatedMessage { get; set; }

    [Parameter] public bool AllowScheduledMessage { get; set; }

    [Parameter] public DateTime? MessageSendDate { get; set; }

    [Parameter] public TimeSpan? MessageSendTime { get; set; }

    private List<(string, MemoryStream)> FileNameAndStreams { get; set; }

    public bool OverSized { get; set; }

    bool success;
    string[] errors = { };
    MudForm form;
    MessageSendModel model;

    private string SendHour { get; set; }
    private string SendMinute { get; set; }

    bool DetailsAreInvalid
    {
        get
        {
            if (string.IsNullOrWhiteSpace(model.MessageToSend) ||
                (model.DeliveryDate.HasValue && !model.DeliveryTime.HasValue) ||
                (!model.DeliveryDate.HasValue && model.DeliveryTime.HasValue)) return true;

            if (!model.DeliveryDate.HasValue && !model.DeliveryTime.HasValue) return false;

            var selectedDate = model.DeliveryDate.Value.Add(model.DeliveryTime.Value);
            var minimumDate = DateTime.Now.AddMinutes(10);

            return selectedDate <= minimumDate;
        }
    }

    public bool AllowNullDateValues { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        model = new MessageSendModel()
        {
            HasEmbeddedUrl = false,
            HideLinkButton = false,
            DeliveryDate = MessageSendDate,
            DeliveryTime = MessageSendTime
        };

        if (!string.IsNullOrEmpty(Oversize) && Oversize.Contains("true"))
        {
            OverSized = true;
        }

        FileNameAndStreams = new List<(string, MemoryStream)>();

        if (FileNames != null && MemoryStreams != null)
        {
            if (FileNames.Count == MemoryStreams.Count && FileNames.Any())
            {
                for (int i = 0; i < FileNames.Count; i++)
                {
                    FileNameAndStreams.Add((FileNames[i], MemoryStreams[i]));
                }
            }
        }

        if (!string.IsNullOrEmpty(PrePopulatedMessage))
        {
            var startLink = PrePopulatedMessage.IndexOf("<--") + 3;
            var endLink = PrePopulatedMessage.IndexOf("-->");

            model.HideLinkButton = startLink > 0 && endLink > 0;
            if (model.HideLinkButton)
            {
                try
                {
                    model.Link = PrePopulatedMessage.Substring(startLink, endLink - startLink);
                    model.HasEmbeddedUrl = true;
                    PrePopulatedMessage = PrePopulatedMessage.FormatForMobileNotification();
                }
                catch
                {

                }
            }

            model.MessageToSend = PrePopulatedMessage;
        }

        AllowNullDateValues = MessageSendDate is null && MessageSendTime is null;
    }

    public void SendMessage()
    {
        var messageDetails = model.MessageToSend;
        if (model.HasEmbeddedUrl)
        {
            //Find substring
            var found = messageDetails.IndexOf(model.Link);
            if (found > 0)
            {
                messageDetails = messageDetails.Insert(found + model.Link.Length, "-->");
                messageDetails = messageDetails.Insert(found, "<--");
            }
            else
            {
                this.AlertService.Warn("The link has been altered and may not show in the reminder correctly");
            }
        }

        model.MessageToSend = messageDetails;
        MudDialog.Close(DialogResult.Ok(model));
    }

    void Cancel() => MudDialog.Cancel();

    public async void InsertLink()
    {
        if (!model.Link.IsValidUrl())
        {
            var dialogParams = new DialogParameters
{
                { "Message", $"The URL supplied is not valid." }
            };

            await DialogService.Show<AlertDialog>("Validation failure", dialogParams).Result;
            return;
        }

        model.MessageToSend += " ";
        model.MessageToSend += model.Link;
        model.MessageToSend += " ";

        model.HasEmbeddedUrl = true;
        model.HideLinkButton = true;
        StateHasChanged();
    }

    public class MessageSendModel
    {
        [Required]
        public string MessageToSend { get; set; }

        public string Link { get; set; }

        public bool HasEmbeddedUrl { get; set; }

        public bool HideLinkButton { get; set; }

        public DateTime? DeliveryDate { get; set; } = new Nullable<DateTime>();

        public TimeSpan? DeliveryTime { get; set; } = new Nullable<TimeSpan>();

        public bool IsDelayedMessage => DeliveryDate.HasValue && DeliveryTime.HasValue;

        public DateTime? ToBeSentOn => IsDelayedMessage ? DeliveryDate.Value.Add(DeliveryTime.Value) : null;
    }
}