@using System.Net
@using System.Text

<MudDialog DisableSidePadding="true">
    <DialogContent>
        <MudContainer Style="max-height: 300px; overflow-y: scroll">
            @if (Loading)
            {
                <MudProgressCircular Indeterminate="true"></MudProgressCircular>
            }
            else
            {
                <MudText Style="white-space: pre-line;">@Heading </MudText>

                <p></p>
                @foreach (var cust in @Customers)
                {
                    <MudText Style="white-space: pre-line;">@cust</MudText>
                }

            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"  OnClick="Ok">@OkText</MudButton>
        @if(UseWhatsApp){
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"  OnClick="Invite">Add & Invite</MudButton>
        }
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public string Heading { get; set; }

    [Parameter] public List<string> Customers { get; set; }

    [Parameter] public List<(string, int)> EmailInvitation { get; set; }

    [Parameter] public bool Delete { get; set; }

    [Parameter] public bool UseWhatsApp { get; set; }

    private string OkText; 

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Loading = false;

        OkText = Delete? "Delete": "Add";

        if(EmailInvitation!=null && EmailInvitation.Count > 0)
        {
            Customers = new List<string>();
            foreach(var invite in EmailInvitation)
            {
                if (Delete)
                {
                    Customers.Add($"Connection to {invite.Item1} will be deleted");
                }
                else
                {
                    Customers.Add($"Invite {invite.Item2+1} will be sent to {invite.Item1}");                  
                }
 
            }
        }
    }


    private bool Loading = false;

    private void Ok()
    {
        MudDialog.Close(DialogResult.Ok("OK"));
    }

    private void Invite()
    {
        MudDialog.Close(DialogResult.Ok("Invite"));
    }

    private void Cancel()
    {
        MudDialog.Close(DialogResult.Cancel());
    }
}