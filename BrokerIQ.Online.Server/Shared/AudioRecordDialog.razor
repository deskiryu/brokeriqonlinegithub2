
@using BrokerIQ.Online.Server.Helper;
@using BrokerIQ.Online.Services.Interface
@using System.IO
@inject IAudioService AudioService
@inject IAlertService AlertService
@inject IAudioService AudioService
@inject IAudioRecordingService AudioRecordingService
@inject IMetaDefenderCoreService MetaDefenderCoreService
@inject IJSRuntime jsRuntime
@inject IVideoService VideoService

<MudDialog Style="@($"background:{Colors.Grey.Lighten4};")">
    <DialogContent>
        @Message
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" StartIcon="@Icons.Filled.MicNone" class="red-text" id="RecordButton" OnClick="Record">Record</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" class="gray-text" id="StopButton" Disabled="true">Stop</MudButton>
        @ErrorMessage
    <div class="d-flex flex-column py-1" style="margin-top:10px; margin-bottom:10px;">
        <section class="sound-clips">
        </section>

        <audio controls autoplay>
        </audio>
    </div>

    <MudInputString ID="audioVal" @bind-Value="@AudioName" Type="InputType.Text" Placeholder="Recording name" />

    <div class="">
       @if (AudioSaving)
        {
            <div class="mt-5">
                Saving audio...
            </div>
        }
        else if (AudioScanUploading)
        {
            <div class="mt-5">
                Uploading recording to virus scanning service...
            </div>
        }
        else if (AudioScanning)
        {
            <div class="mt-5">
                Scanning audio for viruses (@AudioScanningProgress %)
            </div>
        }
        else if (AudioUploading)
        {
            <div class="mt-5">
                Scan complete. Uploading audio to BrokerIQ...
            </div>
        }

        <div class="spin-row spin-row-bg">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" style="@SpinnerVisible" />
        </div>
    </div>

    </DialogContent>
    <DialogActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" id="SaveButton" OnClick="UploadButtonPushed" >Save</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" id="CancelButton" OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public string Message { get; set; }

    [Parameter] public int BrokerId { get; set; }

    public string ErrorMessage { get; set; }

    public string AudioName { get; set; }

    public bool AudioUploading { get; set; }

    public bool AudioScanUploading { get; set; }

    public bool AudioScanning { get; set; }

    public int AudioScanningProgress { get; set; }

    public bool AudioSaving { get; set; }

    public string SpinnerVisible { get; set; }

    void Cancel() => MudDialog.Cancel();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        SpinnerVisible = "display:none";

        AudioUploading = false;

        AudioScanUploading = false;

        AudioScanning = false;

        AudioSaving = false;
    }

    private async Task Record()
    {
        await jsRuntime.InvokeVoidAsync("MyJSMethods.startRecording");
    }

    private async Task UploadButtonPushed()
    {

        var result = (false,"");
        try{
            if(string.IsNullOrEmpty(AudioName)){
                AlertService.Error("Please provide a name for the recording");
                return;
            }
            bool available = await AudioService.NameAvailable(AudioName, BrokerId);
            if (!available)
            {
                AlertService.Error("That name already exists choose a new one");
                return;
            }

            SpinnerVisible = "display:block";
            AudioSaving = true;
            StateHasChanged();
            AlertService.Info("Before string");
            var isRunningWasm = await RunningWasm.IsWebAssembly(jsRuntime);
            string completeString = "";
            if(isRunningWasm)
            {
                completeString = await jsRuntime.InvokeAsync<string>("MyJSMethods.saveRecording");
            }
            else
            {
                var remaining = 100;
                while (remaining > 0)
                {
                    remaining = await jsRuntime.InvokeAsync<int>("MyJSMethods.saveRecording");
                    completeString += await AudioRecordingService.GetAudioRecordingAsBase64();

                }
            }

            await AudioRecordingService.Delete();
            AudioSaving = false;

            var bytes = Convert.FromBase64String(completeString);
            var stream = new MemoryStream(bytes);
            result = await AudioService.UploadAndAnalyseAudio(AudioName + ".wav", stream, BrokerId);

        }
        catch(Exception ex)
        {
            result.Item2 = ex.Message;
        }

        SpinnerVisible = "display:none";
        if (result.Item1 == true)
        {
            MudDialog.Close(DialogResult.Ok("true"));            
        }
        else
        {
            MudDialog.Close(DialogResult.Ok(result.Item2));
        }
    }
}