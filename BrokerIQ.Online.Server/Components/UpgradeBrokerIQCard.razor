        <CardHeaderContent>
            <MudText Typo="Typo.h6">Upgrade your BrokerIQ</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudText>@Text</MudText>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public string Text { get; set; }
}

