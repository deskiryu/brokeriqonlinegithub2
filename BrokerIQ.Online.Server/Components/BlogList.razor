@using BrokerIQ.Dto.Models
@using BrokerIQ.Online.Services.Interface
@inject IBlogService BlogService;
@inject IJSRuntime JS;

<MudPaper Class="p-4">
    <MudText Typo="Typo.h5">Blogs</MudText>

    @if (blogs == null)
    {
        <MudProgressCircular Indeterminate Color="Color.Primary" />
    }
    else
    {
        <MudTable Items="blogs" Dense="true" Hover="true" RowClick="OnRowClick">
            <HeaderContent>
                <MudTh>Image</MudTh>
                <MudTh>Title</MudTh>
                <MudTh>Summary</MudTh>
                <MudTh>Published</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <img src="@context.FeaturedImage" />
                </MudTd>
                <MudTd>@context.HtmlTitle</MudTd>
                <MudTd>
                    @((MarkupString)context.PostSummary)
                </MudTd>

                <MudTd>@context.PublishDate.ToString("yyyy-MM-dd")</MudTd>
            </RowTemplate>
        </MudTable>

    }
</MudPaper>

@code {
    private List<BlogDto> blogs;

    protected override async Task OnInitializedAsync()
    {
        blogs = (await BlogService.GetAll()).ToList();
    }

    private void OnRowClick(TableRowClickEventArgs<BlogDto> args)
    {
        var url = args.Item.Url;
        if (!string.IsNullOrWhiteSpace(url))
        {
            // Opens in new tab
            var encodedUrl = Uri.EscapeUriString(url);
            _ = JS.InvokeVoidAsync("window.open", encodedUrl, "_blank");
        }
    }
}
