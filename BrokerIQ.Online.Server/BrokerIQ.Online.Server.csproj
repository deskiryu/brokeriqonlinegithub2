<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net7.0</TargetFramework>
        <ApplicationIcon />
        <OutputType>Library</OutputType>
        <StartupObject />
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <Version>1.4.74</Version>
        <Platforms>AnyCPU;x64</Platforms>
    </PropertyGroup>
    <ItemGroup>
        <Content Remove="Pages\Users\Add.razor" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AutoMapper" Version="12.0.0" />
        <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.0" />
        <PackageReference Include="BlazorDateRangePicker" Version="4.0.0" />
        <PackageReference Include="Blazored.SessionStorage" Version="2.2.0" />
        <PackageReference Include="CsvHelper" Version="32.0.3" />
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="7.0.20" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="7.0.20" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="7.0.20" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="7.0.20" />
        <PackageReference Include="Microsoft.AspNetCore.JsonPatch" Version="7.0.5" />
        <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="2.2.0" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="7.0.1" />
        <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="6.15.0" />
        <PackageReference Include="MudBlazor" Version="6.11.2" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
        <PackageReference Include="ChartJs.Blazor.Fork" Version="2.0.2" />
        <PackageReference Include="BrokerIQ.Dto" Version="1.2.96" />
        <PackageReference Include="System.Text.Json" Version="8.0.5" />
        <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    </ItemGroup>
    <ItemGroup>
        <Content Update="wwwroot\js\AudioRecord.js">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
        <None Remove="Converters\" />
        <None Remove="Pages\Wealth\" />
        <None Remove="Pages\Charts\Components\" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Converters\" />
        <Folder Include="Pages\Wealth\" />
        <Folder Include="Pages\Charts\Components\" />
    </ItemGroup>
    <PropertyGroup>
        <NameLength>3</NameLength>
        <ObfuscateEvents>true</ObfuscateEvents>
        <ObfuscateFields>true</ObfuscateFields>
        <ObfuscateMethods>true</ObfuscateMethods>
        <ObfuscateParameters>true</ObfuscateParameters>
        <ObfuscateProperties>true</ObfuscateProperties>
        <ObfuscateTypes>true</ObfuscateTypes>
        <StringEncryption>hash</StringEncryption>
        <ControlFlowObfuscation>goto=on;if=on;switch=on;call=on</ControlFlowObfuscation>
        <ShowStatistics>true</ShowStatistics>
        <SuppressIldasm>false</SuppressIldasm>
        <UnicodeNormalization>false</UnicodeNormalization>
        <OverloadedRenaming>true</OverloadedRenaming>
        <FlattenNamespaces>true</FlattenNamespaces>
        <VerboseLevel>10</VerboseLevel>
        <VirtualFunctions>true</VirtualFunctions>
        <GenerateDebug>false</GenerateDebug>
    </PropertyGroup>
</Project>