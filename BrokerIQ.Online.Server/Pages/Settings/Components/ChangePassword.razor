
<EditForm autocomplete="false" Model="@MyUpdatePassword" OnValidSubmit="@HandleValidPasswordChange" OnInvalidSubmit="@HandleInvalidPasswordChange">
<DataAnnotationsValidator /> 
<div class="form-group row" style="padding-left:15px">
    <div class="form-group col-4">
        <label>Existing Password</label>
        <MudTextField @bind-Value="MyUpdatePassword.ExistingPassword" Label="Existing Password" InputType="@PasswordInputOld" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIconOld" OnAdornmentClick="ShowPasswordOld" AdornmentAriaLabel="Show Password"/>
        <ValidationMessage For="@(() => MyUpdatePassword.ExistingPassword)" />
    </div> 
    <div class="form-group col-4">
        <label>New Password</label>
        <MudTextField @bind-Value="MyUpdatePassword.NewPassword" Label="New Password" InputType="@PasswordInputNew" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIconNew" OnAdornmentClick="ShowPasswordNew" AdornmentAriaLabel="Show Password"/>
        <ValidationMessage For="@(() => MyUpdatePassword.NewPassword)" />
    </div>
    <div class="form-group col-4">
        <label>Confirm New Password</label>
        <MudTextField @bind-Value="MyUpdatePassword.NewConfirmPassword" Label="Confirm New Password" InputType="@PasswordInputNewConfirm" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIconNewConfirm" OnAdornmentClick="ShowPasswordNewConfirm" AdornmentAriaLabel="Show Password"/>
        <ValidationMessage For="@(() => MyUpdatePassword.NewConfirmPassword)" />
    </div>
</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" ButtonType="ButtonType.Submit" class="btn btn-primary edit-btn mt-1">Save Password</MudButton>           
</EditForm>




