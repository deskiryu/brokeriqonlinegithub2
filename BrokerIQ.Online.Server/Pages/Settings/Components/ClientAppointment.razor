@using BrokerIQ.Dto.Enum
@using BrokerIQ.Online.Server.Extensions
@using BrokerIQ.Online.Pages

@inherits ClientAppointmentBase
@inject IJSRuntime js

<div class="row mb-4">
    <div class="col-sm-10">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"
            OnClick="f => SelectExpiredCustomerAppointments()">
            Select Expired
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"
            OnClick="f => RemoveSelectedCustomerAppointments()">
            Delete Selected
        </MudButton>
    </div>
</div>

<MudTable Items="@DefinedAppointments" SortLabel="Sort By" Hover MultiSelection="true"
    @bind-SelectedItems="SelectedItemsCustomerAppointments">
    <NoRecordsContent>
        <MudText>No appointments have been set.</MudText>
    </NoRecordsContent>
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel
                SortBy="new Func<BrokerIQ.Online.Models.CustomerAppointment, object>(x => x.AppointmentDate)">Appointment
                Date</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel
                SortBy="new Func<BrokerIQ.Online.Models.CustomerAppointment, object>(x => x.CustomerEmail)">Customer Name
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.CustomerAppointment, object>(x => x.ContactName)">
                Advisor Name</MudTableSortLabel>
        </MudTh>
        <MudTh>Location</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>

        <MudTd>
            <p Style="@($"color:{context.LabelColour};")">@context.AppointmentDate.Value.ToBiqDateTimeString()</p>
        </MudTd>
        <MudTd>
            @{
                var url = $"clientdetail/{context.CustomerId}";
                <MudLink href="@url" Color="Color.Tertiary">
                    @context.CustomerName
                </MudLink>
            }
        </MudTd>
        <MudTd> @context.ContactName</MudTd>
        <MudTd> @context.Location</MudTd>
        <MudTd>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"
                class="btn btn-primary table-btn" @onclick="f => RemoveCustomerAppointment(context)">
                <i class="fas fa-trash"></i>
            </MudButton>
        </MudTd>

    </RowTemplate>

</MudTable>

@code {
    protected async Task PreviewAttachment(byte[] attachment)
    {
        await ExtensionClass.PreviewFile(js, new System.IO.MemoryStream(attachment));
    }
}