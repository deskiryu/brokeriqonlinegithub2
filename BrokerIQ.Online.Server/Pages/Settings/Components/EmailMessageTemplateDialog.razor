@using BrokerIQ.Online.Server.Extensions <MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudTextField Class="mb-2" Lines="5" @bind-Value=EmailMessageTemplate.Message Label="Name" Required="true" RequiredError="Message cannot be empty" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="PreviewEmail">Preview</MudButton>
        <MudSpacer></MudSpacer>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black}")" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>
