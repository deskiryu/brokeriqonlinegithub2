@using BrokerIQ.Online.Server.Extensions <MudDialog>
    <DialogContent>
        <MudForm @ref="form">


            <MudSelect Validation="@(new Func<int, string>(IsValidReminderType))" Class="mb-2" T="int" Label="Reminder Type" @bind-Value=Option.ReminderTypeId @ref="ReminderTypeId">
                <MudSelectItem Value="0">Not set</MudSelectItem> @{
                    var names = Enum.GetNames(typeof(Dto.Enum.ReminderTypeEnum)); for (int i = 1; i <= names.Length; i++)
                    {
                        var looped = (Dto.Enum.ReminderTypeEnum)i;
                        <MudSelectItem Value="@i">@looped.GetDisplayName()</MudSelectItem>
                    }
                }
            </MudSelect>
            <MudSelect Validation="@(new Func<TimeSpan, string>(IsValidNotificationInterval))" Class="mb-2" T="TimeSpan" Label="Notification Interval" @bind-Value=Option.NotificationPeriod @ref="Notification">
                <MudSelectItem Value="@FromDays270">270 days (9 months) before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays240">240 days (8 months) before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays210">210 days (7 months) before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays180">180 days (6 months) before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays150">150 days (5 months) before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays120">120 days (4 months) before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays90">90 days (3 months) before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays60">60 days (2 months) before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays30">30 days before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays15">15 days before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays7">7 days before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays6">6 days before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays5">5 days before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays4">4 days before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays3">3 days before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays2">2 days before final date</MudSelectItem>
                <MudSelectItem Value="@FromDays1">1 day before final date</MudSelectItem>
                <MudSelectItem Value="@TimeSpan.Zero">Not set</MudSelectItem>
            </MudSelect>
            <MudSelect Validation="@(new Func<int, string>(IsValidTarget))" Class="mb-2" T="int" Label="Reminder Target" @bind-Value=Option.ReminderTargetId @ref="ReminderTargetId">
                <MudSelectItem Value="0">Not set</MudSelectItem> @{
                    var names = Enum.GetNames(typeof(Dto.Enum.ReminderTargetEnum)); for (int i = 1; i <= names.Length; i++)
                    {
                        var looped = (Dto.Enum.ReminderTargetEnum)i;
                        <MudSelectItem Value="@i">@looped.GetDisplayName()</MudSelectItem>
                    }
                }
            </MudSelect>
            <div class="mb-2">
                <p>
                    <MudTooltip Text="Copy to clipboard">
                        <i class="fa-regular fa-copy" onclick="navigator.clipboard.writeText('INSERT_CLIENT_NAME');" />
                    </MudTooltip>
                    <b>INSERT_CLIENT_NAME</b> is replaced in message by the currently selected client.
                </p>
                <p>
                    <MudTooltip Text="Copy to clipboard">
                        <i class="fa-regular fa-copy" onclick="navigator.clipboard.writeText('INSERT_BROKER_NAME');" />
                    </MudTooltip>
                    <b>INSERT_BROKER_NAME</b> is replaced in message by your brokerage name.
                </p>
                <p>
                    <MudTooltip Text="Copy to clipboard">
                        <i class="fa-regular fa-copy" onclick="navigator.clipboard.writeText('INSERT_DATE');" />
                    </MudTooltip>
                    <b>INSERT_DATE</b> is replaced by the insurance review or mortgage promotional end date.
                </p>
                <p>
                    <MudTooltip Text="Copy to clipboard">
                        <i class="fa-regular fa-copy" onclick="navigator.clipboard.writeText('INSERT_INSURANCE_NAME');" />
                    </MudTooltip>
                    <b>INSERT_INSURANCE_NAME</b>  is replaced by the insurance type for insurance reminders.
                </p>
            </div>
            <MudSelect T="int" Label="Starter template" @bind-Value=SelectedStarterTemplate class="mb-2" ToStringFunc="@promptText">
                @for (var i = 1; i < REMINDER_MESSAGES.Length; i++)
                {
                    var currentPrompt = i;
                    <MudSelectItem Value="@currentPrompt" />
                }
            </MudSelect>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black}")" class="mb-3"
                       OnClick="FillTemplate">Fill with starter template</MudButton>

            <MudTextField Lines="5" @bind-Value=Option.MessageContent Label="Message Content" Required="true" RequiredError="Message content cannot be empty" />

            <MudTextField T="string" Class="mb-3" Placeholder="Link address" @bind-Value=OptionLink Disabled="@HideLink"/>
            <MudButton Icon="@Icons.Material.Filled.InsertLink" Variant="Variant.Filled" Size="Size.Small"
                Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="InsertLink" Disabled="@HideLink">
                Add link to template
            </MudButton>

        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black}")" OnClick="Submit">Update</MudButton>
    </DialogActions>
</MudDialog> 