@using BrokerIQ.Online.Server.Extensions <MudDialog>
    <DialogContent>
        <MudForm @ref="form">
            <MudTextField Class="mb-2" @bind-Value=Goal.Description Label="Description" Required="true" RequiredError="Description cannot be empty" />
            <MudCheckBox Class="mb-2" @bind-Value=Goal.RequiresAdditionalInfo Label="Requires additional information"/>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black}")" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>
