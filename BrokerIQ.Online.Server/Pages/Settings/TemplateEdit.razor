@page "/templateedit/{BrokerId}"
@using System.IO
@using BrokerIQ.Online.Server.Pages.Settings.Components
@using Dto.Enum
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Extensions
@inherits TemplateEditBase
@using MudBlazor

@inject IJSRuntime js

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
    <MudTabPanel Text="Templates">
        <p><b>INSERT_CLIENT_NAME</b> is replaced in message by the currently selected client.</p>
        <p><b>INSERT_BROKER_NAME</b> is replaced in message by your brokerage name.</p>
        <p><b>INSERT_DATE</b> is be replaced by a date selected by you on the client chat page.</p>
        <MudTable Items="@MessageElements" Dense="@dense" Hover="@hover" ReadOnly="@ronly" SortLabel="Sort By"
            CommitEditTooltip="Commit Edit" RowEditPreview="BackupMessage" CanCancelEdit="@canCancelEdit"
            RowEditCancel="ResetMessage" RowEditCommit="CommitMessage">
            <ColGroup>
                <col style="width:250px;" />
                <col />
                <col style="width:250px;" />
            </ColGroup>
            <HeaderContent>
                <MudTh>Type</MudTh>
                <MudTh>Template</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Type">@(context.Prompt)</MudTd>
                    <MudTd DataLabel="Name" style="white-space: pre-line">
                        <MudText>@context.Message</MudText>
                        <div>
                            @if (!String.IsNullOrWhiteSpace(@context.FileName))
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                Style="@($"color:{Colors.Shades.Black};")"
                                OnClick="f => PreviewAttachment(context.FileContent)" Size="Size.Small">
                                <i class="fa fa-file-pdf"> &nbsp;@context.FileName</i>
                            </MudButton>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <RowEditingTemplate>
                <MudTd DataLabel="Type">@context.Prompt</MudTd>
                <MudTd DataLabel="Name">
                    <MudTextField Lines="5" style="white-space: pre-line" @bind-Value="@context.Message" Required />
                     @if (!IsCurrentFileToBeRemoved)
                    {
                        var toggleHiddenClass = SelectedFiles.Any() ? "card d-none" : "card";

                        if (String.IsNullOrWhiteSpace(@context.FileName))
                        {
                            <div class="@toggleHiddenClass @HoverClass mt-1" @ondragenter="OnDragEnter" @ondragover="OnDragEnter" @ondragleave="OnDragLeave" @ondrop="OnDragLeave" >
                                    <MudPaper class="drag-drop-zone">
                                        <InputFile OnChange="LoadFiles" Class="drag-drop-input" accept="application/pdf" />
                                        <MudText Typo="Typo.subtitle1">Click or drag pdf file to attach to message</MudText>
                                    </MudPaper>
                            </div>

                            @if (SelectedFiles.Any())
                            {
                                var fileName = SelectedFiles[0].Name;
                                <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                    Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DeleteDefinedDocument())"
                                    class="btn btn-link">Remove @fileName</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                    Style="@($"color:{Colors.Shades.Black};")"
                                    OnClick="f => PreviewAttachment(SelectedFiles.FirstOrDefault())">
                                    <i class="fa fa-eye" />
                                </MudButton>
                            }
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => RemoveCurrentFile())"
                                class="btn btn-link">Remove @context.FileName</MudButton>

                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                Style="@($"color:{Colors.Shades.Black};")"
                                OnClick="f => PreviewAttachment(context.FileContent)">
                                <i class="fa fa-eye" />
                            </MudButton>
                        }
                    }
                </MudTd>
            </RowEditingTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    </MudTabPanel>
    <MudTabPanel Text="Notifications">
        @if (IsBrokerStaff)
        {
            <EditForm Model="@BrokerStaff" OnValidSubmit="@HandleValidSubmitBrokerStaff">
                <div class="row">
                    <div class="card col-lg-6">
                        <div class="card-header">Emails</div>
                        <div class="card-body">
                            <div class="col-lg-6">
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetEmailPreferenceStaff(EmailNotificationPreferencesEnum.NewClientRegistered))"
                                        @onclick="async f => await SetEmailPreferenceStaff(EmailNotificationPreferencesEnum.NewClientRegistered)"
                                            Style="margin-left: -15px">
                                            @EmailNotificationPreferencesEnum.NewClientRegistered.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetEmailPreferenceStaff(EmailNotificationPreferencesEnum.NewClientLoggedIn))"
                                        @onclick="async f => await SetEmailPreferenceStaff(EmailNotificationPreferencesEnum.NewClientLoggedIn)"
                                            Style="margin-left: -15px">
                                            @EmailNotificationPreferencesEnum.NewClientLoggedIn.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetEmailPreferenceStaff(EmailNotificationPreferencesEnum.ClientDocumentUpload))"
                                        @onclick="async f => await SetEmailPreferenceStaff(EmailNotificationPreferencesEnum.ClientDocumentUpload)"
                                            Style="margin-left: -15px">
                                            @EmailNotificationPreferencesEnum.ClientDocumentUpload.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetEmailPreferenceStaff(EmailNotificationPreferencesEnum.ClientNewChat))"
                                        @onclick="async f => await SetEmailPreferenceStaff(EmailNotificationPreferencesEnum.ClientNewChat)"
                                            Style="margin-left: -15px">
                                            @EmailNotificationPreferencesEnum.ClientNewChat.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetEmailPreferenceStaff(EmailNotificationPreferencesEnum.ClientBirthdayVideoBrokerReminder))"
                                        @onclick="async f => await SetEmailPreferenceStaff(EmailNotificationPreferencesEnum.ClientBirthdayVideoBrokerReminder)"
                                            Style="margin-left: -15px">
                                            @EmailNotificationPreferencesEnum.ClientBirthdayVideoBrokerReminder.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card col-lg-6">
                        <div class="card-header">App Notifications</div>
                        <div class="card-body">
                            <div class="col-lg-6">
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetMobilePreferenceStaff(MobileNotificationPreferencesEnum.ClientDocumentUpload))"
                                        @onclick="async f => await SetMobilePreferenceStaff(MobileNotificationPreferencesEnum.ClientDocumentUpload)"
                                            Style="margin-left: -15px">
                                            @MobileNotificationPreferencesEnum.ClientDocumentUpload.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetMobilePreferenceStaff(MobileNotificationPreferencesEnum.ClientNewChat))"
                                        @onclick="async f => await SetMobilePreferenceStaff(MobileNotificationPreferencesEnum.ClientNewChat)"
                                            Style="margin-left: -15px">
                                            @MobileNotificationPreferencesEnum.ClientNewChat.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" Color="Color.Primary"
                    Style="@($"color:{Colors.Shades.Black};")">Save Preferences</MudButton>
            </EditForm>
        }
        else
        {
            <EditForm Model="@Broker" OnValidSubmit="@HandleValidSubmit">
                <div class="row">
                    <div class="card col-lg-6">
                        <div class="card-header">Emails</div>
                        <div class="card-body">
                            <div>
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetEmailPreference(EmailNotificationPreferencesEnum.NewClientRegistered))"
                                        @onclick="async f => await SetEmailPreference(EmailNotificationPreferencesEnum.NewClientRegistered)"
                                            Style="margin-left: -15px">
                                            @EmailNotificationPreferencesEnum.NewClientRegistered.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetEmailPreference(EmailNotificationPreferencesEnum.NewClientLoggedIn))"
                                        @onclick="async f => await SetEmailPreference(EmailNotificationPreferencesEnum.NewClientLoggedIn)"
                                            Style="margin-left: -15px">
                                            @EmailNotificationPreferencesEnum.NewClientLoggedIn.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetEmailPreference(EmailNotificationPreferencesEnum.ClientDocumentUpload))"
                                        @onclick="async f => await SetEmailPreference(EmailNotificationPreferencesEnum.ClientDocumentUpload)"
                                            Style="margin-left: -15px">
                                            @EmailNotificationPreferencesEnum.ClientDocumentUpload.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetEmailPreference(EmailNotificationPreferencesEnum.ClientNewChat))"
                                        @onclick="async f => await SetEmailPreference(EmailNotificationPreferencesEnum.ClientNewChat)"
                                            Style="margin-left: -15px">
                                            @EmailNotificationPreferencesEnum.ClientNewChat.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetEmailPreference(EmailNotificationPreferencesEnum.ClientBirthdayVideoBrokerReminder))"
                                        @onclick="async f => await SetEmailPreference(EmailNotificationPreferencesEnum.ClientBirthdayVideoBrokerReminder)"
                                            Style="margin-left: -15px">
                                            @EmailNotificationPreferencesEnum.ClientBirthdayVideoBrokerReminder.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card col-lg-6">
                        <div class="card-header">App Notifications</div>
                        <div class="card-body">
                            <div >
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetMobilePreference(MobileNotificationPreferencesEnum.ClientDocumentUpload))"
                                        @onclick="async f => await SetMobilePreference(MobileNotificationPreferencesEnum.ClientDocumentUpload)"
                                            Style="margin-left: -15px">
                                            @MobileNotificationPreferencesEnum.ClientDocumentUpload.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox
                                            Checked="@(GetMobilePreference(MobileNotificationPreferencesEnum.ClientNewChat))"
                                        @onclick="async f => await SetMobilePreference(MobileNotificationPreferencesEnum.ClientNewChat)"
                                            Style="margin-left: -15px">
                                            @MobileNotificationPreferencesEnum.ClientNewChat.GetDisplayPrompt()
                                        </MudCheckBox>
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox @bind-Checked=@Broker.ShouldProfileCustomers Style="margin-left: -15px">
                                            Profile customer vulnerability
                                        </MudCheckBox>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox  @bind-Checked=@Broker.NotifyBrokerOfVulnerability Style="margin-left: -15px">
                                            Notify me of vulnerable customers
                                        </MudCheckBox>
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <div class="col-lg-12">
                                        <MudCheckBox @bind-Checked=@Broker.NotifyCustomerOfVulnerability Style="margin-left: -15px">
                                            Notify customer of vulnerability
                                        </MudCheckBox>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" Color="Color.Primary"
                    Style="@($"color:{Colors.Shades.Black};")">Save Preferences</MudButton>
            </EditForm>
        }
    </MudTabPanel>
    <MudTabPanel Text="Reminder Options">
    <ReminderOptionTable Broker="@Broker" User="@User"/>
    </MudTabPanel>
</MudTabs>



@code {
    private List<string> editEvents = new();
    private bool dense = false;
    private bool hover = true;
    private bool ronly = false;
    private bool canCancelEdit = true;
    private MessageElement elementBeforeEdit;

    public string DragEnterStyle { get; set; }


    private void BackupMessage(object element)
    {
        var e = element as MessageElement;

        if (e == null) return;

        elementBeforeEdit = e.GetCopy();
    }

    private void ResetMessage(object element)
    {
        // on cancel edit, reset message
        ((MessageElement)element).Index = elementBeforeEdit.Index;
        ((MessageElement)element).Message = elementBeforeEdit.Message;

        SelectedFiles.Clear();
    }

    protected async Task PreviewAttachment(byte[] attachment)
    {
        await Extensions.PreviewFile(js, new MemoryStream(attachment));
    }

    protected async Task PreviewAttachment(IBrowserFile uploadedFile)
    {
        if (uploadedFile == null) return;

        var contents = new MemoryStream(); ;
        await uploadedFile.OpenReadStream(fileUploadSettings.MaxFileSize).CopyToAsync(contents);
        await Extensions.PreviewFile(js, contents);
    }
}
