@inherits BIQDashboardComponent

<MudPaper Class="px-3 py-2" Style="@PaperStyle">
    <div class="d-flex align-center justify-space-between mb-2">
        <MudText Typo="Typo.subtitle1">@Title</MudText>
        <MudMenu Label="@SelectedPeriodOption" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small">
            @foreach (var period in PeriodOptions)
            {
                var current = period;
                <MudMenuItem>@current</MudMenuItem>
            }
        </MudMenu>
    </div>
    <div class="d-flex align-center justify-space-between">
        @ChildContent
    </div>
</MudPaper>


