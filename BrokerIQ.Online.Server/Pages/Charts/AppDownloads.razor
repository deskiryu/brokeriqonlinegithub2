
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Pages.Charts.Components

@inherits AppDownloadsBase

@page "/charts/AppDownloads/{BrokerId}"

<MudLink Href="@Href" Typo="Typo.h6" Color="Color.Dark" Class="ml-2"> <MudIcon Icon="@Icons.Material.Filled.ArrowBackIosNew"/> Back to Overview</MudLink>

<MudGrid Spacing="2" Class="p-2">
    <MudItem xs="12">
        <BIQKpiCard Title="App Downloads" OnPeriodChange="HandleDownloadPeriodChange" IsLoadingData="IsLoadingDownloadData" SkeletonHeight="450px">
            <Summary>
                <BIQKpiCell Title="Total" Value="@DownloadTotal">
                    <BIQPeriodChange ChangePercent="@DownloadChange" />
                </BIQKpiCell>
            </Summary>
            <Body>
                <BIQChart ChartType="ChartType.Bar" ChartSeries="@DownloadData" XAxisLabels="@DownloadLabels"/>
            </Body>
        </BIQKpiCard>
    </MudItem>
</MudGrid>