@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Pages.Charts.Components

@inherits DashboardBase

@page "/charts/dashboard/{BrokerId}"


<MudGrid Spacing="2" Class="p-2">
    <MudItem xs="12" md="4">
        <BIQKpiCard Title="App Downloads" BackgroundColour="@Pallete[0]" OnPeriodChange="HandleDownloadPeriodChange" OnClick="HandleDownloadOnClick" IsLoadingData="IsLoadingDownloadData">
            <Summary>
                <div class="d-flex align-center justify-space-between">
                    <BIQKpiCell Title="Total" Value="@DownloadTotal">
                        <BIQPeriodChange ChangePercent="@DownloadChange" />
                    </BIQKpiCell>
                    <BIQKpiCell Title="Without Login" Value="@DownloadWithoutLoginTotal">
                        <BIQPeriodChange ChangePercent="@DownloadWithoutLoginChange" />
                    </BIQKpiCell>
                </div>
            </Summary>
        </BIQKpiCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <BIQKpiCard Title="Client Logins" BackgroundColour="@Pallete[1]" OnPeriodChange="HandleClientLoginPeriodChange" OnClick="HandleClientLoginOnClick" IsLoadingData="IsLoadingClientLoginData">
            <Summary>
                <div class="d-flex align-center justify-space-between">
                    <BIQKpiCell Title="Total" Value="@ClientLoginTotal">
                        <BIQPeriodChange ChangePercent="@ClientLoginChange" />
                    </BIQKpiCell>
                    <BIQKpiCell Title="Average" Value="@ClientLoginAverage">
                        @*<BIQPeriodChange ChangePercent="@ClientLoginAverageChange" />*@
                    </BIQKpiCell>
                </div>
            </Summary>
        </BIQKpiCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <BIQKpiCard Title="Chat Messages" BackgroundColour="@Pallete[2]" OnPeriodChange="HandleChatMessagePeriodChange" IsLoadingData="IsLoadingChatMessageData">
            <Summary>
                <div class="d-flex align-center justify-space-between">
                    <BIQKpiCell Title="Total" Value="@ChatMessageTotal">
                        <BIQPeriodChange ChangePercent="@ChatMessageChange" />
                    </BIQKpiCell>
                    <BIQKpiCell Title="Client Average" Value="@ClientChatMessageAverage">
                        <BIQPeriodChange ChangePercent="@ClientChatMessageAverageChange" />
                    </BIQKpiCell>
                </div>
            </Summary>
        </BIQKpiCard>
    </MudItem>

    <MudItem xs="12" md="9">
        <BIQKpiCard Title="Referrals" OnPeriodChange="HandleReferralPeriodChange" IsLoadingData="IsLoadingReferralData" SkeletonHeight="435px">
            <Summary>
                <div class="d-flex align-center justify-start">
                    <BIQKpiCell Title="Total" Value="@ReferralTotal">
                        <BIQPeriodChange ChangePercent="@ReferralChange" />
                    </BIQKpiCell>
                    <BIQKpiCell Title="Conversion" Value="@ConversionTotal">
                        <BIQPeriodChange ChangePercent="@ConversionChange" />
                    </BIQKpiCell>
                </div>
            </Summary>
            <Body>
                <BIQChart ChartType="ChartType.Bar" ChartSeries="ReferralSeries" XAxisLabels="ReferralLabels"></BIQChart>
            </Body>
        </BIQKpiCard>
    </MudItem>

    <MudItem xs="12" md="3">
        <BIQKpiCard OnPeriodChange="HandleReferralSplitPeriodChange" IsLoadingData="IsLoadingReferralSplitData" SkeletonHeight="435px">
            <Body>
                <div style="min-height: 50px;"></div>
                <BIQDonut Data="ReferralSplitData" Labels="ReferralSplitLabels" KPILabel="" KPIValue="@ReferralConvertRate" />
                <div style="min-height: 50px;"></div>
            </Body>
        </BIQKpiCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <BIQKpiCard Title="Video Engagement" BackgroundColour="@Pallete[0]" OnPeriodChange="HandleVideoPeriodChange" IsLoadingData="IsLoadingVideoData">
            <Summary>
                <div class="d-flex align-center justify-space-between">
                    <BIQKpiCell Title="Total Sent" Value="@VideoSentTotal">
                        <BIQPeriodChange ChangePercent="@VideoSentChange" />
                    </BIQKpiCell>
                    <BIQKpiCell Title="Total Viewed" Value="@VideoViewedTotal">
                        <BIQPeriodChange ChangePercent="@VideoViewedChange" />
                    </BIQKpiCell>
                    <BIQKpiCell Title="Average Time" Value="@AverageVideoTimeTotal">
                        <BIQPeriodChange ChangePercent="@AverageVideoTimeChange" />
                    </BIQKpiCell>
                </div>
            </Summary>
        </BIQKpiCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <BIQKpiCard Title="Audio Engagement" BackgroundColour="@Pallete[1]" OnPeriodChange="HandleAudioPeriodChange" IsLoadingData="IsLoadingAudioData">
            <Summary>
                <div class="d-flex align-center justify-space-between">
                    <BIQKpiCell Title="Total Sent" Value="@AudioSentTotal">
                        <BIQPeriodChange ChangePercent="@AudioSentChange" />
                    </BIQKpiCell>
                    <BIQKpiCell Title="Total Viewed" Value="@AudioViewedTotal">
                        <BIQPeriodChange ChangePercent="@AudioViewedChange" />
                    </BIQKpiCell>
                    <BIQKpiCell Title="Average Time" Value="@AverageAudioTimeTotal">
                        <BIQPeriodChange ChangePercent="@AverageAudioTimeChange" />
                    </BIQKpiCell>
                </div>
            </Summary>
        </BIQKpiCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <BIQKpiCard Title="High Risk Clients" OnPeriodChange="HandleCustomerRiskRatingPeriodChange" IsLoadingData="IsLoadingCustomerRiskData" SkeletonHeight="428px">
            <Body>
                <MudTable Items="CustomerRankingList" Style="overflow-x: auto;" Dense="true">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Messages</MudTh>
                        <MudTh>Logins</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@context.MessageCount</MudTd>
                        <MudTd>@context.LoginCount</MudTd>
                    </RowTemplate>
                </MudTable>
            </Body>
        </BIQKpiCard>
    </MudItem>

    <MudItem xs="12" md="8">
        <BIQKpiCard Title="Product Gap" OnPeriodChange="HandleProductsPeriodChange" IsLoadingData="IsLoadingProductData" SkeletonHeight="428px">
            <Summary>
                <div class="d-flex align-center justify-start">
                    <BIQKpiCell Title="Total" Value="@ProductsTotal">
                        <BIQPeriodChange ChangePercent="@ProductsChange" />
                    </BIQKpiCell>
                </div>
            </Summary>
            <Body>
                <BIQChart ChartType="ChartType.Bar" ChartSeries="ProductsSeries" XAxisLabels="ProductsLabels"></BIQChart>
            </Body>
        </BIQKpiCard>
    </MudItem>

    @*<MudItem xs="12">
            <BIQKpiCard Title="Total Clients">
                <Summary>
                    <BIQKpiCell Value="11346">
                        <BIQPeriodChange ChangePercent=".1001" />
                    </BIQKpiCell>
                </Summary>
                <Body>
                    <BIQChart ChartType="ChartType.Bar" ChartSeries="@_series" XAxisLabels="@_xAxisLabels"></BIQChart>
                </Body>
            </BIQKpiCard>
        </MudItem>



