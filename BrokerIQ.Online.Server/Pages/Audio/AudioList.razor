@page "/audiolist"
@inherits AudioListBase
@using System.IO
@using BrokerIQ.Dto.Models
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Services.Interface
@using Shared
@using System.Globalization
@inject IEmailService EmailService
@inject IJSRuntime jsRuntime


<h3 class="page-title">Voice recordings</h3>

<MudButton Variant="Variant.Filled" 
Color="Color.Primary" 
Style="@($"color:{Colors.Shades.Black};")" 
StartIcon="@Icons.Filled.MicNone"
class="btn btn-primary table-btn" 
@onclick="AddRecording">
    New Voice recording
</MudButton>      


@if (Audios == null)
{
    <div>
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    </div>
}
else
{
    <p>@status</p>
    <div class="col-sm">
        <div class="spin-row spin-row-bg">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" style="@SpinnerVisible" />
        </div>
    </div>

    <MudDialog @bind-IsVisible="RenameUploadVisibility">
        <TitleContent>
            Upload & rename Audio
        </TitleContent>
        <DialogContent>

            <MudInputString ID="inVal" @bind-Value="@AudioName" Type="InputType.Text" Placeholder="" />
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="OnCancelPushed">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")">Ok</MudButton>
        </DialogActions>
    </MudDialog>

        @if (IsAdmin)
        {
            <div class="row mt-1">

            <div class="col-lg-8 control_wrapper mb-5">
                <MudSelect T="int" Label="Filter By Broker" Placeholder="Select" Clearable="true" @bind-Value="FilterBrokerId"
                    AdornmentColor="Color.Primary">
                    <MudSelectItem Value="0">Select</MudSelectItem>
                    @foreach (var item in @Brokers)
                                {
                                    <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </div>
        }

        <MudTable Items="@Audios" id="table-video" class="table col-sm-12 table-striped "
            Filter="x => FilterBrokerId>0 ? x.BrokerId==FilterBrokerId : true">
            <HeaderContent>
                <MudTh class="">
                    <MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Server.Models.Audio, object>(x=>x.Name)">Audio Name
                    </MudTableSortLabel>
                </MudTh>
                <MudTh class="">
                    <MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Server.Models.Audio, object>(x=>x.UploadDate)">Uploaded
                    </MudTableSortLabel>
                </MudTh>

                @if (IsAdmin)
                {
                    <MudTh class="">
                        <MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Server.Models.Audio, object>(x=>x.BrokerName)">
                            Broker
                        </MudTableSortLabel>
                    </MudTh>
                }
                <MudTh class="">Send</MudTh>
                <MudTh class="">Delete</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Audio Name">@Path.GetFileNameWithoutExtension(context.Name)</MudTd>
                <MudTd DataLabel="Uploaded">@((context.UploadDate == null) ? "-" : ((DateTimeOffset)context.UploadDate).ToString("g", new CultureInfo("en-GB")))</MudTd>
                @if (IsAdmin)
                {
                    <MudTd DataLabel="Broker">@context.BrokerName</MudTd>
                }

                <MudTd DataLabel="Send">
                    @if (!IsMinorAdmin)
                    {
                        <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Icon="@Icons.Material.Filled.Send"
                            Link="@($"audiodetail/{context.Id}")" />
                    }
                </MudTd>
                <MudTd DataLabel="Delete">
                    <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Icon="@Icons.Material.Filled.DeleteForever"
                        @onclick="f => DeleteAudio(context.Id)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
}