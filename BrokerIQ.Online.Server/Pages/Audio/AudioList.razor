@page "/audiolist"
@inherits AudioListBase
@using System.IO
@using BrokerIQ.Dto.Models
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Services.Interface
@using Shared
@inject IEmailService EmailService
@inject IJSRuntime jsRuntime


<h3 class="page-title">Voice recordings</h3>

<MudButton Variant="Variant.Filled" 
Color="Color.Primary" 
Style="@($"color:{Colors.Shades.Black};")" 
StartIcon="@Icons.Filled.MicNone"
class="btn btn-primary table-btn" 
@onclick="AddRecording">
    New Voice recording
</MudButton>      


@if (Audios == null)
{
    <div>
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    </div>
}
else
{
    <p>@status</p>
    <div class="col-sm">
        <div class="spin-row spin-row-bg">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" style="@SpinnerVisible" />
        </div>
    </div>

    <MudDialog @bind-IsVisible="RenameUploadVisibility">
        <TitleContent>
            Upload & rename Audio
        </TitleContent>
        <DialogContent>

            <MudInputString ID="inVal" @bind-Value="@AudioName" Type="InputType.Text" Placeholder="" />
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="OnCancelPushed">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")">Ok</MudButton>
        </DialogActions>
    </MudDialog>


    <table id="table-Audio" class="table col-sm-12 table-striped ">
        <thead>
            <tr>
                <th class="col-md-10">Voice recording</th>
                <th class="col-md-1">Listen</th>
                <th class="col-md-1">Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var Audio in Audios)
            {
                <tr>
                    <td>@Path.GetFileNameWithoutExtension(Audio.Name)</td>
                    <td>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Link="@($"audiodetail?url={Audio.Url}")" class="btn btn-primary table-btn">
                            <i class="fas fa-headphones"></i>
                        </MudButton>
                    </td>

                    <td>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" class="btn btn-primary table-btn" @onclick="f => DeleteAudio(Audio.Name)">
                            <i class="fas fa-trash"></i>
                        </MudButton>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}