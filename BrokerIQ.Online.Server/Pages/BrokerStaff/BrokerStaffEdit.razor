

@page "/brokerStaffedit/{BrokerStaffId}"
@using BrokerIQ.Online.Models
@using BrokerIQ.Dto.Enum
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Extensions
@using BlazorDateRangePicker
@using System.IO
@using BrokerIQ.Online.Services.Interface

@inherits BrokerStaffEditBase


@if (!Saved)
{
<section class="BrokerStaff-detail">

    <h4 class="page-title">Edit Employee</h4>

    <EditForm Model="@_brokerStaff" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="col-12 row">

            <div class="col-xs-12 col-sm-12 com-md-12 col-lg-12">
                <div class="form-group row">
                    <label class="col-sm-4 col-form-label">First Name</label>

                    <div class="col-sm-8">
                        <InputText id="lastName" class="form-control col-sm-8" @bind-Value="_brokerStaff.FirstName" placeholder="Enter first name for this customer"></InputText>
                        <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => _brokerStaff.FirstName)" />
                    </div>
                </div>
                <div class="form-group row">
                    <label class="col-sm-4 col-form-label">Last Name</label>

                    <div class="col-sm-8">
                        <InputText id="lastName" class="form-control col-sm-8" @bind-Value="_brokerStaff.LastName" placeholder="Enter last name for this customer"></InputText>
                        <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => _brokerStaff.LastName)" />
                    </div>
                </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Two Factor Type</label>
                        <MudRadioGroup class="col-sm-4" @bind-SelectedOption="@_brokerStaff.TwoFactorType">
                            <MudRadio Option="@TwoFactorEnum.Email">Email</MudRadio>
                            <MudRadio Option="@TwoFactorEnum.Sms">Mobile Phone</MudRadio>
                        </MudRadioGroup>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Two Factor SMS Phone Number</label>
                        <div class="col-sm-8">
                            <InputText @bind-Value="_brokerStaff.TwoFactorPhoneNumber" class="form-control col-sm-8" />
                        <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => _brokerStaff.TwoFactorPhoneNumber)" />
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-sm-4 col-form-label">Email Address</label>
                    <div class="col-sm-8">
                        <label type="text" readonly class="form-control-plaintext">@_brokerStaff.EmailAddress</label>
                    </div>
                </div>

     


                <div class="form-group row">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" ButtonType="ButtonType.Submit" class="btn btn-primary edit-btn">Update employee</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" class="btn btn-outline-primary edit-outline-btn" OnClick="@NavigateToOverview">Cancel</MudButton>
                </div>

                    @if (IsAdmin)
                    {
                        <div class="form-group row">
                            <label class="col-sm-4 col-form-label">Two Factor Enabled</label>
                            <div class="col-sm-8">

                                <MudCheckBox @bind-Checked="@_brokerStaff.TwoFactorEnabled" @onclick="async f => await SetTwoFactorEnabled()" Style="margin-left: -15px" />

                            </div>
                        </div>                        
                    }


            </div>

        </div>

    </EditForm>
    <div class="row col-6 mt-1">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" class="btn btn-primary table-btn ml-lg-2 mt-1" @onclick="DeleteCustomer">
            Delete Employee
        </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" class="ml-lg-2 mt-1" @onclick="ResendEmailBrokerStaff">
                Resend Verify Email
            </MudButton>

    </div>
</section>


}
else
{
    <div class="alert @StatusClass">@Message</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Back to employee list</MudButton>
}