@page "/brokerstafflist"
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Services.Interface
@inherits BrokerStaffListBase

@inject INotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IAlertService AlertService


<h3 class="page-title">Employees</h3>

@if (!Saved)
{
    @if (BrokerStaff == null)
    {
        <div>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
        </div>
    }
    else
    {

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Link="@($"brokerstaffadd")" class="btn btn-primary mb-2">
            Add New Employee
        </MudButton>


        <div class="card">
            <div class="card-header">Employees</div>
            <div class="card-body">
                <MudTable Items="@BrokerStaff" Hover="true" SortLabel="Sort By">
                    <HeaderContent>
                        <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.BrokerStaff, object>(x=>x.FirstName)">First Name</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.BrokerStaff, object>(x=>x.LastName)">Last Name</MudTableSortLabel></MudTh>
                        <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.BrokerStaff, object>(x=>x.EmailAddress)">Email Address</MudTableSortLabel></MudTh>
                        @if (IsAdmin)
                        {
                            <MudTh>Broker</MudTh>
                            <MudTh>Two Factor</MudTh>                
                        }
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="First Name">@context.FirstName</MudTd>
                        <MudTd DataLabel="Last Name">@context.LastName</MudTd>
                        <MudTd DataLabel="Email">@context.EmailAddress</MudTd>
                        @if (IsAdmin)
                        {
                            var broker = @Brokers.FirstOrDefault(x => x.Id == @context.BrokerId);
                            <MudTd>@broker.Name</MudTd>
                            <MudTd DataLabel="Two Factor"><MudCheckBox @bind-Checked="@context.TwoFactorEnabled" Disabled="true"></MudCheckBox></MudTd>                        
                        }

                        <MudTd>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Link="@($"brokerstaffedit/{context.Id}")" class="btn btn-primary table-btn">
                                <i class="fas fa-edit"></i>
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
                    </PagerContent>
                </MudTable>
            </div>
        </div>
    }
}
else
{
    <div class="alert @StatusClass">@Message</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Back to employee list</MudButton>
}

