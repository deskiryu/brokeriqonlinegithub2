

@page "/brokerstaffadd"
@using BrokerIQ.Online.Models
@using BrokerIQ.Dto.Enum
@using BrokerIQ.Online.Server.Extensions
@using BlazorDateRangePicker
@using System.IO
@using BrokerIQ.Online.Services.Interface

@inherits BrokerStaffAddBase


@if (!Saved)
{
<section class="Broker-detail">
    <div class="card">
        <h4 class="card-header">Add employee</h4>
        <div class="card-body">
            <EditForm Model="@BrokerStaff" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="col-12 row">

                    <div class="col-xs-12 col-sm-12 com-md-12 col-lg-12">
                        <div class="form-group row" style="padding-left:15px">
                            <div class="form-group col-6">
                                <label> First Name</label>
                                <InputText @bind-Value="BrokerStaff.FirstName" class="form-control" />
                                <ValidationMessage For="@(() => BrokerStaff.FirstName)" />
                            </div>
                            <div class="form-group col-6">
                                <label>Last Name</label>
                                <InputText @bind-Value="BrokerStaff.LastName" class="form-control" />
                                <ValidationMessage For="@(() => BrokerStaff.LastName)" />
                            </div>
                        </div>
                        <div class="form-group row" style="padding-left:15px">
                            <div class="form-group col-6">
                                <label>Email Address</label>
                                <InputText @bind-Value="BrokerStaff.EmailAddress" class="form-control" />
                                <ValidationMessage For="@(() => BrokerStaff.EmailAddress)" />
                            </div>
                        </div>

                        <div class="form-group row" style="padding-left:15px">
                            <div class="form-group col-6">
                                <label>Password</label>
                                <InputText @bind-Value="BrokerStaff.Password" type="password" class="form-control" />
                                <ValidationMessage For="@(() => BrokerStaff.Password)" />
                            </div>
                            <div class="form-group col-6">
                                <label>Confirm Password</label>
                                <InputText @bind-Value="BrokerStaff.ConfirmPassword" type="password" class="form-control" />
                                <ValidationMessage For="@(() => BrokerStaff.ConfirmPassword)" />
                            </div>
                        </div>

                        <div class="form-group row">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" type="submit" class="btn btn-primary edit-btn">Add Employee</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Cancel</MudButton>
                        </div>


                    </div>

                </div>

            </EditForm>
            </div>
        </div>
</section>


}
else
{
    <div class="alert @StatusClass">@Message</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Back to employee list</MudButton>
}