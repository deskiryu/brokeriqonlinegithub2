@using BrokerIQ.Dto.Enum
@using BrokerIQ.Online.Server.Extensions

<MudDialog>
    <DialogContent>
        <MudTable Items="@Definitions" Dense="true" Hover CanCancelEdit="true">
            <HeaderContent>
                <MudTh Style="padding:0px!important"></MudTh>
                <MudTh Style="padding:0px!important"></MudTh>
                <MudTh>Field</MudTh>
                <MudTh Style="padding:0px!important">Active</MudTh>
                <MudTh Style="padding:0px!important">Required</MudTh>
                <MudTh>Default Value</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="padding:0px!important">
                    @if (context.ColumnOrder > 0)
                    {
                        <MudIconButton Style="padding:2px!important" Icon="@Icons.Material.Filled.ArrowCircleUp" Color="Color.Secondary" OnClick=@(r => MoveUp(context))></MudIconButton>
                    }
                </MudTd>
                <MudTd Style="padding:0px!important">
                    @if (context.ColumnOrder < LastSortOrder)
                    {
                        <MudIconButton Style="padding:2px!important" Icon="@Icons.Material.Filled.ArrowCircleDown" Color="Color.Secondary" OnClick=@(r => MoveDown(context))></MudIconButton>
                    }
                </MudTd>
                <MudTd>@context.FieldName</MudTd>
                <MudTd>
                    @if (context.Active)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" />
                    }
                </MudTd>
                <MudTd>
                    @if (context.Required)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Check" />
                    }
                </MudTd>
                <MudTd>@context.DefaultValue</MudTd>
            </RowTemplate>
            <RowEditingTemplate>
                <MudTd Style="padding:0px!important">
                    @if (context.ColumnOrder > 0)
                    {
                        <MudIconButton Disabled="true" Style="padding:2px!important" Icon="@Icons.Material.Filled.ArrowCircleUp" Color="Color.Secondary"></MudIconButton>
                    }
                </MudTd>
                <MudTd Style="padding:0px!important">
                    @if (context.ColumnOrder < LastSortOrder)
                    {
                        <MudIconButton Disabled="true" Style="padding:2px!important" Icon="@Icons.Material.Filled.ArrowCircleDown" Color="Color.Secondary"></MudIconButton>
                    }
                </MudTd>
                <MudTd>
                    <MudText>@context.FieldName</MudText>
                </MudTd>
                <MudTd>
                    <MudCheckBox @bind-Checked="context.Active" />
                </MudTd>
                <MudTd>
                    <MudCheckBox @bind-Checked="@context.Required" />
                </MudTd>
                <MudTd>
                    <MudTextField @bind-Value="context.DefaultValue" />
                </MudTd>
            </RowEditingTemplate>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black}")">Close</MudButton>
    </DialogActions>
</MudDialog>