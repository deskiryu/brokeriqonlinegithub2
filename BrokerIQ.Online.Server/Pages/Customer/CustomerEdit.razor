@page "/clientedit/{CustomerId}"

@using BrokerIQ.Online.Models
@using BrokerIQ.Dto.Dto;
@using BrokerIQ.Dto.Enum
@using BrokerIQ.Dto.Models;
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Extensions
@using BlazorDateRangePicker
@using System.IO
@using BrokerIQ.Online.Services.Interface
@using BrokerIQ.Online.AppSettings
@using Microsoft.Extensions.Options

@inject IOptions<ReviewItAPIDetails> api

@inherits CustomerEditBase

@if (!Saved)
{
    <section class="Customer-detail">
        <h4 class="page-title">Add or edit client</h4>

        <EditForm Model="@Customer" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">

            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (Broker is not null && Broker.ProvidesWealthServices)
            {
                <div class="form-group row">
                    <label class="col-sm-4 col-form-label">Wealth</label>
                    <div class="col-sm-8">
                        <MudSelect T="int?"
                                   Margin="Margin.Dense"
                                   Dense="true"
                                   Placeholder="None chosen"
                                   Clearable="true"
                                   @bind-Value="@Customer.WealthTypeId">
                            @{
                                foreach (var item in WealthTypes)
                                {
                                    var looped = item;
                                    <MudSelectItem Value=@((int?)looped.Id)>@looped.Name</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </div>
                </div>
            }

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">First Name</label>

                <div class="col-sm-8">
                    <InputText id="lastName" class="form-control col-sm-8" @bind-Value="Customer.FirstName" placeholder="Enter first name for this client"></InputText>
                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Customer.FirstName)" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Last Name</label>

                <div class="col-sm-8">
                    <InputText id="lastName" class="form-control col-sm-8" @bind-Value="Customer.LastName" placeholder="Enter last name for this client"></InputText>
                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Customer.LastName)" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Business Name</label>

                <div class="col-sm-8">
                    <InputText id="lastName" class="form-control col-sm-8" @bind-Value="Customer.BusinessName" placeholder="Enter business name for this client"></InputText>
                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Customer.BusinessName)" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Telephone Number</label>
                <div class="col-sm-8">
                    <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Customer.TelephoneNumber" placeholder="Enter telephone for this client"></InputText>
                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Customer.TelephoneNumber)" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Date Of Birth</label>
                <div class="col-sm-8">
                    <DateRangePicker @bind-StartDate="DateOfBirth" SingleDatePicker="true" placeholder=" Enter DOB for this client" class="form-control col-sm-8"
                                     Culture="@(System.Globalization.CultureInfo.GetCultureInfo("en-GB"))">
                    </DateRangePicker>
                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Customer.DateOfBirth)" />
                </div>
            </div>

            @if (this.api.Value.ShowProtection)
            {
                <div class="form-group row">
                    <label class="col-sm-4 col-form-label">Gender</label>
                    <div class="col-sm-8">
                        <MudSelect T="int"
                                   Margin="Margin.Dense"
                                   Dense="true"
                                   @bind-Value="@SelectedGender">
                            @{
                                var values = Enum.GetValues(typeof(GenderEnum)).Cast<GenderEnum>();
                                foreach (var item in values)
                                {
                                    GenderEnum looped = item;
                                    <MudSelectItem Value=@((int)looped)>@looped.GetDisplayName()</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </div>
                </div>
            }

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Address</label>
                <div class="col-sm-8">
                    <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Customer.Address" placeholder="Enter address for this client"></InputText>
                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Customer.Address)" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Category</label>
                <div class="col-sm-8">
                    <MudSelect T="int"
                               Margin="Margin.Dense"
                               Dense="true"
                               Placeholder="None chosen"
                               @bind-Value="@SelectedCustomerCategory">
                        @{
                            var values = Enum.GetValues(typeof(CustomerCategoryEnum)).Cast<CustomerCategoryEnum>();
                            foreach (var item in values)
                            {
                                CustomerCategoryEnum looped = item;
                                <MudSelectItem Value=@((int)looped)>@looped.GetDisplayName()</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Employment Status</label>
                <div class="col-sm-8">
                    <MudSelect T="int"
                               Margin="Margin.Dense"
                               Dense="true"
                               @bind-Value="@SelectedEmploymentStatus">
                        @{
                            var values = Enum.GetValues(typeof(EmploymentEnum)).Cast<EmploymentEnum>();
                            foreach (var item in values)
                            {
                                EmploymentEnum looped = item;
                                <MudSelectItem Value=@((int)looped)>@looped.GetDisplayName()</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Residential Status</label>
                <div class="col-sm-8">
                    <MudSelect T="int"
                               Margin="Margin.Dense"
                               Dense="true"
                               @bind-Value="@SelectedResidentialStatus">
                        @{
                            var values = Enum.GetValues(typeof(ResidentialStatusEnum)).Cast<ResidentialStatusEnum>();
                            foreach (var item in values)
                            {
                                ResidentialStatusEnum looped = item;
                                <MudSelectItem Value=@((int)looped)>@looped.GetDisplayName()</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </div>
            </div>

            @if (this.api.Value.ShowProtection)
            {
                <div class="form-group row">
                    <label class="col-sm-4 col-form-label">Occupation</label>
                    <div class="col-sm-8">

                        <MudAutocomplete T="OccupationDto" @bind-Value="SelectedOccupation" SearchFunc="@SearchOccupations"
                                         AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary"
                                         MinCharacters="@MIN_OCCUPATION_CHARS" SelectValueOnTab="true" Label="@($"Type in {MIN_OCCUPATION_CHARS} letters")" MaxItems="100"
                                         ToStringFunc="@(o=> o == null ? null : $"{o.Description} ({o.OrigoCode})")" />
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-sm-4 col-form-label">Annual Income</label>
                    <div class="col-sm-8">
                        <MudTextField Margin="Margin.Dense" T="int?" @bind-Value="@Customer.AnnualIncome" Format="F2" Adornment="Adornment.Start" AdornmentText="£" />
                    </div>
                </div>
            }

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Video Notifications Allowed</label>
                <div class="col-sm-8">
                    <MudCheckBox @bind-Checked="@Customer.VideoNotificationsAllowed" Style="margin-left: -15px" TriState="false" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Audio Notifications Allowed</label>
                <div class="col-sm-8">
                    <MudCheckBox @bind-Checked="@Customer.AudioNotificationsAllowed" Style="margin-left: -15px" TriState="false" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Profiling Notifications Allowed</label>
                <div class="col-sm-8">
                    <MudCheckBox @bind-Checked="@Customer.ProfilingNotificationsAllowed" Style="margin-left: -15px" TriState="false" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Marketing Notifications Allowed</label>
                <div class="col-sm-8">
                    <MudCheckBox @bind-Checked="@Customer.MarketingMessagesAllowed" Style="margin-left: -15px" TriState="false" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Appointment Notifications Allowed</label>
                <div class="col-sm-8">
                    <MudCheckBox @bind-Checked="@Customer.AppointmentRemindersAllowed" Style="margin-left: -15px" TriState="false" />
                </div>
            </div>

            @if (this.api.Value.ShowProtection)
            {
                <div class="form-group row">
                    <label class="col-sm-4 col-form-label">Is Smoker or Vaper</label>
                    <div class="col-sm-8">
                        <MudCheckBox @bind-Checked="@Customer.IsSmokerOrVaper" Style="margin-left: -15px" TriState="false" />
                    </div>
                </div>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" ButtonType="ButtonType.Submit" class="btn btn-primary edit-btn">Update Client</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Cancel</MudButton>

        </EditForm>

    </section>
}
else
{
    <div class="alert @StatusClass">@Message</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Back to client overview</MudButton>
}

@code {
    DateTimeOffset? DateOfBirth
    {
        get { return GetDTtoDTO(Customer.DateOfBirth); }
        set => Customer.DateOfBirth = SetDTtoDTO(value);
    }

    DateTimeOffset? GetDTtoDTO(DateTime datetimeIn)
    {
        if (Customer != null && datetimeIn != default(DateTime))
        {
            var localTime1 = DateTime.SpecifyKind(datetimeIn, DateTimeKind.Local);
            DateTimeOffset localTime2 = localTime1;
            return localTime2;
        }
        else
        {
            return DateTimeOffset.Now;
        }
    }

    DateTime SetDTtoDTO(DateTimeOffset? value)
    {
        return (value.HasValue ? value.Value : DateTime.MinValue).ToLocalTime().DateTime;
    }
}
