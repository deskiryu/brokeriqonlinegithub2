@page "/clientlist"
@using BrokerIQ.Online.Services.Interface
@using Microsoft.AspNetCore.Components

@inherits CustomerListBase

@inject NavigationManager NavigationManager
@inject IAccountService AccountService

<h3 class="page-title">Clients</h3>

@if (Customers == null)
{
    <div>
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    </div>
}
else
{

    <div class="card ">
        <div class="card-header">Notifications</div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-6 mt-1">
                    <MudInputString @bind-Value="selectedNotification" Placeholder="Type a notification message" Style="width:100%" />
                </div>
                <div class="col-sm-3 mt-1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" @onclick="(async () => await SendNotificationToAll())" >Send Notification to all clients</MudButton>
                </div>
                <div class="col-sm-3 mt-1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" @onclick="(async () => await SendNotificationToSelected())" >Send Notification to selected clients</MudButton>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Filter Clients</div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-4">
                    <label>Filter the list below by name</label>
                    <input @bind-value="SearchTerm" @bind-value:event="oninput" placeholder="Type name" class="filter_customerBroker" />
                </div>
                <div class="col-lg-4 control_wrapper">
                    <MudAutocomplete T="string"
                                     Label="Go direct to client"
                                     Placeholder="Start typing name, email or telephone ..."
                                     AdornmentColor="Color.Primary"
                                     TextChanged="@AutoCompleteClick"
                                     SearchFunc="@OnFilter">
                    </MudAutocomplete>
                </div>
                <div class="col-lg-4">
                        <MudSelect T="int"
                                   Label="Filter By Upcoming"
                                   Placeholder="Select"
                                   Clearable="true"
                                   @bind-Value="FilterRecent"
                                   SelectedValuesChanged="@RecentFilterSelect"
                                   AdornmentColor="Color.Primary">
                            <MudSelectItem Value="0">None</MudSelectItem>
                            <MudSelectItem Value="1">Upcoming Insurance Renewal</MudSelectItem>
                            <MudSelectItem Value="2">Upcoming Mortgage Renewal</MudSelectItem>
                        </MudSelect>
                </div>
            </div>

            <div class="row">

                <div class="col-lg-8 control_wrapper">
                    @if (IsAdmin)
                    {
                        <MudSelect T="int"
                                    Label="Filter By Broker"
                                    Placeholder="Select"
                                    Clearable="true"
                                    @bind-Value="BrokerId"
                                    SelectedValuesChanged="@AutoCompleteClickBroker"
                                    AdornmentColor="Color.Primary">
                            <MudSelectItem Value="0">Select</MudSelectItem>
                            @foreach (var item in @Brokers)
                            {
                                <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                            }
                        </MudSelect>            
                    }
                </div>
                <div class="col-lg-4">
                    <MudSelect T="int"
                                Label="Time Period"
                                Placeholder="Select"
                                Clearable="true"
                                @bind-Value="FilterPeriod"
                                SelectedValuesChanged="@RecentFilterSelect"
                                AdornmentColor="Color.Primary">
                        <MudSelectItem Value="0">2 weeks</MudSelectItem>
                        <MudSelectItem Value="1">4 weeks</MudSelectItem>
                        <MudSelectItem Value="2">3 months</MudSelectItem>
                        <MudSelectItem Value="3">6 months</MudSelectItem>
                    </MudSelect>
                </div>
            </div>
        </div>
    </div>

    @code {
        protected override async Task OnInitializedAsync()
        {
            await GetCustomersInit();
        }

        // Initialize SearchTerm to "" to prevent null's
        string SearchTerm { get; set; } = "";

        //filter
        List<BrokerIQ.Online.Models.Customer>
        FilteredCustomers => Customers.Where(i => i.Name.ToLower().Contains(SearchTerm.ToLower())).ToList();
    }
    <div>

    <div class="card">
        <div class="card-header">Clients</div>
        <div class="card-body">
<MudTable Items="@FilteredCustomers" Hover="true" SortLabel="Sort By" >
    <HeaderContent>
        <MudTh></MudTh>
        <MudTh>Select</MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.Customer, object>(x=>x.FirstName)">First Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.Customer, object>(x=>x.LastName)">Last Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel Enabled="@false" SortBy="new Func<BrokerIQ.Online.Models.Customer, object>(x=>x.TelephoneNumber)">Telephone Number</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.Customer, object>(x=>x.EmailAddress)">Email Address</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.Customer, object>(x=>x.DateOfBirth)">Date Of Birth</MudTableSortLabel></MudTh>
        <MudTh>Verified</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><td><img src="@context.PPAsImage" class="rounded-pill" style="width:30px;"/></td></MudTd>
        <MudTd DataLabel="Select"><MudCheckBox @bind-Checked="@context.Selected" ></MudCheckBox></MudTd>
        <MudTd DataLabel="First name">@context.FirstName</MudTd>
        <MudTd DataLabel="Last name">@context.LastName</MudTd>
        <MudTd DataLabel="Telephone">@context.TelephoneNumber</MudTd>
        <MudTd DataLabel="Email">@context.EmailAddress</MudTd>
        <MudTd DataLabel="Date Of Birth">@context.DateOfBirth.ToString("dd/MM/yyyy")</MudTd>
        <MudTd DataLabel="Verified"><MudCheckBox @bind-Checked="@context.EmailConfirmed" Disabled="true"></MudCheckBox></MudTd>
        <MudTd DataLabel="">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Link="@($"clientdetail/{@context.Id}")" >
                <i class="fas fa-info-circle"></i>
            </MudButton>
        </MudTd>

    </RowTemplate>
    <PagerContent>
        <MudTablePager  PageSizeOptions="new int[]{10, 25, 50, 100}" />
    </PagerContent>
</MudTable>
</div>
</div>
    </div>
    @code {


    }
}

