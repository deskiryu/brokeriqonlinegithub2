@page "/clientlist"
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Extensions
@using BrokerIQ.Online.Services.Interface
@using Dto.Enum
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Options
@using BrokerIQ.Online.AppSettings

@inherits CustomerListBase

@inject NavigationManager NavigationManager
@inject IAccountService AccountService
@inject IOptions<ReviewItAPIDetails> api

@if (Customers == null)
{
    <div class="mb-2">
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-0" />
    </div>
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3 customer-list__header">
    <h3 class="page-title mb-0">Clients</h3>
    <div class="d-flex align-items-center gap-3 flex-wrap customer-list__actions">
        <div class="d-flex align-items-center gap-2 flex-wrap customer-list__action-buttons">
        <MudMenu AnchorOrigin="0"
                 Dense="true"
                 Class="send-menu"
                 PopoverClass="send-menu__popover"
                 CloseOnClick="true"
                 Disabled="@(Customers == null || !HasSelectedCustomers)">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Class="filters-trigger send-trigger"
                           Disabled="@(Customers == null || !HasSelectedCustomers)"
                           Style="background-color: #fff;">
                    Send
                    <i class="fa-solid fa-chevron-down ml-2" aria-hidden="true"></i>
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Class="send-menu__item" OnClick="HandleSendNotificationOption">
                    <i class="fa-solid fa-user-group" aria-hidden="true"></i>
                    Send Notification
                </MudMenuItem>
                <MudMenuItem Class="send-menu__item" OnClick="HandleSendChatOption">
                    <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
                    Send Chat
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
        @if (ShouldShowInviteButton)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@(Customers == null || !HasSelectedCustomers)"
                       OnClick="SendInvite">
                <i class="fa-solid fa-link mr-2" aria-hidden="true"></i>
                Invite
            </MudButton>
        }
        @if (ShouldShowPrimaryActionButton)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@IsPrimaryActionDisabled"
                       OnClick="ExecutePrimaryAction">
                <i class="fa-solid fa-user-plus mr-2" aria-hidden="true"></i>
                @PrimaryActionLabel
            </MudButton>
        }
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Class="filters-trigger"
                   Disabled="@(Customers == null)"
                   Style="background-color: #fff;"
                   OnClick="OpenFiltersDialog">
            Filters
            <i class="fa-solid fa-filter ml-2" aria-hidden="true"></i>
        </MudButton>
        </div>
        <div class="customer-list__search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input class="customer-list__search-input"
                   type="search"
                   placeholder="Search by name, email or assigned to"
                   @bind-value="SearchTerm"
                   @bind-value:event="oninput"
                   aria-label="Search clients by name, email or assigned to" />
        </div>
    </div>
</div>

@if (Customers != null && HasActiveFilterChips)
{
    <div class="active-filters mb-3">
        <div class="active-filters__chips">
            @if (BrokerId > 0 && User?.IsAdmin == true)
            {
                <div class="active-filters__item">
                    <span class="active-filters__label">Broker:</span>
                    <div class="filter-chip">
                        <span>@GetBrokerName(BrokerId)</span>
                        <button type="button" class="filter-chip__close" @onclick="ClearBrokerFilter" aria-label="Remove broker filter">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>
            }
            @if (AssignedToId > 0)
            {
                <div class="active-filters__item">
                    <span class="active-filters__label">Assignee:</span>
                    <div class="filter-chip">
                        <span>@GetEmployeeName(AssignedToId)</span>
                        <button type="button" class="filter-chip__close" @onclick="ClearAssigneeFilter" aria-label="Remove assignee filter">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>
            }
            @if (showNonAppUsersOnly)
            {
                <div class="active-filters__item">
                    <span class="active-filters__label">Usage:</span>
                    <div class="filter-chip">
                        <span>Not in app</span>
                        <button type="button" class="filter-chip__close" @onclick="ClearUsageFilter" aria-label="Remove usage filter">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                <div class="active-filters__item">
                    <span class="active-filters__label">Search:</span>
                    <div class="filter-chip">
                        <span>@SearchTerm</span>
                        <button type="button" class="filter-chip__close" @onclick="ClearSearchFilter" aria-label="Remove search filter">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>
            }
            @if (FilterRecent > 0)
            {
                <div class="active-filters__item">
                    <span class="active-filters__label">Upcoming:</span>
                    <div class="filter-chip">
                        <span>@GetUpcomingFilterLabel()</span>
                        <button type="button" class="filter-chip__close" @onclick="ClearUpcomingFilter" aria-label="Remove upcoming filter">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>
            }
            @if (CustomerCategory > 0)
            {
                <div class="active-filters__item">
                    <span class="active-filters__label">Category:</span>
                    <div class="filter-chip">
                        <span>@GetCustomerCategoryLabel()</span>
                        <button type="button" class="filter-chip__close" @onclick="ClearCategoryFilter" aria-label="Remove category filter">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>
            }
            @if (AgeRange > 0)
            {
                <div class="active-filters__item">
                    <span class="active-filters__label">Age:</span>
                    <div class="filter-chip">
                        <span>@GetAgeRangeLabel()</span>
                        <button type="button" class="filter-chip__close" @onclick="ClearAgeRangeFilter" aria-label="Remove age filter">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>
            }
            @if (FilterPeriod > 0)
            {
                <div class="active-filters__item">
                    <span class="active-filters__label">Period:</span>
                    <div class="filter-chip">
                        <span>@GetPeriodLabel()</span>
                        <button type="button" class="filter-chip__close" @onclick="ClearPeriodFilter" aria-label="Remove period filter">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>
            }
            @if (ProfilingOption.HasValue)
            {
                <div class="active-filters__item">
                    <span class="active-filters__label">Profiling:</span>
                    <div class="filter-chip">
                        <span>@GetProfilingLabel()</span>
                        <button type="button" class="filter-chip__close" @onclick="ClearProfilingFilter" aria-label="Remove profiling filter">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>
            }
            @if (VerifiedFilter.HasValue)
            {
                <div class="active-filters__item">
                    <span class="active-filters__label">Verification:</span>
                    <div class="filter-chip">
                        <span>@(VerifiedFilter.Value ? "Verified" : "Not Verified")</span>
                        <button type="button" class="filter-chip__close" @onclick="async () => await ClearVerifiedFilter()" aria-label="Remove verification filter">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
        <button type="button" class="active-filters__clear" @onclick="ClearAllFilters">Clear all filters</button>
    </div>
}

@if (Customers != null)
{
    @{ 
        var filteredCustomers = FilteredCustomers;
        var hasFilteredCustomers = filteredCustomers?.Any() == true;
    }
    @if (FiltersDialogVisible)
    {
        <div class="filters-overlay" @onclick="CloseFiltersDialog">
            <div class="filters-panel" @onclick:stopPropagation="true">
            <div class="filters-header">
                <h4>Filter Clients</h4>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Variant="Variant.Text"
                               Color="Color.Dark"
                               OnClick="CloseFiltersDialog" />
            </div>
            <div class="filters-body">
                @if (User is not null && User.IsAdmin)
                {
                    <div class="row gy-3">
                        <div class="col-12">
                            <label class="filter-label">Filter By Broker</label>
                            @if (BrokerId > 0)
                            {
                                <div class="filter-chip filter-chip--inline">
                                    <span>Broker: @GetBrokerName(BrokerId)</span>
                                    <button type="button" class="filter-chip__close" @onclick="ClearBrokerFilter" aria-label="Remove broker filter">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <MudSelect T="int"
                                           Placeholder="Select"
                                           Clearable="true"
                                           @bind-Value="BrokerId"
                                           SelectedValuesChanged="@AutoCompleteClickBroker"
                                           AdornmentColor="Color.Primary">
                                    <MudSelectItem Value="0">Select</MudSelectItem>
                                    @foreach (var item in @Brokers)
                                    {
                                        <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                        </div>
                    </div>
                }

                @if (!User.IsAdmin && HasFilter)
                {
                    <div class="row gy-3">
                        <div class="col-lg-8">
                            <label class="filter-label">Filter By Assignee</label>
                            @if (AssignedToId > 0)
                            {
                                <div class="filter-chip filter-chip--inline">
                                    <span>Assignee: @GetEmployeeName(AssignedToId)</span>
                                    <button type="button" class="filter-chip__close" @onclick="ClearAssigneeFilter" aria-label="Remove assignee filter">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <MudSelect T="int"
                                           Placeholder="Select employee"
                                           Clearable="true"
                                           @bind-Value="AssignedToId"
                                           SelectedValuesChanged="@RefreshListFromFilterValues"
                                           AdornmentColor="Color.Primary">
                                    <MudSelectItem Value="0">Select</MudSelectItem>
                                    @foreach (var employee in @Employees)
                                    {
                                        <MudSelectItem Value="@employee.Id">@employee.FullName</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                        </div>
                        <div class="col-lg-4">
                            <label class="filter-label">Filter By Usage</label>
                            @if (showNonAppUsersOnly)
                            {
                                <div class="filter-chip filter-chip--inline">
                                    <span>Usage: Not in app</span>
                                    <button type="button" class="filter-chip__close" @onclick="ClearUsageFilter" aria-label="Remove usage filter">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <MudSelect T="int"
                                           Placeholder="Select"
                                           Clearable="true"
                                           @bind-Value="showNonAppUsersOnlyAsInt"
                                           SelectedValuesChanged="@ShowNonAppUsersOnly"
                                           AdornmentColor="Color.Primary">
                                    <MudSelectItem Value="0">All</MudSelectItem>
                                    <MudSelectItem Value="1">Not downloaded or logged in to app</MudSelectItem>
                                </MudSelect>
                            }
                        </div>
                    </div>
                }

                <div class="row gy-3">
                    <div class="col-lg-4">
                        <label class="filter-label">Filter the list below by name</label>
                        <input @bind-value="SearchTerm" @bind-value:event="oninput" placeholder="Type name or business name" class="filter_customerBroker" />
                    </div>
                    <div class="col-lg-4 control_wrapper">
                        <MudAutocomplete T="string"
                                         Label="Go direct to client"
                                         Placeholder="Start typing name, email or telephone ..."
                                         AdornmentColor="Color.Primary"
                                         TextChanged="@AutoCompleteClick"
                                         SearchFunc="@OnFilter">
                        </MudAutocomplete>
                    </div>
                    <div class="col-lg-4">
                        <label class="filter-label">Filter By Upcoming</label>
                        @if (User.IsAdmin || HasFilter)
                        {
                            if (FilterRecent > 0)
                            {
                                <div class="filter-chip filter-chip--inline">
                                    <span>Upcoming: @GetUpcomingFilterLabel()</span>
                                    <button type="button" class="filter-chip__close" @onclick="ClearUpcomingFilter" aria-label="Remove upcoming filter">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <MudSelect T="int"
                                           Placeholder="Select"
                                           Clearable="true"
                                           @bind-Value="FilterRecent"
                                           SelectedValuesChanged="@RefreshListFromFilterValues"
                                           AdornmentColor="Color.Primary">
                                    <MudSelectItem Value="0">None</MudSelectItem>
                                    <MudSelectItem Value="1">Upcoming Insurance Renewal</MudSelectItem>
                                    <MudSelectItem Value="2">Upcoming Mortgage Renewal</MudSelectItem>
                                </MudSelect>
                            }
                        }
                    </div>
                </div>

                @if (User.IsAdmin || HasFilter)
                {
                    <div class="row gy-3">
                        <div class="col-lg-4">
                            <label class="filter-label">Mortgage Category</label>
                            @if (CustomerCategory > 0)
                            {
                                <div class="filter-chip filter-chip--inline">
                                    <span>@GetCustomerCategoryLabel()</span>
                                    <button type="button" class="filter-chip__close" @onclick="ClearCategoryFilter" aria-label="Remove category filter">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <MudSelect T="int"
                                           Placeholder="Select"
                                           Clearable="true"
                                           @bind-Value="CustomerCategory"
                                           SelectedValuesChanged="@RefreshListFromFilterValues"
                                           AdornmentColor="Color.Primary"
                                           MaxHeight="400">
                                    @for (int i = 0; i < CustomerCategoriesByRelevance.Length; i++)
                                    {
                                        CustomerCategoryEnum looped = CustomerCategoriesByRelevance[i];
                                        int id = (int)looped;
                                        <MudSelectItem Value="@id">@looped.GetDisplayName()</MudSelectItem>
                                    }
                                </MudSelect>
                            }
                        </div>
                        <div class="col-lg-4">
                            <label class="filter-label">Age Range</label>
                            @if (AgeRange > 0)
                            {
                                <div class="filter-chip filter-chip--inline">
                                    <span>@GetAgeRangeLabel()</span>
                                    <button type="button" class="filter-chip__close" @onclick="ClearAgeRangeFilter" aria-label="Remove age filter">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <MudSelect T="int"
                                           Placeholder="Select"
                                           Clearable="true"
                                           @bind-Value="AgeRange"
                                           SelectedValuesChanged="@RefreshListFromFilterValues"
                                           AdornmentColor="Color.Primary">
                                    @{
                                        var names = Enum.GetNames(typeof(AgeRangeEnum));
                                        for (int i = 0; i <= names.Length; i++)
                                        {
                                            AgeRangeEnum looped = (AgeRangeEnum)i;
                                            <MudSelectItem Value="@i">@looped.GetDisplayName()</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            }
                        </div>
                        <div class="col-lg-4">
                            <label class="filter-label">Time Period</label>
                            @if (FilterPeriod > 0)
                            {
                                <div class="filter-chip filter-chip--inline">
                                    <span>Period: @GetPeriodLabel()</span>
                                    <button type="button" class="filter-chip__close" @onclick="ClearPeriodFilter" aria-label="Remove period filter">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <MudSelect T="int"
                                           Placeholder="Select"
                                           Clearable="true"
                                           @bind-Value="FilterPeriod"
                                           SelectedValuesChanged="@RefreshListFromFilterValues"
                                           AdornmentColor="Color.Primary">
                                    <MudSelectItem Value="0">2 weeks</MudSelectItem>
                                    <MudSelectItem Value="1">4 weeks</MudSelectItem>
                                    <MudSelectItem Value="2">3 months</MudSelectItem>
                                    <MudSelectItem Value="3">6 months</MudSelectItem>
                                    <MudSelectItem Value="4">9 months</MudSelectItem>
                                </MudSelect>
                            }
                        </div>
                    </div>

                    @if (this.api.Value.ShowProtection)
                    {
                        <div class="row mb-2">
                            <div class="col-12">
                                <label class="filter-label">Client Profiling *</label>
                                @if (ProfilingOption.HasValue)
                                {
                                    <div class="filter-chip filter-chip--inline">
                                        <span>Profiling: @GetProfilingLabel()</span>
                                        <button type="button" class="filter-chip__close" @onclick="ClearProfilingFilter" aria-label="Remove profiling filter">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <MudSelect T="int?"
                                               Placeholder="Select"
                                               Clearable="true"
                                               @bind-Value="ProfilingOption"
                                               SelectedValuesChanged="@RefreshListFromFilterValues"
                                               AdornmentColor="Color.Primary">
                                        @{
                                            var enumCount = Enum.GetNames(typeof(ProfilingOptionEnum)).Length;
                                            for (int? i = 1; i <= enumCount; i++)
                                            {
                                                ProfilingOptionEnum looped = (ProfilingOptionEnum)i;
                                                <MudSelectItem Value="@i">@looped.GetDisplayName()</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                }
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <MudText Typo="Typo.body2">* Profiling highlights customers who would benefit from additional insurance, for example, when client is self-employed, has a mortgage & life & critical illness and doesn't have income protection.</MudText>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="filters-dialog__footer w-100 text-center mt-3">
                Based on your applied filters, this message will be sent to <strong>@(FilteredCustomers?.Count ?? 0)</strong> clients.
            </div>
            <div class="filters-actions w-100 mt-3">
                <MudButton Variant="Variant.Text" OnClick="CloseFiltersDialog">Close</MudButton>
            </div>
            </div>
        </div>
    }
}
    <div>

        <div class="card">
            <div class="card-header">Clients</div>
            <div class="card-body">
                @if (hasFilteredCustomers)
                {
                    <MudTable Items="@filteredCustomers"
                              Hover="true"
                              SortLabel="Sort By"
                              MultiSelection="true"
                              Dense="true"
                              FixedHeader="@this.api.Value.FixedHeader"
                              FixedFooter="@this.api.Value.FixedFooter"
                              Height="@(this.api.Value.FixedHeader || this.api.Value.FixedFooter ? this.api.Value.ScrollHeight:"")"
                              @bind-SelectedItems="SelectedCustomers">
                    <HeaderContent>
                        @if (api.Value.ShowClientPictureColumn)
                        {
                            <MudTh></MudTh>
                        }
                        @if (!User.IsAdmin)
                        {
                            <MudTh Style="text-align:center">
                                @*<MudIconButton Class="@(AssignVisibilityClass())"
                                    Icon="@Icons.Material.Filled.GroupAdd"
                                    Size="Size.Small"
                                    Title="Assign"
                                    Variant="Variant.Filled"
                                    Color="Color.Primary"
                                    Style="@($"color:{Colors.Shades.Black}")" />*@
                            </MudTh>
                        }
                        <MudTh>
                            <div class="d-flex align-items-center gap-1">
                                <span>Client Name</span>
                                <MudMenu AnchorOrigin="Origin.BottomLeft"
                                         TransformOrigin="Origin.TopLeft"
                                     Icon="@Icons.Material.Filled.ArrowDropDown"
                                         Dense="true"
                                         CloseOnClick="true"
                                         Class="customer-sort-menu"
                                         PopoverClass="customer-sort-menu__popover">
                                    <MudMenuItem StartIcon="@Icons.Material.Filled.ArrowUpward"
                                                 Class="@GetSortMenuItemClass(CustomerNameSortOption.Ascending)"
                                                 OnClick="SortCustomersByNameAscending">
                                        Sort A to Z
                                    </MudMenuItem>
                                    <MudMenuItem StartIcon="@Icons.Material.Filled.ArrowDownward"
                                                 Class="@GetSortMenuItemClass(CustomerNameSortOption.Descending)"
                                                 OnClick="SortCustomersByNameDescending">
                                        Sort Z to A
                                    </MudMenuItem>
                                    <MudMenuItem StartIcon="@Icons.Material.Filled.Clear"
                                                 Class="@GetSortMenuItemClass(CustomerNameSortOption.Default)"
                                                 OnClick="ResetCustomerSort">
                                        Remove Sort
                                    </MudMenuItem>
                                </MudMenu>
                            </div>
                        </MudTh>
                        @if (api.Value.ShowClientPhoneColumn)
                        {
                            <MudTh><MudTableSortLabel Enabled="@false" SortBy="new Func<BrokerIQ.Online.Models.Customer, object>(x=>x.TelephoneNumber)">Telephone Number</MudTableSortLabel></MudTh>
                        }
                        <MudTh>
                            <div class="d-flex align-items-center gap-1">
                                <span>Date Of Birth</span>
                                <MudMenu AnchorOrigin="Origin.BottomLeft"
                                         TransformOrigin="Origin.TopLeft"
                                         Icon="@Icons.Material.Filled.ArrowDropDown"
                                         Dense="true"
                                         CloseOnClick="true"
                                         Class="customer-sort-menu"
                                         PopoverClass="customer-sort-menu__popover">
                                    <MudMenuItem StartIcon="@Icons.Material.Filled.ArrowUpward"
                                                 Class="@GetDateOfBirthSortMenuItemClass(CustomerDateOfBirthSortOption.OldestToNewest)"
                                                 OnClick="SortCustomersByDateOfBirthAscending">
                                        Oldest to Newest
                                    </MudMenuItem>
                                    <MudMenuItem StartIcon="@Icons.Material.Filled.ArrowDownward"
                                                 Class="@GetDateOfBirthSortMenuItemClass(CustomerDateOfBirthSortOption.NewestToOldest)"
                                                 OnClick="SortCustomersByDateOfBirthDescending">
                                        Newest to Oldest
                                    </MudMenuItem>
                                    <MudMenuItem StartIcon="@Icons.Material.Filled.Clear"
                                                 Class="@GetDateOfBirthSortMenuItemClass(CustomerDateOfBirthSortOption.Default)"
                                                 OnClick="ResetDateOfBirthSort">
                                        Remove Sort
                                    </MudMenuItem>
                                </MudMenu>
                            </div>
                        </MudTh>
                        <MudTh>
                            <div class="d-flex align-items-center gap-1">
                                <span>Category</span>
                                <MudMenu AnchorOrigin="Origin.BottomLeft"
                                         TransformOrigin="Origin.TopLeft"
                                         Icon="@Icons.Material.Filled.ArrowDropDown"
                                         Dense="true"
                                         CloseOnClick="true"
                                         Class="customer-sort-menu"
                                         PopoverClass="customer-sort-menu__popover">
                                    @if (CustomerCategoriesByRelevance != null)
                                    {
                                        foreach (var category in CustomerCategoriesByRelevance)
                                        {
                                            <MudMenuItem StartIcon="@(CustomerCategory == (int)category ? Icons.Material.Filled.Check : null)"
                                                         Class="@GetCategoryFilterMenuItemClass((int)category)"
                                                         OnClick="@(async ()=> await ApplyCategoryFilter((int)category))">
                                                @category.GetDisplayName()
                                            </MudMenuItem>
                                        }
                                    }
                                    <MudDivider />
                                    <MudMenuItem StartIcon="@Icons.Material.Filled.Clear"
                                                 Class="@GetCategoryFilterMenuItemClass(0)"
                                                 OnClick="@(async ()=> await ApplyCategoryFilter(0))">
                                        Remove Filter
                                    </MudMenuItem>
                                </MudMenu>
                            </div>
                        </MudTh>
                        @if (User.IsAdmin)
                        {
                            <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.Customer, object>(x=>x.AppVersion)">App</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.Customer, object>(x=>x.IsWhiteLabel)">WL</MudTableSortLabel></MudTh>
                        }
                        <MudTh>
                            <div class="d-flex align-items-center gap-1">
                                <span>Verified</span>
                                <MudMenu AnchorOrigin="Origin.BottomLeft"
                                         TransformOrigin="Origin.TopLeft"
                                         Icon="@Icons.Material.Filled.ArrowDropDown"
                                         Dense="true"
                                         CloseOnClick="true"
                                         Class="customer-sort-menu"
                                         PopoverClass="customer-sort-menu__popover">
                                    <MudMenuItem StartIcon="@(VerifiedFilter == true ? Icons.Material.Filled.Check : null)"
                                                 Class="@GetVerifiedFilterMenuItemClass(true)"
                                                 OnClick="@(async ()=> await ApplyVerifiedFilter(true))">
                                        Verified
                                    </MudMenuItem>
                                    <MudMenuItem StartIcon="@(VerifiedFilter == false ? Icons.Material.Filled.Check : null)"
                                                 Class="@GetVerifiedFilterMenuItemClass(false)"
                                                 OnClick="@(async ()=> await ApplyVerifiedFilter(false))">
                                        Not Verified
                                    </MudMenuItem>
                                    <MudDivider />
                                    <MudMenuItem StartIcon="@Icons.Material.Filled.Clear"
                                                 Class="@GetVerifiedFilterMenuItemClass(null)"
                                                 OnClick="@(async ()=> await ClearVerifiedFilter())">
                                        Remove Filter
                                    </MudMenuItem>
                                </MudMenu>
                            </div>
                        </MudTh>
                        <MudTh></MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @if (api.Value.ShowClientPictureColumn)
                        {
                            <MudTd Style="text-align:center">
                                @if (!string.IsNullOrWhiteSpace(context.PPAsImage))
                                {
                                    @if (context.HasNeeds)
                                    {
                                        <MudBadge Color="Color.Warning" Icon="@Icons.Material.Filled.Warning" Overlap="true" Bordered="true">
                                            <MudAvatar><img src="@context.PPAsImage" style="width:30px;" /></MudAvatar>
                                        </MudBadge>
                                    }
                                    else
                                    {
                                        <MudAvatar><img src="@context.PPAsImage" style="width:30px;" /></MudAvatar>
                                    }
                                }
                                else
                                {
                                    @if (context.HasNeeds)
                                    {
                                        <MudBadge Color="Color.Warning" Icon="@Icons.Material.Filled.Warning" Overlap="true" Bordered="true">
                                            <MudAvatar Color="Color.Secondary">@context.FirstName.ToUpper().First()@context.LastName.ToUpper().First()</MudAvatar>
                                        </MudBadge>
                                    }
                                    else
                                    {
                                        <MudAvatar Color="Color.Secondary">@context.FirstName.ToUpper().First()@context.LastName.ToUpper().First()</MudAvatar>
                                    }
                                }
                            </MudTd>
                        }
                        @if (!User.IsAdmin)
                        {
                            <MudTh>
                                <MudAvatarGroup Max="4" Spacing="2" MaxSize="Size.Small" MaxColor="Color.Secondary">
                                    @foreach (var staff in context.CustomerAssignments)
                                    {
                                        <MudAvatar Size="Size.Small" Style="@($"background:{@EmployeeColour[staff.Id]};")">@staff.FirstName.ToUpper().First()@staff.LastName.ToUpper().First()</MudAvatar>
                                    }
                                </MudAvatarGroup>
                            </MudTh>
                        }
                        <MudTd DataLabel="Client Name">
                            <div class="d-flex flex-column">
                                <span class="fw-bold">@context.Name</span>
                                <span class="small text-muted">@context.EmailAddress</span>
                            </div>
                        </MudTd>
                        @if (api.Value.ShowClientPhoneColumn)
                        {
                            <MudTd DataLabel="Telephone">@context.TelephoneNumber</MudTd>
                        }
                        <MudTd DataLabel="Date Of Birth">@context.DateOfBirth.ToBiqDateString()</MudTd>
                        <MudTd DataLabel="Category">
                            <MudMenu Dense="true">
                                <ActivatorContent>
                                    <MudButton style="text-transform: none;" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowDropDown">@GetCategoryDisplayName(context)</MudButton>
                                </ActivatorContent>
                                <ChildContent>
                                    @for (int i = 0; i < CustomerCategoriesByRelevance.Length; i++)
                                    {
                                        CustomerCategoryEnum looped = CustomerCategoriesByRelevance[i];
                                        int id = (int)looped;
                                        <MudMenuItem OnClick="@(e => OnCategoryClick(context.Id, (int)looped))">@looped.GetDisplayName()</MudMenuItem>
                                    }
                                </ChildContent>
                            </MudMenu>
                        </MudTd>
                        @if (User.IsAdmin)
                        {
                            <MudTd DataLabel="App">@context.AppVersion</MudTd>
                            <MudTd DataLabel="WL"><MudCheckBox @bind-Checked="@context.IsWhiteLabel" Disabled="true"></MudCheckBox></MudTd>
                        }
                        <MudTd Style="text-align:center" DataLabel="Verified"><MudCheckBox @bind-Checked="@context.EmailConfirmed" Disabled="true"></MudCheckBox></MudTd>
                        <MudTd>@if (context.HasConnection) { <MudIcon Icon="@Icons.Material.Filled.Link" />}</MudTd>
                        <MudTd DataLabel="">
                            <MudIconButton Icon="@Icons.Material.Filled.Info" Variant="Variant.Filled" Size="Size.Small"
                                           Color="Color.Primary" Style="@($"color:{Colors.Grey.Darken1};")" Link="@($"clientdetail/{@context.Id}")"></MudIconButton>
                            @* <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Link="@($"clientdetail/{@context.Id}")" >
                                <i class="fas fa-info-circle"></i>
                                </MudButton> *@
                        </MudTd>

                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
                    </PagerContent>
                    </MudTable>
                }
                else
                {
                    <div class="customer-empty-state">
                        <div class="customer-empty-state__circle">
                            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                            <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                        </div>
                        <p class="customer-empty-state__title">Can&rsquo;t find any result</p>
                        <p class="customer-empty-state__subtitle">Try adjusting your keywords or use the table filter to refine your search</p>
                        <button type="button" class="customer-empty-state__clear" @onclick="ClearAllFilters">Clear search</button>
                    </div>
                }
            </div>
        </div>
    </div>
}
