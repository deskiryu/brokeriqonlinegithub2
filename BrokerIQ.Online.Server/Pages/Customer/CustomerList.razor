@page "/clientlist"
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Extensions
@using BrokerIQ.Online.Services.Interface
@using Dto.Enum
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Options
@using BrokerIQ.Online.AppSettings

@inherits CustomerListBase

@inject NavigationManager NavigationManager
@inject IAccountService AccountService
@inject IOptions<ReviewItAPIDetails> api

<h3 class="page-title">Clients</h3>

@if (Customers == null)
{
    <div>
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    </div>
}
else
{
    <div class="card ">
        <div class="card-header">Notifications</div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-6 mt-1">
                    <MudInputString @bind-Value="selectedNotification" Placeholder="Type a notification message" Style="width:100%" />
                </div>
                <div class="col-sm-3 mt-1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" @onclick="(async () => await SendNotificationToSelected())">Send Notification to selected clients</MudButton>
                </div>
                <div class="col-sm-3 mt-1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" @onclick="(async () => await SendChatMessageToSelected())">Send chat message to selected clients</MudButton>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Filter Clients</div>
        <div class="card-body">

            <div class="row">
                @if (User is not null && User.IsAdmin)
                {
                    <div class="col-12">
                        <MudSelect T="int"
                                   Label="Filter By Broker"
                                   Placeholder="Select"
                                   Clearable="true"
                                   @bind-Value="BrokerId"
                                   SelectedValuesChanged="@RefreshListFromFilterValues"
                                   AdornmentColor="Color.Primary">
                            <MudSelectItem Value="0">Select</MudSelectItem>
                            @foreach (var item in @Brokers)
                            {
                                <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                }

                @if ((User is not null && !User.IsAdmin) && HasFilter)
                {
                    <div class="col-lg-8">
                        <MudSelect T="int"
                                   Label="Filter By Assignee"
                                   Placeholder="Select employee"
                                   Clearable="true"
                                   @bind-Value="AssignedToId"
                                   SelectedValuesChanged="@RefreshListFromFilterValues"
                                   AdornmentColor="Color.Primary">
                            <MudSelectItem Value="0">Select</MudSelectItem>
                            @foreach (var employee in @Employees)
                            {
                                <MudSelectItem Value="@employee.Id">@employee.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <div class="col-lg-4">
                        <MudSelect T="int"
                                   Label="Filter By Usage"
                                   Placeholder="Select"
                                   Clearable="true"
                                   @bind-Value="showNonAppUsersOnlyAsInt"
                                   SelectedValuesChanged="@ShowNonAppUsersOnly"
                                   AdornmentColor="Color.Primary">
                            <MudSelectItem Value="0">All</MudSelectItem>
                            <MudSelectItem Value="1">Not downloaded or logged in to app</MudSelectItem>
                        </MudSelect>
                    </div>
                }
            </div>

            <div class="row">
                <div class="col-lg-4">
                    @* <label>Filter the list below by name</label> *@
                    @* <input @bind-value="SearchTerm" @bind-value:event="oninput" placeholder="Type name or business name" class="filter_customerBroker" /> *@
                    <MudTextField @bind-Value="SearchTerm" Label="Company or Individual Name" Placeholder="Type name or business name"
                                  Immediate="true" OnKeyUp="RefreshListFromFilterValues" />
                </div>
                <div class="col-lg-4 control_wrapper">
                    <MudAutocomplete T="Online.Models.Customer"
                                     Label="Go direct to client"
                                     Placeholder="Start typing name, email or telephone ..."
                                     AdornmentColor="Color.Primary"
                                     SearchFunc="@SearchCustomer"
                                     ToStringFunc="@(c => c?.Name)"
                                     ValueChanged="@OnCustomerSelected" />
                    @*<MudAutocomplete T="string"
                                         Label="Go direct to client"
                                         Placeholder="Start typing name, email or telephone ..."
                                         AdornmentColor="Color.Primary"
                                         TextChanged="@AutoCompleteClick"
                                         SearchFunc="@OnFilter">
                        </MudAutocomplete>*@
                </div>

                @if ((User is not null && User.IsAdmin) || HasFilter)
                {
                    <div class="col-lg-4">
                        <MudSelect T="int"
                                   Label="Filter By Upcoming"
                                   Placeholder="Select"
                                   Clearable="true"
                                   @bind-Value="FilterRecent"
                                   SelectedValuesChanged="@RefreshListFromFilterValues"
                                   AdornmentColor="Color.Primary">
                            <MudSelectItem Value="0">None</MudSelectItem>
                            <MudSelectItem Value="1">Upcoming Insurance Renewal</MudSelectItem>
                            <MudSelectItem Value="2">Upcoming Mortgage Renewal</MudSelectItem>
                        </MudSelect>
                    </div>
                }
            </div>

            @if ((User is not null && User.IsAdmin) || HasFilter)
            {
                <div class="row">
                    <div class="col-lg-4">
                        <MudSelect T="int"
                                   Label="Mortgage Category"
                                   Placeholder="Select"
                                   Clearable="true"
                                   @bind-Value="CustomerCategory"
                                   SelectedValuesChanged="@RefreshListFromFilterValues"
                                   AdornmentColor="Color.Primary"
                                   MaxHeight="400">
                            @for (int i = 0; i < CustomerCategoriesByRelevance.Length; i++)
                            {
                                CustomerCategoryEnum looped = CustomerCategoriesByRelevance[i];
                                int id = (int)looped;
                                <MudSelectItem Value="@id">@looped.GetDisplayName()</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <div class="col-lg-4">
                        <MudSelect T="int"
                                   Label="Age Range"
                                   Placeholder="Select"
                                   Clearable="true"
                                   @bind-Value="AgeRange"
                                   SelectedValuesChanged="@RefreshListFromFilterValues"
                                   AdornmentColor="Color.Primary">
                            @if (true)
                            {
                                var names = Enum.GetNames(typeof(AgeRangeEnum));
                                @for (int i = 0; i <= names.Length; i++)
                                {
                                    AgeRangeEnum looped = (AgeRangeEnum)i;
                                    <MudSelectItem Value="@i">@looped.GetDisplayName()</MudSelectItem>
                                }
                            }
                        </MudSelect>
                    </div>
                    <div class="col-lg-4">
                        <MudSelect T="int"
                                   Label="Time Period"
                                   Placeholder="Select"
                                   Clearable="true"
                                   @bind-Value="FilterPeriod"
                                   SelectedValuesChanged="@RefreshListFromFilterValues"
                                   AdornmentColor="Color.Primary">
                            <MudSelectItem Value="0">2 weeks</MudSelectItem>
                            <MudSelectItem Value="1">4 weeks</MudSelectItem>
                            <MudSelectItem Value="2">3 months</MudSelectItem>
                            <MudSelectItem Value="3">6 months</MudSelectItem>
                            <MudSelectItem Value="4">9 months</MudSelectItem>
                        </MudSelect>
                    </div>
                </div>

                @if (this.api.Value.ShowProtection)
                {
                    <div class="row mb-2">
                        <div class="col-12">
                            <MudSelect T="int"
                                       Label="Client Profiling *"
                                       Clearable="true"
                                       @bind-Value="ProfilingOption"
                                       SelectedValuesChanged="@RefreshListFromFilterValues"
                                       AdornmentColor="Color.Primary">
                                <MudSelectItem Value="int.MaxValue">Select</MudSelectItem>
                                @{
                                    var names = Enum.GetNames(typeof(ProfilingOptionEnum));
                                    @for (int i = 0; i <= names.Length; i++)
                                    {
                                        ProfilingOptionEnum looped = (ProfilingOptionEnum)i;
                                        <MudSelectItem Value="@i">@looped.GetDisplayName()</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <MudText Typo="Typo.body2">* Profiling highlights customers who would benefit from additional insurance, for example, when client is self-employed, has a mortgage & life & critical illness and doesn't have income protection.</MudText>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <div>
        <div class="card">
            <div class="card-header">Clients</div>
            <div class="card-body">
                @if (User is not null)
                {
                    <MudTable T="Online.Models.Customer"
                              Hover="true"
                              SortLabel="Sort By"
                              MultiSelection="true"
                              Dense="true"
                              FixedHeader="@FixedHeader"
                              FixedFooter="@FixedFooter"
                              Height="@(FixedHeader || FixedFooter ? ScrollHeight:"")"
                              @bind-SelectedItems="SelectedCustomers"
                              ServerData="GetCustomersPage"
                              LoadingProgressColor="Color.Primary"
                              @ref="CustomerTable">
                        <HeaderContent>
                            @if (api.Value.ShowClientPictureColumn)
                            {
                                <MudTh></MudTh>
                            }
                            @if (!User.IsAdmin)
                            {
                                <MudTh Style="text-align:center"></MudTh>
                            }
                            <MudTh><MudTableSortLabel SortLabel="1" T="Online.Models.Customer">First Name</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="2" T="Online.Models.Customer">Last Name</MudTableSortLabel></MudTh>
                            @if (api.Value.ShowClientPhoneColumn)
                            {
                                <MudTh><MudTableSortLabel Enabled="@false" SortLabel="9" T="Online.Models.Customer">Telephone Number</MudTableSortLabel></MudTh>
                            }
                            <MudTh><MudTableSortLabel SortLabel="6" T="Online.Models.Customer">Email Address</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="3" T="Online.Models.Customer">Date Of Birth</MudTableSortLabel></MudTh>
                            <MudTh><MudTableSortLabel SortLabel="7" T="Online.Models.Customer">Category</MudTableSortLabel></MudTh>
                            @if (User is not null && User.IsAdmin)
                            {
                                <MudTh><MudTableSortLabel SortLabel="10" T="Online.Models.Customer">App</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortLabel="11" T="Online.Models.Customer">WL</MudTableSortLabel></MudTh>
                            }
                            <MudTh>Verified</MudTh>
                            <MudTh>
                                @if (CanImport || SelectedCustomers.Any())
                                {
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                             Size="Size.Small"
                                             AriaLabel="Bulk actions"
                                             Color="Color.Dark">
                                        @if (CanImport)
                                        {
                                            <MudMenuItem OnClick="ShowImportDialog">Import</MudMenuItem>
                                        }
                                        @if (SelectedCustomers.Any())
                                        {
                                            @if (User is not null && !User.IsAdmin && !User.IsBrokerStaff)
                                            {
                                                <MudMenuItem OnClick="AssignToStaff">Assign</MudMenuItem>
                                            }
                                            <MudMenuItem OnClick="SendInvite">Invite</MudMenuItem>
                                        }
                                    </MudMenu>
                                }
                            </MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @if (api.Value.ShowClientPictureColumn)
                            {
                                <MudTd Style="text-align:center">
                                    @if (!string.IsNullOrWhiteSpace(context.PPAsImage))
                                    {
                                        @if (context.HasNeeds)
                                        {
                                            <MudBadge Color="Color.Warning" Icon="@Icons.Material.Filled.Warning" Overlap="true" Bordered="true">
                                                <MudAvatar><img src="@context.PPAsImage" style="width:30px;" /></MudAvatar>
                                            </MudBadge>
                                        }
                                        else
                                        {
                                            <MudAvatar><img src="@context.PPAsImage" style="width:30px;" /></MudAvatar>
                                        }
                                    }
                                    else
                                    {
                                        @if (context.HasNeeds)
                                        {
                                            <MudBadge Color="Color.Warning" Icon="@Icons.Material.Filled.Warning" Overlap="true" Bordered="true">
                                                <MudAvatar Color="Color.Secondary">@context.FirstName.ToUpper().First()@context.LastName.ToUpper().First()</MudAvatar>
                                            </MudBadge>
                                        }
                                        else
                                        {
                                            <MudAvatar Color="Color.Secondary">@context.FirstName.ToUpper().First()@context.LastName.ToUpper().First()</MudAvatar>
                                        }
                                    }
                                </MudTd>
                            }
                            @if (!User.IsAdmin)
                            {
                                <MudTh>
                                    <MudAvatarGroup Max="4" Spacing="2" MaxSize="Size.Small" MaxColor="Color.Secondary">
                                        @foreach (var staff in context.CustomerAssignments)
                                        {
                                            <MudAvatar Size="Size.Small" Style="@($"background:{@EmployeeColour[staff.Id]};")">@staff.FirstName.ToUpper().First()@staff.LastName.ToUpper().First()</MudAvatar>
                                        }
                                    </MudAvatarGroup>
                                </MudTh>
                            }
                            <MudTd DataLabel="First name">@context.FirstName</MudTd>
                            <MudTd DataLabel="Last name">@context.LastName</MudTd>
                            @if (api.Value.ShowClientPhoneColumn)
                            {
                                <MudTd DataLabel="Telephone">@context.TelephoneNumber</MudTd>
                            }
                            <MudTd DataLabel="Email">@context.EmailAddress</MudTd>
                            <MudTd DataLabel="Date Of Birth">@context.DateOfBirth.ToBiqDateString()</MudTd>
                            <MudTd DataLabel="Category">
                                <MudMenu Dense="true">
                                    <ActivatorContent>
                                        <MudButton style="text-transform: none;" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowDropDown">@GetCategoryDisplayName(context)</MudButton>
                                    </ActivatorContent>
                                    <ChildContent>
                                        @for (int i = 0; i < CustomerCategoriesByRelevance.Length; i++)
                                        {
                                            CustomerCategoryEnum looped = CustomerCategoriesByRelevance[i];
                                            int id = (int)looped;
                                            <MudMenuItem OnClick="@(e => OnCategoryClick(context.Id, (int)looped))">@looped.GetDisplayName()</MudMenuItem>
                                        }
                                    </ChildContent>
                                </MudMenu>
                            </MudTd>
                            @if (User.IsAdmin)
                            {
                                <MudTd DataLabel="App">@context.AppVersion</MudTd>
                                <MudTd DataLabel="WL"><MudCheckBox @bind-Checked="@context.IsWhiteLabel" Disabled="true"></MudCheckBox></MudTd>
                            }
                            <MudTd Style="text-align:center" DataLabel="Verified"><MudCheckBox @bind-Checked="@context.EmailConfirmed" Disabled="true"></MudCheckBox></MudTd>
                            <MudTd DataLabel="">
                                <MudIconButton Icon="@Icons.Material.Filled.Info" Variant="Variant.Filled" Size="Size.Small"
                                               Color="Color.Primary" Style="@($"color:{Colors.Grey.Darken1};")" Link="@($"clientdetail/{@context.Id}")"></MudIconButton>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                }
            </div>
        </div>
    </div>
}
