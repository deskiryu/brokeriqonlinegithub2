

@page "/mortgagedetail/{MortgageId}"
@using BrokerIQ.Online.Models
@using BrokerIQ.Dto.Enum
@using System.IO
@using BrokerIQ.Online.Server.Extensions
@using System.ComponentModel.Design
@inherits MortgageDetailBase

@inject IJSRuntime js
@functions {
    async void DownloadFile(MortgageDocument sdoc)
    {
        await Extensions.SaveAs(js, sdoc.FileName, sdoc.File);
    }
}

@if (Mortgage == null)
{
    <div class="row ml-2 ">
        <div class="col-4 mt-2">
            <h3>Loading</h3>
        </div>
    </div>
    <div class="row ml-2">
        <div class="col-4">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
        </div>
    </div>
}
else
{
    <section class="mortgage-detail">
        <h4 class="page-title">Details for @Mortgage.ProviderName </h4>


        <div class="col-12 row">
            <div class="col-10 row">
                <div class="col-xs-12 col-sm-8">
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Name</label>
                        <div class="col-sm-8">
                            <label type="text" class="form-control-plaintext">@Mortgage.ProviderName</label>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Type</label>
                        <div class="col-sm-8">
                            <label type="text" readonly class="form-control-plaintext">@Mortgage.MortgageType.GetDisplayName()</label>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Rate</label>
                        <div class="col-sm-8">
                            <label type="text" readonly class="form-control-plaintext">@Mortgage.MortgageRateType.GetDisplayName()</label>
                        </div>
                    </div>


                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Mortgage End Date</label>
                        <div class="col-sm-8">
                            @if (@Mortgage.EndDate.HasValue)
                            {
                                <label type="text" readonly class="form-control-plaintext">@Mortgage.EndDate.Value.ToString("dd/MM/yyyy")</label>
                            }
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Monthly Payment</label>
                        <div class="col-sm-8">
                            <label type="text" readonly class="form-control-plaintext">@Mortgage.MonthlyPayment</label>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Interest Rate</label>
                        <div class="col-sm-8">
                            <label type="text" readonly class="form-control-plaintext">@Mortgage.InterestRate</label>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Promotional End Date</label>
                        <div class="col-sm-8">
                            @if (@Mortgage.PromotionalEndDate.HasValue)
                            {
                                <label type="text" readonly class="form-control-plaintext">@Mortgage.PromotionalEndDate.Value.ToString("dd/MM/yyyy")</label>
                            }
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Potential Monthly Payment</label>
                        <div class="col-sm-8">
                            <label type="text" readonly class="form-control-plaintext">@Mortgage.PotentialMonthlyPayment</label>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Potential Interest Rate</label>
                        <div class="col-sm-8">
                            <label type="text" readonly class="form-control-plaintext">@Mortgage.PotentialInterestRate</label>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Potential End Date</label>
                        <div class="col-sm-8">
                            @if (@Mortgage.PotentialEndDate.HasValue)
                            {
                                <label type="text" readonly class="form-control-plaintext">@Mortgage.PotentialEndDate.Value.ToString("dd/MM/yyyy")</label>
                            }
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Mortgage Number</label>
                        <div class="col-sm-8">
                            <label type="text" readonly class="form-control-plaintext">@Mortgage.MortgageNumber</label>
                        </div>
                    </div>


                    <h4>Supporting Documents</h4>

                    @foreach (var doc in Mortgage.SupportingDocuments)
                    {
                        <div class="form-group row">
                            <div class="col-sm-4">
                                <label type="text" readonly class="form-control-plaintext">@doc.FileName</label>
                            </div>
                            <div class="col-sm-4">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DownloadFile(doc))" class="btn btn-link">Download</MudButton>
                            </div>
                        </div>
                    }

                </div>

            </div>
        </div>



    </section>
}