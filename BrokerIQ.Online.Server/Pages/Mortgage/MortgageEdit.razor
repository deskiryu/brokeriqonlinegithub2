

@page "/mortgageedit/{MortgageId}/{CustomerId}"
@using Microsoft.Extensions.Options
@using BrokerIQ.Online.Models
@using BrokerIQ.Dto.Enum
@using BrokerIQ.Online.Server.Extensions
@using BlazorDateRangePicker
@using System.IO
@using BrokerIQ.Online.Pages

@using BrokerIQ.Online.AppSettings

@inherits MortgageEditBase
@inject IOptions<ReviewItAPIDetails> Options

@inject IJSRuntime js
@functions {
    async void DownloadFile(MortgageDocument sdoc)
    {
        await Extensions.SaveAs(js, sdoc.FileName, sdoc.File);
    }
    async void PreviewFile(MortgageDocument sdoc)
    {
        var memoryStream = new MemoryStream(sdoc.File);
        await Extensions.PreviewFile(js, memoryStream);
    }
}

@if (!Saved)
{
    <h4 class="page-title">Add or edit mortgage</h4>

    @if (Broker != null && Broker.Subscriptions != null && Broker.Subscriptions.Any(s => s.SubscriptionServiceId == (int)SubscriptionServiceEnum.AIReader) && Mortgage.Id == 0)
    {
        <MudPaper Class="pa-3 ma-2" Outlined="true">
            <MudButton Variant="Variant.Filled" FullWidth="true" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@OpenAnalyzerDialog">Fill Details From File ...</MudButton>
        </MudPaper>
    }

<EditForm Model="@Mortgage" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit" id="@FormId">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Name Of Mortgage Provider</label>

        <div class="col-sm-7">
            <InputText id="lastName" class="form-control col-sm-7" @bind-Value="@Mortgage.ProviderName" placeholder="Enter name for this mortgage"></InputText>
            <ValidationMessage For="@(() => Mortgage.ProviderName)" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Type of Mortgage</label>
        <div class="col-sm-8">
            <InputSelect id="mortgage" class="form-control" @bind-Value="@MortgageType">
                @{
                    var names = Enum.GetNames(typeof(MortgageEnum));
                    @for (int i = 1; i <= names.Length; i++)
                    {
                        MortgageEnum looped = (MortgageEnum)i;
                        <option value=@i>@looped.GetDisplayName()</option>
                    }
                }
            </InputSelect>
            <ValidationMessage For="@(() => MortgageType)" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Rate type</label>
        <div class="col-sm-8">
            <InputSelect id="mortgageRate" class="form-control" @bind-Value="@MortgageRateType">
                @if (true)
                {
                    var names = Enum.GetNames(typeof(MortgageRateEnum));
                    @for (int i = 1; i <= names.Length; i++)
                    {
                        MortgageRateEnum looped = (MortgageRateEnum)i;
                        <option value=@i>@looped.GetDisplayName()</option>
                    }
                }

            </InputSelect>
            <ValidationMessage For="@(() => MortgageRateType)" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Notes (visible to client)</label>

        <div class="col-sm-8">
            <InputTextArea id="brokerNotes" cols="40" rows="5" @bind-Value="@Mortgage.BrokerNotes" placeholder="Enter notes for this mortgage which will be visible to the client"></InputTextArea>
            <ValidationMessage For="@(() => Mortgage.BrokerNotes)" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label" style="font-size:large">Details</label>
        <div class="col-sm-6" />
        <div class="col-sm-2">
            <label class="col-form-label" style="font-size:large">Show</label>
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Mortgage Start Date</label>
        <div class="col-sm-6">
            <DateRangePicker @bind-StartDate="StartDate" SingleDatePicker="true" class="form-control col-sm-7" Culture="@(System.Globalization.CultureInfo.GetCultureInfo("en-GB"))"></DateRangePicker>
            <ValidationMessage For="@(() => Mortgage.StartDate)" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Term (in Years)</label>
        <div class="col-sm-6">
            <MudItem>
                <MudTextField Type="int?" @bind-Value="@Mortgage.TermInYears" HelperText="Enter mortgage term" />
                <ValidationMessage For="@(() => Mortgage.TermInYears)" />
            </MudItem>
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Mortgage Term Date</label>
        <div class="col-sm-6">
            <DateRangePicker @bind-StartDate="EndDate" SingleDatePicker="true" class="form-control col-sm-7" Culture="@(System.Globalization.CultureInfo.GetCultureInfo("en-GB"))"></DateRangePicker>
            <ValidationMessage For="@(() => Mortgage.EndDate)" />
        </div>
        <div class="col-sm-2">
            <MudCheckBox @bind-Checked="@Mortgage.ShowEndDate" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Monthly Payment</label>
        <div class="col-sm-6">
            <MudItem>
                <MudTextField @bind-Value="@Mortgage.MonthlyPayment" HelperText="Enter a payment" Format="F2" Adornment="Adornment.Start" AdornmentText="£" />
                <ValidationMessage For="@(() => Mortgage.MonthlyPayment)" />
            </MudItem>
        </div>
        <div class="col-sm-2">
            <MudCheckBox @bind-Checked="@Mortgage.ShowMonthlyPayment" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Interest Rate</label>
        <div class="col-sm-6">
            <MudItem>
                <MudTextField @bind-Value="@Mortgage.InterestRate" HelperText="Enter an interest rate" Format="F2" Adornment="Adornment.Start" AdornmentText="%" />
                <ValidationMessage For="@(() => Mortgage.InterestRate)" />
            </MudItem>
        </div>
        <div class="col-sm-2">
            <MudCheckBox @bind-Checked="@Mortgage.ShowInterestRate" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Fixed Rate End Date</label>
        <div class="col-sm-6">
            <DateRangePicker @bind-StartDate="PromotionalEndDate" SingleDatePicker="true" class="form-control col-sm-7" Culture="@(System.Globalization.CultureInfo.GetCultureInfo("en-GB"))"></DateRangePicker>
            <ValidationMessage For="@(() => Mortgage.PromotionalEndDate)" />
        </div>
        <div class="col-sm-2">
            <MudCheckBox @bind-Checked="@Mortgage.ShowPromotionalEndDate" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Loan Amount</label>
        <div class="col-sm-6">
            <MudItem>
                <MudTextField @bind-Value="@Mortgage.LoanAmount" HelperText="Enter the loan amount" Format="F2" Adornment="Adornment.Start" AdornmentText="£" />
                <ValidationMessage For="@(() => Mortgage.LoanAmount)" />
            </MudItem>
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Potential Monthly Payment</label>
        <div class="col-sm-6">
            <MudItem>
                <MudTextField @bind-Value="@Mortgage.PotentialMonthlyPayment" HelperText="Enter a payment" Format="F2" Adornment="Adornment.Start" AdornmentText="£" />
                <ValidationMessage For="@(() => Mortgage.PotentialMonthlyPayment)" />
            </MudItem>
        </div>
        <div class="col-sm-2">
            <MudCheckBox @bind-Checked="@Mortgage.ShowPotentialMonthlyPayment" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Potential Interest Rate</label>
        <div class="col-sm-6">
            <MudItem>
                <MudTextField @bind-Value="@Mortgage.PotentialInterestRate" HelperText="Enter an interest rate" Format="F2" Adornment="Adornment.Start" AdornmentText="%" />
                <ValidationMessage For="@(() => Mortgage.PotentialInterestRate)" />
            </MudItem>
        </div>
        <div class="col-sm-2">
            <MudCheckBox @bind-Checked="@Mortgage.ShowPotentialInterestRate" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-sm-4 col-form-label">Mortgage Number</label>
        <div class="col-sm-6">
            <MudItem>
                <MudTextField @bind-Value="@Mortgage.MortgageNumber" HelperText="Enter a mortgage number" />
                <ValidationMessage For="@(() => Mortgage.MortgageNumber)" />
            </MudItem>
        </div>
        <div class="col-sm-2">
            <MudCheckBox @bind-Checked="@Mortgage.ShowMortgageNumber" />
        </div>
    </div>

    @if (IsAdmin)
    {
        <div class="form-group row">
            <label class="col-sm-4 col-form-label">Choose Broker</label>
            <div class="col-sm-6">

                <InputSelect id="broker" class="form-control col-sm-7" @bind-Value="@BrokerListId">

                    @foreach (var broker in @Brokers)
                    {
                        <option value=@broker.Id>@broker.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => BrokerListId)" />

            </div>
        </div>
    }

</EditForm>

    <h4 class="col-4 mt-5">Supporting Documents</h4>

    @if (Mortgage.SupportingDocuments != null)
    {
        <div class="card">
            <div class="card-body">
                <MudTable Items="@Mortgage.SupportingDocuments" Hover="true" SortLabel="Sort By" Class="">
                    <RowTemplate>
                        <MudTd>@context.FileName</MudTd>
                        @if (Mortgage.Id > 0)
                        {
                            <MudTd> <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => PreviewFile(context))" class="btn btn-link">View</MudButton></MudTd>
                            <MudTd> <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DownloadFile(context))" class="btn btn-link">Download</MudButton></MudTd>
                            <MudTd> <MudButton Variant="Variant.Filled" Color="Color.Error" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DeleteMortgageFile(context.Id))" class="btn btn-link">Delete</MudButton></MudTd>
                        }
                        else
                        {
                            <MudTd> <MudButton Variant="Variant.Filled" Color="Color.Error" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DeleteMortgageFile(context))" class="btn btn-link">Delete</MudButton></MudTd>
                        }
                    </RowTemplate>
                </MudTable>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <label class="card-title">Upload pdf files</label>
            <div class="@HoverClass mt-1" @ondragenter="OnDragEnter" @ondragover="OnDragEnter" @ondragleave="OnDragLeave" @ondrop="OnDragLeave">
                <MudPaper class="drag-drop-zone">
                    <InputFile OnChange="LoadFiles" multiple Class="drag-drop-input" accept="application/pdf" />
                    <MudText>Click or Drag and drop pdf files here to attach</MudText>
                </MudPaper>
            </div>
        </div>
    </div>

    <label type="text" class="form-control-plaintext col-sm-4">@LoadFileStatus</label>
    <div class="col-sm">
        <div class="spin-row spin-row-bg">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" style="@SpinnerVisible" />
        </div>
    </div>

    @if (Mortgage == null || Mortgage.Id == 0)
    {
        <div class="row">
            <div class="col-sm-6"><MudCheckBox Class="col-sm-6" @bind-Checked="@SendNotification" Label="Send Notification" LabelPosition="LabelPosition.End" /></div>
            <div class="col-sm-6"><MudCheckBox Class="col-sm-6" @bind-Checked="@SendVideoNotification" Label="Send Video Notification" LabelPosition="LabelPosition.End" /></div>
        </div>
    }

    <div class="p-2">
        @if (Mortgage?.Id > 0)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" Style="@($"color:{Colors.Shades.Black};")" OnClick="@DeleteMortgage" Class="mr-8">Delete</MudButton>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" Class="mr-1">Cancel</MudButton>

        @if (Mortgage?.Id > 0)
        {
            <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" form="@FormId" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")">Save mortgage</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" form="@FormId" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")">Add mortgage</MudButton>
        }
    </div>


}
else
{
    <div class="alert @StatusClass">@Message</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Back to client overview</MudButton>
}
