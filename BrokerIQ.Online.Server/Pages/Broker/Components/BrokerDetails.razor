
@using BrokerIQ.Dto.Enum

<EditForm Model="@CurrentBroker" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit" >
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="col-12 row">

        <div class="col-xs-12 col-sm-12 com-md-12 col-lg-12">
            <div class="form-group row">
                <label class="col-sm-4 col-form-label">First Name</label>

                <div class="col-sm-8">
                    <InputText class="form-control col-sm-8" @bind-Value="CurrentBroker.BrokerFirstName" placeholder="Enter first name"></InputText>
                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => CurrentBroker.BrokerFirstName)" />
                </div>
            </div>
            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Last Name</label>

                <div class="col-sm-8">
                    <InputText class="form-control col-sm-8" @bind-Value="CurrentBroker.BrokerLastName" placeholder="Enter last name"></InputText>
                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => CurrentBroker.BrokerLastName)" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Telephone Number</label>
                <div class="col-sm-8">
                    <InputText class="form-control col-sm-8" @bind-Value="@CurrentBroker.TelephoneNumber" placeholder="Enter telephone"></InputText>
                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => CurrentBroker.TelephoneNumber)" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Email Address</label>
                <div class="col-sm-8">
                    <label type="text" readonly class="form-control-plaintext">@CurrentBroker.EmailAddress</label>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Two Factor Type</label>
                <MudRadioGroup class="col-sm-4" @bind-SelectedOption="@CurrentBroker.TwoFactorType">
                    <MudRadio Option="@TwoFactorEnum.Email">Email</MudRadio>
                    <MudRadio Option="@TwoFactorEnum.Sms">Mobile Phone</MudRadio>
                </MudRadioGroup>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Two Factor SMS Phone Number</label>
                <div class="col-sm-8">

                    <InputText @bind-Value="CurrentBroker.TwoFactorPhoneNumber" class="form-control col-sm-8" />
                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => CurrentBroker.TwoFactorPhoneNumber)" />

                </div>
                <label class="col-sm-4 col-form-label">Use broker telephone</label>
                <div class="col-sm-8">
                    <MudCheckBox @bind-Checked="@CurrentBroker.TwoFactorUseBrokerPhoneNumber" @onclick="async f => await SetUseBrokerPhoneNumber()" Style="margin-left: -15px" />
                </div>
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" class="btn btn-primary edit-btn mt-1">Save</MudButton>
        </div>
    </div>
</EditForm>
