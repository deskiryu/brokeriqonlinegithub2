
@using BrokerIQ.Dto.Enum

<EditForm Model="@CurrentStaff" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="col-12 row">

        <div class="col-xs-12 col-sm-12 com-md-12 col-lg-12">
            <div class="form-group row">
                <label class="col-sm-4 col-form-label">First Name</label>

                <div class="col-sm-8">
                    <InputText id="lastName" class="form-control col-sm-8" @bind-Value="CurrentStaff.FirstName" placeholder="Enter first name for this customer"></InputText>
                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => CurrentStaff.FirstName)" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Last Name</label>

                <div class="col-sm-8">
                    <InputText id="lastName" class="form-control col-sm-8" @bind-Value="CurrentStaff.LastName" placeholder="Enter last name for this customer"></InputText>
                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => CurrentStaff.LastName)" />
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Email Address</label>
                <div class="col-sm-8">
                    <label type="text" readonly class="form-control-plaintext">@CurrentStaff.EmailAddress</label>
                </div>
            </div>


            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Two Factor Type</label>
                <MudRadioGroup class="col-sm-4" @bind-SelectedOption="@CurrentStaff.TwoFactorType">
                    <MudRadio Option="@TwoFactorEnum.Email">Email</MudRadio>
                    <MudRadio Option="@TwoFactorEnum.Sms">Mobile Phone</MudRadio>
                </MudRadioGroup>
            </div>

            <div class="form-group row">
                <label class="col-sm-4 col-form-label">Two Factor SMS Phone Number</label>
                <div class="col-sm-8">
                    <InputText @bind-Value="CurrentStaff.TwoFactorPhoneNumber" class="form-control col-sm-8" />
                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => CurrentStaff.TwoFactorPhoneNumber)" />
                </div>
            </div>

            <div class="form-group row">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" ButtonType="ButtonType.Submit" class="btn btn-primary edit-btn">Save</MudButton>
            </div>

        </div>
    </div>
</EditForm>