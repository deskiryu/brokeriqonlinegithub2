@page "/brokerlist"
@using BrokerIQ.Online.Models
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Shared
@using BrokerIQ.Online.Services.Interface
@inherits BrokerListBase

@inject INotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IAlertService AlertService
@inject IDialogService DialogService
@inject IAccountService AccountService

<h3 class="page-title">Brokers</h3>

@if (Brokers == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="" />
}
else
{




    <div class="card ">
        <div class="card-header">Reminders</div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-6 mt-1">
                    <MudInputString @bind-Value="selectedNotification" Placeholder="Type a reminder message" Style="width:100%" />
                </div>
                <div class="col-sm-3 mt-1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" @onclick="(async () => await SendNotificationToAll())" class="btn btn-primary text-center">Send reminder to all brokers</MudButton>
                </div>
                <div class="col-sm-3 mt-1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" @onclick="(async () => await SendNotificationToSelected())" class="btn btn-secondary text-center">Send reminder to selected brokers</MudButton>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Filter Brokers</div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-4">
                    <label>Filter the list below by name</label>
                    <input @bind-value="SearchTerm" @bind-value:event="oninput" placeholder="Type name" class="filter_customerBroker" />
                </div>
                <div class="col-lg-8 control_wrapper">
                    <MudAutocomplete T="string"
                                     Label="Go direct to broker"
                                     Placeholder="Start typing name, email or telephone ..."
                                     AllowFiltering="true"
                                     AdornmentColor="Color.Primary"
                                     TextChanged="@AutoCompleteClick"
                                     SearchFunc="@OnFilter">
                    </MudAutocomplete>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Brokers</div>
        <div class="card-body">
            <MudTable Items="@FilteredBrokers" Hover="true" SortLabel="Sort By" MultiSelection="true" @bind-SelectedItems="SelectedBrokers">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.Broker, object>(x=>x.Name)">Name</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel Enabled="@false" SortBy="new Func<BrokerIQ.Online.Models.Broker, object>(x=>x.TelephoneNumber)">Telephone Number</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.Broker, object>(x=>x.EmailAddress)">Email Address</MudTableSortLabel></MudTh>
                    <MudTh>Two Factor</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Telephone">@context.TelephoneNumber</MudTd>
                    <MudTd DataLabel="Email">@context.EmailAddress</MudTd>
                    <MudTd DataLabel="Verified"><MudCheckBox @bind-Checked="@context.TwoFactorEnabled" Disabled="true"></MudCheckBox></MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Link="@($"brokeredit/{context.Id}")" class="btn btn-primary table-btn">
                            <i class="fas fa-edit"></i>
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Link="@($"charts/dashboard/{context.Id}")" class="btn btn-primary table-btn">
                            <i class="fas fa-chart-line"></i>
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager  PageSizeOptions="new int[]{10, 25, 50, 100}" />
                </PagerContent>
            </MudTable>
        </div>
    </div>

    @code {

        protected override async Task OnInitializedAsync()
        {
            try
            {
                var user = await AccountService.GetUser();
                if (user.IsAdmin || user.IsMinorAdmin)
                {
                    Brokers = (await BrokerService.GetBrokers()).ToList();
                }
            }
            catch
            {
                NavigationManager.NavigateTo($"account/logout");
            }


        }

        // Initialize SearchTerm to "" to prevent null's
        string SearchTerm { get; set; } = "";

        //filter
        List<BrokerIQ.Online.Models.Broker>
        FilteredBrokers => Brokers.Where(i => !string.IsNullOrEmpty(i.Name) &&  i.Name.ToLower().Contains(SearchTerm.ToLower())).ToList();



        private async Task<IEnumerable<string>> OnFilter(string value)
        {
            if (!string.IsNullOrEmpty(value) && Brokers != null && Brokers.Any())
            {
                // In real life use an asynchronous function for fetching data from an api.
                var filtered = Brokers.Where(
                i => !string.IsNullOrEmpty(i.Name) && i.Name.ToLower().Contains(value.ToLower()) ||
                     !string.IsNullOrEmpty(i.BrokerFirstName) && i.BrokerFirstName.ToLower().Contains(value.ToLower()) ||
                     !string.IsNullOrEmpty(i.BrokerLastName) && i.BrokerLastName.ToLower().Contains(value.ToLower()) ||
                     !string.IsNullOrEmpty(i.EmailAddress) && i.EmailAddress.ToLower().Contains(value.ToLower()) ||
                     !string.IsNullOrEmpty(i.TelephoneNumber) && i.TelephoneNumber.ToLower().Contains(value.ToLower()));

                var results = await Task.FromResult(filtered.Select(x => x.Name).Distinct().ToList());
                return results;
            }
            else
            {
                return new List<string>();
            }

        }

        public void AutoCompleteClick(string args)
        {
            var broker = Brokers.FirstOrDefault(x => x.Name == args);
            if (broker != null)
            {
                NavigationManager.NavigateTo($"brokeredit/{broker.Id}");
            }

        }
    }

    @code {
        private string allNotification;
        private string selectedNotification;

    public HashSet<Broker> SelectedBrokers { get; set; }

        async Task SendNotificationToAll()
        {
            await OpenNotificationDialog(true);
        }

        async Task SendNotificationToSelected(bool sendAll = false)
        {
            await OpenNotificationDialog(false);
        }

        async Task OpenNotificationDialog(bool sendAll = false)
        {
            var dialogParams = new DialogParameters();
            dialogParams.Add("Notification", selectedNotification);

            var targetsName = new List<string>();
            if (sendAll)
            {
                targetsName = Brokers.Select(x => x.Name).ToList();
            }
            else
            {
            targetsName = SelectedBrokers.Select(x => x.Name).ToList();
            }


            dialogParams.Add("Users", targetsName);
            dialogParams.Add("areBrokers", true);
            var result = await DialogService.Show<ScrollableDialog>("Send Notification", dialogParams).Result;

            if (!result.Cancelled)
            {
                var targets = new List<int>();
                if (sendAll)
                {
                    targets = Brokers.Select(x => x.Id).ToList();
                }
                else
                {
                targets = SelectedBrokers.Select(x => x.Id).ToList();
                }

                if (targets != null && targets.Any())
                {
                    var succeeded = false;
                    try
                    {
                        succeeded = await NotificationService.SendBrokerNotification(selectedNotification, targets);
                    }
                    catch
                    {

                    }


                    if (succeeded)
                    {
                        AlertService.Alert(new AlertBIQ
                        {
                            AutoClose = true,
                            Message = "Notification Sent"
                        });
                    }
                    else
                    {
                        AlertService.Error("Notification sending failed");
                    };
                }
                else
                {
                    AlertService.Error("No targets chosen");
                };
            }
        }
    }
}
