

@page "/brokeredit/{BrokerId}"
@using BrokerIQ.Online.Models
@using BrokerIQ.Dto.Enum
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Extensions
@using BlazorDateRangePicker
@using System.IO
@using BrokerIQ.Online.Services.Interface

@inherits BrokerEditBase


@if (!Saved)
{
    <section class="Broker-detail">

        <h4 class="page-title">Edit Broker</h4>

        


            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                <MudTabPanel Text="Main Details">
                    <EditForm Model="@Broker" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
            <div class="col-12 row">

                <div class="col-xs-12 col-sm-12 com-md-12 col-lg-12">
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Brokerage Name</label>

                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="Broker.Name" placeholder="Enter first name for this customer"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.Name)" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Broker First Name</label>

                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="Broker.BrokerFirstName" placeholder="Enter first name for this customer"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerFirstName)" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Broker Last Name</label>

                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="Broker.BrokerLastName" placeholder="Enter last name for this customer"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerLastName)" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Telephone Number</label>
                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.TelephoneNumber" placeholder="Enter telephone for this Broker"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.TelephoneNumber)" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Email Address</label>
                        <div class="col-sm-8">
                            <label type="text" readonly class="form-control-plaintext">@Broker.EmailAddress</label>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Address Line 1</label>
                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.AddressLine1" placeholder="Enter address for this Broker"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.AddressLine1)" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Address Line 2 </label>
                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.AddressLine2" placeholder="Enter address for this Broker"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.AddressLine2)" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">City </label>
                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.AddressLine3" placeholder="Enter address for this Broker"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.AddressLine3)" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Postcode</label>
                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.Postcode" placeholder="Enter postcode for this Broker"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.Postcode)" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Two Factor Type</label>
                        <MudRadioGroup class="col-sm-4" @bind-SelectedOption="@Broker.TwoFactorType">
                            <MudRadio Option="@TwoFactorEnum.Email">Email</MudRadio>
                            <MudRadio Option="@TwoFactorEnum.Sms">Mobile Phone</MudRadio>
                        </MudRadioGroup>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Two Factor SMS Phone Number</label>
                        <div class="col-sm-8">
                            
                            <InputText @bind-Value="Broker.TwoFactorPhoneNumber" class="form-control col-sm-8" />
                            <ValidationMessage class="offset-sm-3 col-sm-8"  For="@(() => Broker.TwoFactorPhoneNumber)" />

                        </div>
                        <label class="col-sm-4 col-form-label">Use broker telephone</label>
                        <div class="col-sm-8">
                            <MudCheckBox @bind-Checked="@Broker.TwoFactorUseBrokerPhoneNumber" @onclick="async f => await SetUseBrokerPhoneNumber()" Style="margin-left: -15px" />
                        </div>
                    </div>

                    @if (IsAdmin)
                    {
                        <div class="form-group row">
                            <label class="col-sm-4 col-form-label">Identifier</label>
                            <div class="col-sm-8">
                                <label>@Broker.Identifier</label>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-4 col-form-label">Two Factor Enabled</label>
                            <div class="col-sm-8">

                                <MudCheckBox @bind-Checked="@Broker.TwoFactorEnabled" @onclick="async f => await SetTwoFactorEnabled()" Style="margin-left: -15px" />

                            </div>
                        </div>
                    }

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Company Logo </label>
                        <div class="col-sm-8">
                            @if (Broker.LogoImage != null && Broker.LogoImage.Length > 0)
                            {
                                <img src="data:image/bmp;base64, @(Convert.ToBase64String(Broker.LogoImage))" />
                            }
                        </div>
                    </div>


                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Choose company logo </label>
                        <div class="col-sm-8">
                            <InputFile id="logofileinputbroker" OnChange="LoadFiles" accept="image/jpeg" hidden multiple/>
                            <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Style="@($"color:{Colors.Shades.Black};")"
                               StartIcon="@Icons.Filled.CloudUpload"
                               for="logofileinputbroker">
                                Choose File
                            </MudButton>
                            <label style="font-size:x-small">Ratio 2.2:1 Ideally 220px x 100px</label>
                        </div>
                    </div>
                    </div>

                    </div>
                    <div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" ButtonType="ButtonType.Submit" class="btn btn-primary edit-btn mt-1">Update Broker</MudButton>
                        @if (IsAdmin)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link ml-lg-2 mt-1">Cancel</MudButton>
                        }
                        @if (IsAdmin && (BrokerIdentifier==null || BrokerIdentifier.IdentifierFound==false))
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@AddIdentifier" class="btn btn-link ml-lg-2 mt-1">Add WhiteLabel Identifier</MudButton>
                        }
                        @if (IsAdmin && BrokerIdentifier != null && BrokerIdentifier.IdentifierFound)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@DeleteIdentifier" class="btn btn-link ml-lg-2 mt-1">Delete WhiteLabel Identifier</MudButton>
                        }
                    </div>
                </EditForm>

                </MudTabPanel>
                 @if (IsAdmin && BrokerIdentifier!=null && BrokerIdentifier.IdentifierFound)
                {
                 <MudTabPanel Text="White Label">
                     <EditForm Model="@BrokerIdentifier" OnValidSubmit="@HandleValidSubmitIdentifier" OnInvalidSubmit="@HandleInvalidSubmitIdentifier">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
            <div class="col-12 row">

                <div class="col-xs-12 col-sm-12 com-md-12 col-lg-12">

                            <div class="form-group row">
                                    <label class="col-sm-2 col-form-label">Bundle Identifier </label>
                                <div class="col-sm-10 ">
                                    <InputText  id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.BundleIdentifier" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.BundleIdentifier)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-sm-2 col-form-label">Background Colour </label>
                                <div class="col-sm-10 ">
                                        <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.BackgroundColour" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.BackgroundColour)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                    <label class="col-sm-2 col-form-label">Text Colour </label>
                                <div class="col-sm-10 ">
                                        <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.TextColour" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.TextColour)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                    <label class="col-sm-2 col-form-label">Http Link {Not shown}</label>
                                <div class="col-sm-10 ">
                                        <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.HttpLink" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.HttpLink)" />
                                </div>
                            </div>
                            <div class="form-group row">
                                    <label class="col-sm-2 col-form-label">Http Address (Shown to client)</label>
                                <div class="col-sm-10 ">
                                        <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.HttpAddress" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.HttpAddress)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                    <label class="col-sm-2 col-form-label">App Name </label>
                                <div class="col-sm-10 ">
                                        <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.AppName" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.AppName)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                    <label class="col-sm-2 col-form-label">Invert</label>
                            <div class="col-sm-10 ">

                                <MudCheckBox @bind-Checked="@BrokerIdentifier.Invert"  Style="margin-left: -15px" />

                            </div>
                            </div>
                            <div class="form-group row">
                                        <label class="col-sm-2 col-form-label">Link Colour </label>
                                <div class="col-sm-10 ">
                                            <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.LinkColour" placeholder="Enter address for this Broker"></InputText>
                                            <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.LinkColour)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                        <label class="col-sm-2 col-form-label">Play Store Link </label>
                                <div class="col-sm-10 ">
                                            <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.PlayStoreLink" placeholder="Enter address for this Broker"></InputText>
                                            <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.PlayStoreLink)" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-sm-2 col-form-label">App Store Link </label>
                                <div class="col-sm-10 ">
                                    <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.AppStoreLink" placeholder="Enter address for this Broker"></InputText>
                                    <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.AppStoreLink)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                        <label class="col-sm-2 col-form-label">From Email Name </label>
                                <div class="col-sm-10 ">
                                            <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.FromEmailName" placeholder="Enter address for this Broker"></InputText>
                                            <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.FromEmailName)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                        <label class="col-sm-2 col-form-label">From Email Address </label>
                                <div class="col-sm-10 ">
                                            <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.FromEmailAddress" placeholder="Enter address for this Broker"></InputText>
                                            <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.FromEmailAddress)" />
                                </div>
                            </div>
                                <div class="form-group row">
                                        <label class="col-sm-2 col-form-label">Welcome Video Url </label>
                                    <div class="col-sm-10 ">
                                        <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.WelcomeVideoUrl" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.WelcomeVideoUrl)" />
                                    </div> 
                                </div>

                                <div class="form-group row">
                                    <label class="col-sm-2 col-form-label">Email Tag Line </label>
                                    <div class="col-sm-10 ">
                                        <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.EmailTagLine" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.EmailTagLine)" />
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <label class="col-sm-2 col-form-label">Hub Client ConnectString </label>
                                    <div class="col-sm-10 ">
                                        <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.HubClientConnectString" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.HubClientConnectString)" />
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <label class="col-sm-2 col-form-label">Hub Client Name </label>
                                    <div class="col-sm-10 ">
                                        <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.HubClientName" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.HubClientName)" />
                                    </div>
                                </div>

                                <div class="form-group row">
                                    <label class="col-sm-2 col-form-label">Firebase Key </label>
                                    <div class="col-sm-10 ">
                                        <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.FirebaseKey" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.FirebaseKey)" />
                                    </div>
                                </div>
                                <div class="form-group row">
                                    <label class="col-sm-2 col-form-label">Firebase Client </label>
                                    <div class="col-sm-10 ">
                                        <InputText id="lastName" class="form-control" @bind-Value="@BrokerIdentifier.FirebaseClient" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3" For="@(() => BrokerIdentifier.FirebaseClient)" />
                                    </div>
                                </div>
                    </div>
                    </div>
                        <div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" ButtonType="ButtonType.Submit" class="btn btn-primary edit-btn mt-1">Update Broker Identifier</MudButton>
                            @if (IsAdmin)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link ml-lg-2 mt-1">Cancel Update Identifier</MudButton>
                            }


                        </div>
                    </EditForm>
                </MudTabPanel>                   
                }

            </MudTabs>

       
            @if (IsAdmin)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" class="btn btn-primary table-btn mt-1" @onclick="DeleteBroker">
                    Delete Broker
                </MudButton>
            }
            @if(IsAdmin || IsMinorAdmin)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" class="ml-lg-2 mt-1" @onclick="ResendEmailBroker">
                    Resend Verify Email
                </MudButton>            
            }

    </section>


}
else
{
    <div class="alert @StatusClass">@Message</div>
    <a class="btn btn-outline-primary" @onclick="@NavigateToOverview">Back to Broker(s)</a>
}