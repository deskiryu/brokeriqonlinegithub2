

@page "/brokeredit/{BrokerId}"
@using BrokerIQ.Online.Models
@using BrokerIQ.Dto.Enum
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Extensions
@using BlazorDateRangePicker
@using System.IO
@using BrokerIQ.Online.Services.Interface

@inherits BrokerEditBase


@if (!Saved)
{
    <section class="Broker-detail">

        <h4 class="page-title">Edit Broker</h4>

        <EditForm Model="@Broker" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">

            <DataAnnotationsValidator />
            <ValidationSummary />
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
                <MudTabPanel Text="Main Details">
            <div class="col-12 row">

                <div class="col-xs-12 col-sm-12 com-md-12 col-lg-12">
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Brokerage Name</label>

                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="Broker.Name" placeholder="Enter first name for this customer"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.Name)" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Broker First Name</label>

                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="Broker.BrokerFirstName" placeholder="Enter first name for this customer"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerFirstName)" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Broker Last Name</label>

                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="Broker.BrokerLastName" placeholder="Enter last name for this customer"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerLastName)" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Telephone Number</label>
                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.TelephoneNumber" placeholder="Enter telephone for this Broker"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.TelephoneNumber)" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Email Address</label>
                        <div class="col-sm-8">
                            <label type="text" readonly class="form-control-plaintext">@Broker.EmailAddress</label>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Address Line 1</label>
                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.AddressLine1" placeholder="Enter address for this Broker"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.AddressLine1)" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Address Line 2 </label>
                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.AddressLine2" placeholder="Enter address for this Broker"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.AddressLine2)" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">City </label>
                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.AddressLine3" placeholder="Enter address for this Broker"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.AddressLine3)" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Postcode</label>
                        <div class="col-sm-8">
                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.Postcode" placeholder="Enter postcode for this Broker"></InputText>
                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.Postcode)" />
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Two Factor Type</label>
                        <MudRadioGroup class="col-sm-4" @bind-SelectedOption="@Broker.TwoFactorType">
                            <MudRadio Option="@TwoFactorEnum.Email">Email</MudRadio>
                            <MudRadio Option="@TwoFactorEnum.Sms">Mobile Phone</MudRadio>
                        </MudRadioGroup>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Two Factor SMS Phone Number</label>
                        <div class="col-sm-8">
                            
                            <InputText @bind-Value="Broker.TwoFactorPhoneNumber" class="form-control col-sm-8" />
                            <ValidationMessage class="offset-sm-3 col-sm-8"  For="@(() => Broker.TwoFactorPhoneNumber)" />

                        </div>
                        <label class="col-sm-4 col-form-label">Use broker telephone</label>
                        <div class="col-sm-8">
                            <MudCheckBox @bind-Checked="@Broker.TwoFactorUseBrokerPhoneNumber" @onclick="async f => await SetUseBrokerPhoneNumber()" Style="margin-left: -15px" />
                        </div>
                    </div>

                    @if (NavigateAdmin)
                    {
                        <div class="form-group row">
                            <label class="col-sm-4 col-form-label">Identifier</label>
                            <div class="col-sm-8">
                                <label>@Broker.Identifier</label>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-4 col-form-label">Two Factor Enabled</label>
                            <div class="col-sm-8">

                                <MudCheckBox @bind-Checked="@Broker.TwoFactorEnabled" @onclick="async f => await SetTwoFactorEnabled()" Style="margin-left: -15px" />

                            </div>
                        </div>
                    }

                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Company Logo </label>
                        <div class="col-sm-8">
                            @if (Broker.LogoImage != null && Broker.LogoImage.Length > 0)
                            {
                                <img src="data:image/bmp;base64, @(Convert.ToBase64String(Broker.LogoImage))" />
                            }
                        </div>
                    </div>


                    <div class="form-group row">
                        <label class="col-sm-4 col-form-label">Choose company logo </label>
                        <div class="col-sm-8">
                            <InputFile id="logofileinputbroker" OnChange="LoadFiles" accept="image/jpeg" hidden multiple/>
                            <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Style="@($"color:{Colors.Shades.Black};")"
                               StartIcon="@Icons.Filled.CloudUpload"
                               for="logofileinputbroker">
                                Choose File
                            </MudButton>
                            <label style="font-size:x-small">Ratio 2.2:1 Ideally 220px x 100px</label>
                        </div>
                    </div>
                    </div>

                </div>
                </MudTabPanel>
                @if (NavigateAdmin && Broker.BrokerIdentifier!=null && Broker.BrokerIdentifier.IdentifierFound)
                {
                 <MudTabPanel Text="White Label">
            <div class="col-12 row">

                <div class="col-xs-12 col-sm-12 com-md-12 col-lg-12">

                            <div class="form-group row">
                                    <label class="col-sm-4 col-form-label">Bundle Identifier </label>
                                <div class="col-sm-8">
                                    <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.BrokerIdentifier.BundleIdentifier" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerIdentifier.BundleIdentifier)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label">Background Colour </label>
                                <div class="col-sm-8">
                                        <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.BrokerIdentifier.BackgroundColour" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerIdentifier.BackgroundColour)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                    <label class="col-sm-4 col-form-label">Text Colour </label>
                                <div class="col-sm-8">
                                        <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.BrokerIdentifier.TextColour" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerIdentifier.TextColour)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                    <label class="col-sm-4 col-form-label">Http Link </label>
                                <div class="col-sm-8">
                                        <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.BrokerIdentifier.HttpLink" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerIdentifier.HttpLink)" />
                                </div>
                            </div>
                            <div class="form-group row">
                                    <label class="col-sm-4 col-form-label">Http Address </label>
                                <div class="col-sm-8">
                                        <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.BrokerIdentifier.HttpAddress" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerIdentifier.HttpAddress)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                    <label class="col-sm-4 col-form-label">App Name </label>
                                <div class="col-sm-8">
                                        <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.BrokerIdentifier.AppName" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerIdentifier.AppName)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label">App Store Link </label>
                                <div class="col-sm-8">
                                    <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.BrokerIdentifier.AppStoreLink" placeholder="Enter address for this Broker"></InputText>
                                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerIdentifier.AppStoreLink)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                    <label class="col-sm-4 col-form-label">Invert</label>
                            <div class="col-sm-8">

                                <MudCheckBox @bind-Checked="@Broker.BrokerIdentifier.Invert"  Style="margin-left: -15px" />

                            </div>
                            </div>
                            <div class="form-group row">
                                        <label class="col-sm-4 col-form-label">Link Colour </label>
                                <div class="col-sm-8">
                                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.BrokerIdentifier.LinkColour" placeholder="Enter address for this Broker"></InputText>
                                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerIdentifier.LinkColour)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                        <label class="col-sm-4 col-form-label">Play Store Link </label>
                                <div class="col-sm-8">
                                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.BrokerIdentifier.PlayStoreLink" placeholder="Enter address for this Broker"></InputText>
                                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerIdentifier.PlayStoreLink)" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label">App Store Link </label>
                                <div class="col-sm-8">
                                    <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.BrokerIdentifier.AppStoreLink" placeholder="Enter address for this Broker"></InputText>
                                    <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerIdentifier.AppStoreLink)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                        <label class="col-sm-4 col-form-label">From Email Name </label>
                                <div class="col-sm-8">
                                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.BrokerIdentifier.FromEmailName" placeholder="Enter address for this Broker"></InputText>
                                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerIdentifier.FromEmailName)" />
                                </div>
                            </div>

                            <div class="form-group row">
                                        <label class="col-sm-4 col-form-label">From Email Address </label>
                                <div class="col-sm-8">
                                            <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.BrokerIdentifier.FromEmailAddress" placeholder="Enter address for this Broker"></InputText>
                                            <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerIdentifier.FromEmailAddress)" />
                                </div>
                            </div>
                                <div class="form-group row">
                                        <label class="col-sm-4 col-form-label">Welcome Video Url </label>
                                    <div class="col-sm-8">
                                        <InputText id="lastName" class="form-control col-sm-8" @bind-Value="@Broker.BrokerIdentifier.WelcomeVideoUrl" placeholder="Enter address for this Broker"></InputText>
                                        <ValidationMessage class="offset-sm-3 col-sm-8" For="@(() => Broker.BrokerIdentifier.WelcomeVideoUrl)" />
                                    </div> 
                                </div>


                    </div>
                    </div>
                </MudTabPanel>                   
                }

            </MudTabs>
            <div >
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" ButtonType="ButtonType.Submit" class="btn btn-primary edit-btn mt-1">Update Broker</MudButton>
                @if (NavigateAdmin)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link ml-lg-2 mt-1">Cancel</MudButton>
                }


            </div>
        </EditForm>
        @if (NavigateAdmin)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" class="btn btn-primary table-btn mt-1" @onclick="DeleteBroker">
                Delete Broker
            </MudButton>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" class="ml-lg-2 mt-1" @onclick="ResendEmailBroker">
                Resend Verify Email
            </MudButton>
        }

    </section>


}
else
{
    <div class="alert @StatusClass">@Message</div>
    <a class="btn btn-outline-primary" @onclick="@NavigateToOverview">Back to Broker(s)</a>
}