@page "/videodetail"
@using Dto.Enum
@using BrokerIQ.Online.Server.Extensions
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.AppSettings
@using Microsoft.Extensions.Options
@inherits VideoDetailBase

@inject IOptions<ReviewItAPIDetails> Options

@if (Customers == null)
{
    <div>
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    </div>
}
else
{
    <h3>@VideoNameNoExtension</h3>

    @if (Vetted)
    {
        <video id="movie" width="350" height="262" controls preload>
            <source src='@Url#t=0.1'>
            <!-- HERE THE CODE FOR THE ALTERNATIVE PLAYER (FLASH) WILL BE! -->
        </video>
    }
    else
    {

        <div></div>
        <div><h5>Video has not been vetted</h5></div>
        <div></div>
    }


    <div class="card ">
        <div class="card-header">Notifications</div>
        <div class="card-body">
            <div class="row">
                @if (Vetted)
                {
                    <div class="col-sm-6 mt-1">
                        <MudInputString @bind-Value="selectedNotification" Placeholder="Type a notification message" Style="width:100%" />
                    </div>
                    <div class="col-sm-3 mt-1">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" @onclick="(async () => await SendNotificationToSelected())" class="btn btn-secondary text-center">Send Video Notification to selected users</MudButton>
                    </div>
                    <div class="col-sm-3 mt-1">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" @onclick="(async () => await SendChatMessageToSelected())">Send video as chat message to selected clients</MudButton>
                    </div>
                }
                else
                {
                    <div></div>
                    <div><h5>Notification option will be available after video has been vetted</h5></div>
                    <div></div>
                }
            </div>
        </div>
    </div>
    <div class="card ">
        <div class="card-header">Filters</div>
        <div class="card-body">

            <div class="row">
                <div class="col-lg-4">
                    <label>Filter the list below by name</label>
                    <input @bind-value="SearchTerm" @bind-value:event="oninput" placeholder="Type name" class="filter_customerBroker" />
                </div>
                <div class="col-lg-4">
                    <MudSelect T="int"
                           Label="Mortgage Category"
                           Placeholder="Select"
                           Clearable="true"
                           @bind-Value="CustomerCategory"
                           SelectedValuesChanged="@RecentFilterSelect"
                           AdornmentColor="Color.Primary">
                        @if (true)
                        {
                            var names = Enum.GetNames(typeof(CustomerCategoryEnum));
                            @for (int i = 0; i <= names.Length; i++)
                            {
                                CustomerCategoryEnum looped = (CustomerCategoryEnum)i;
                                <MudSelectItem Value="@i">@looped.GetDisplayName()</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </div>
                <div class="col-lg-4">
                    <MudSelect T="int"
                           Label="Age Range"
                           Placeholder="Select"
                           Clearable="true"
                           @bind-Value="AgeRange"
                           SelectedValuesChanged="@RecentFilterSelect"
                           AdornmentColor="Color.Primary">
                        @if (true)
                        {
                            var names = Enum.GetNames(typeof(AgeRangeEnum));
                            @for (int i = 0; i <= names.Length; i++)
                            {
                                AgeRangeEnum looped = (AgeRangeEnum)i;
                                <MudSelectItem Value="@i">@looped.GetDisplayName()</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </div>
            </div>
            @if(Options.Value.ShowProtection){
            <div class="row">
                <div class="col-lg-4">
                    <MudSwitch T="bool" @bind-checked="@HasNeeds" Label="Client profiling *" Color="Color.Primary"/>
                </div>
                <div class="col-lg-4">
                    <MudSwitch T="bool" @bind-checked="@WithoutIncomeProtection" Label="Without Income Protection" Color="Color.Primary"/>
                </div>
                <div class="col-lg-4">
                    <MudSwitch T="bool" @bind-checked="@WithoutLifeInsurance" Label="Without Life Insurance" Color="Color.Primary" />
                </div>
                <div class="col-lg-4">
                    <MudSwitch T="bool" @bind-checked="@WithoutLifeCritical" Label="Without Life & Critical Ilness" Color="Color.Primary" />
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <MudText Typo="Typo.body2">* Profiling highlights customers who would benefit from additional insurance, for example, when client is self-employed, has a mortgage & life & critical illness and doesn't have income protection.</MudText>
                </div>
            </div>
            }
        </div>
    </div>

    @if (IsAdmin)
    {
        <div class="card ">
            <div class="card-header">Filters</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-8 control_wrapper">
                        <MudSelect T="int"
                           Label="Filter By Broker"
                           Placeholder="Select"
                           Clearable="true"
                           @bind-Value="BrokerId"
                           SelectedValuesChanged="@AutoCompleteClickBroker"
                           AdornmentColor="Color.Primary">
                            <MudSelectItem Value="0">Select</MudSelectItem>
                            @foreach (var item in @Brokers)
                            {
                                <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </div>
            </div>
        </div>
    }

    <MudTable Items="@FilteredCustomers" Hover="true" SortLabel="Sort By" MultiSelection="true" @bind-SelectedItems="SelectedCustomers">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.Customer, object>(x=>x.FirstName)">First Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.Customer, object>(x=>x.LastName)">Last Name</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.Customer, object>(x=>x.EmailAddress)">Email Address</MudTableSortLabel></MudTh>
            <MudTh>Verified</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="First name">@context.FirstName</MudTd>
            <MudTd DataLabel="Last name">@context.LastName</MudTd>
            <MudTd DataLabel="Email">@context.EmailAddress</MudTd>
            <MudTd DataLabel="Verified"><MudCheckBox @bind-Checked="@context.EmailConfirmed" Disabled="true"></MudCheckBox></MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
        </PagerContent>
    </MudTable>
}
