@page "/videodetail"
@using Dto.Enum
@using BrokerIQ.Online.Server.Extensions
@inherits VideoDetailBase

@if (Customers == null)
{
    <div>
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    </div>
}
else
{
    <h3>@VideoNameNoExtension</h3>

    @if (Vetted)
    {
        <video id="movie" width="350" height="262" controls preload>
            <source src='@Url#t=0.1'>
            <!-- HERE THE CODE FOR THE ALTERNATIVE PLAYER (FLASH) WILL BE! -->
        </video>
    }
    else
    {

        <div></div>
        <div><h5>Video has not been vetted</h5></div>
        <div></div>
    }


    <div class="card ">
        <div class="card-header">Notifications</div>
        <div class="card-body">
            <div class="row">
                @if (Vetted)
                {
                    <div class="col-sm-6 mt-1">
                        <MudInputString @bind-Value="selectedNotification" Placeholder="Type a notification message" Style="width:100%" />
                    </div>
                    <div class="col-sm-3 mt-1">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" @onclick="(async () => await SendNotificationToAll())" class="btn btn-primary text-center">Send Video Notification to all users</MudButton>
                    </div>
                    <div class="col-sm-3 mt-1">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" @onclick="(async () => await SendNotificationToSelected())" class="btn btn-secondary text-center">Send Video Notification to selected users</MudButton>
            </div>
                }
                else
                {
                    <div></div>
                    <div><h5>Notification option will be available after video has been vetted</h5></div>
                    <div></div>
                }
            </div>
        </div>
    </div>
            <div class="row">
                 <div class="col-lg-4">
                    <label>Filter the list below by name</label>
                    <input @bind-value="SearchTerm" @bind-value:event="oninput" placeholder="Type name" class="filter_customerBroker" />
                </div> 
                 <div class="col-lg-4">
                    <MudSelect T="int"
                                Label="Mortgage Category"
                                Placeholder="Select"
                                Clearable="true"
                                @bind-Value="CustomerCategory"
                                SelectedValuesChanged="@RecentFilterSelect"
                                AdornmentColor="Color.Primary">
                                    @if (true)
                                        {
                                            var names = Enum.GetNames(typeof(CustomerCategoryEnum));
                                            @for (int i = 0; i <= names.Length; i++)
                                                {
                                                    CustomerCategoryEnum looped = (CustomerCategoryEnum)i;
                                                    <MudSelectItem Value="@i">@looped.GetDisplayName()</MudSelectItem>
                                                }
                                        }
                    </MudSelect>
                    </div>
                    <div class="col-lg-4">
                        <MudSelect T="int"
                                    Label="Age Range"
                                    Placeholder="Select"
                                    Clearable="true"
                                    @bind-Value="AgeRange"
                                    SelectedValuesChanged="@RecentFilterSelect"
                                    AdornmentColor="Color.Primary">
                                        @if (true)
                                            {
                                                var names = Enum.GetNames(typeof(AgeRangeEnum));
                                                @for (int i = 0; i <= names.Length; i++)
                                                    {
                                                        AgeRangeEnum looped = (AgeRangeEnum)i;
                                                        <MudSelectItem Value="@i">@looped.GetDisplayName()</MudSelectItem>
                                                    }
                                            }
                        </MudSelect> 
                    </div>                    
            </div>    

    <div class="col-lg-8 control_wrapper">
        @if (IsAdmin)
        {
            <MudSelect T="int"
                        Label="Filter By Broker"
                        Placeholder="Select"
                        Clearable="true"
                        @bind-Value="BrokerId"
                        SelectedValuesChanged="@AutoCompleteClickBroker"
                        AdornmentColor="Color.Primary">
                <MudSelectItem Value="0">Select</MudSelectItem>
                @foreach (var item in @Brokers)
                {
                    <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                }
            </MudSelect>            
        }
    </div>
    <table id="table-video-customer" class="table col-sm-12 table-striped ">
        <thead>
            <tr>
                <th>Select</th>
                <th>Name</th>
                <th>Verified</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in FilteredCustomers)
            {
                <tr>
                    <td><MudCheckBox @bind-Checked="@customer.Selected" /></td>
                    <td>@customer.Name</td>
                    <td>
                        @if (customer.EmailConfirmed)
                        {
                            <i class="fa fa-check-circle font_awesome_table_checks success"></i>
                        }
                        else
                        {
                            <i class="fa fa-times-circle  font_awesome_table_checks fail"></i>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
