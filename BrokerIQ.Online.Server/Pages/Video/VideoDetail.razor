@page "/videodetail"
@inherits VideoDetailBase

@if (Customers == null)
{
    <div class="row ml-2 ">
        <div class="col-4 mt-2">
            <h3>Loading</h3>
        </div>
    </div>
    <div class="row ml-2">
        <div class="col-4">
            <MudProgressLinear Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Indeterminate="true" Class="my-7" />
        </div>
    </div>
}
else
{
    <h3>@VideoNameNoExtension</h3>

    @if (Vetted)
    {
        <video id="movie" width="350" height="262" controls preload>
            <source src='@Url#t=0.1'>
            <!-- HERE THE CODE FOR THE ALTERNATIVE PLAYER (FLASH) WILL BE! -->
        </video>
    }
    else
    {

        <div></div>
        <div><h5>Video has not been vetted</h5></div>
        <div></div>
    }


    <div class="card ">
        <div class="card-header">Notifications</div>
        <div class="card-body">
            <div class="row">
                @if (Vetted)
                {
                    <div class="col-sm-6 mt-1">
                        <MudInputString @bind-Value="selectedNotification" Placeholder="Type a notification message" Style="width:100%" />
                    </div>
                    <div class="col-sm-3 mt-1">
                        <button @onclick="(async () => await SendNotificationToAll())" class="btn btn-primary text-center">Send Video Notification to all users</button>
                    </div>
                    <div class="col-sm-3 mt-1">
                        <button @onclick="(async () => await SendNotificationToSelected())" class="btn btn-secondary text-center">Send Video Notification to selected users</button>
                    </div>
                }
                else
                {
                    <div></div>
                    <div><h5>Notification option will be available after video has been vetted</h5></div>
                    <div></div>
                }
            </div>
        </div>
    </div>
    <div>
        Filter customers: <input @bind-value="SearchTerm" @bind-value:event="oninput" class="mt-1 mb-1" />
    </div>

    <table id="table-video-customer" class="table col-sm-12 table-striped ">
        <thead>
            <tr>
                <th>Select</th>
                <th>Name</th>
                <th>Verified</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in FilteredCustomers)
            {
                <tr>
                    <td><MudCheckBox Checked="@customer.Selected" /></td>
                    <td>@customer.Name</td>
                    <td>
                        @if (customer.EmailConfirmed)
                        {
                            <i class="fa fa-check-circle font_awesome_table_checks success"></i>
                        }
                        else
                        {
                            <i class="fa fa-times-circle  font_awesome_table_checks fail"></i>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
