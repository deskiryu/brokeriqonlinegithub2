@page "/videolist"
@inherits VideoListBase
@using System.Globalization
@using System.IO
@using BrokerIQ.Online.Server.Shared


<h1 class="page-title">All Videos</h1>

@if (!Saved)
{
    @if (Videos == null)
    {
        <div class="row ml-2 ">
            <div class="col-4 mt-2">
                <h3>Loading</h3>
            </div>
        </div>
        <div class="row ml-2">
            <div class="col-4">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
            </div>
        </div>
    }
    else
    {
        <div class="mt-5">
            <h5>Upload Video</h5>
        </div>
        <InputFile OnChange="LoadFiles" class="mt-2 btn btn-primary" accept="video/mov,video/mp4,video/*" />
        <p>@status</p>
        <div class="col-sm">
            <div class="spin-row spin-row-bg">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" style="@SpinnerVisible" />
            </div>
        </div>

        <MudDialog @bind-IsVisible="RenameUploadVisibility">
            <TitleContent>
                Upload Video
            </TitleContent>
            <DialogContent>
                <MudTextField Label="Video Name" ID="inVal" @bind-Value="@VideoName" Type="InputType.Text" Placeholder="" HelperText="Enter video name" />
                <MudTextField Label= "Send Date" T="DateTime?" @bind-Value="@VideoSendDate" Format="yyyy-MM-dd" HelperText="(Optional) Enter a date of when this should be sent" InputType="InputType.Date"/>

            </DialogContent>
            <DialogActions>
                <MudButton Color="Color.Secondary" OnClick="OnCancelPushed">Cancel</MudButton>
                <MudButton Color="Color.Primary" OnClick="UploadButtonPushed">Ok</MudButton>
            </DialogActions>
        </MudDialog>

        // TODO: Make this a MudTable?
        <table id="table-video" class="table col-sm-12 table-striped ">
            <thead>
                <tr>
                    <th class="col-md-1">Watch</th>
                    <th class="col-md-2">Video Name</th>
                    <th class="col-md-1">Upload Date</th>
                    <th class="col-md-1">Next Send Date</th>
                    <th class="col-md-1">Birthday</th>
                    <th class="col-md-1">Send</th>
                    <th class="col-md-1">Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var Video in Videos)
                {
                    <tr>
                        <td>
                            <Card Width="100%">
                                <CardBody>
                                    @if (DisplayEmbeddedVideo[Video.Name])
                                    {
                                        <td>
                                            <video id="movie" width="150" height="150" controls preload>
                                                <source src='@Video.Url#t=0.1'>
                                            </video>
                                        </td>
                                    }
                                    else
                                    {
                                        // thumbnails are always {Video.Name}.jpeg
                                        string thumbnailKey = $"{Video.Name}.jpeg";
                                        if (VideoThumbnails.ContainsKey(thumbnailKey))
                                        {
                                            <div>
                                                <i class="bi bi-play-circle" style="cursor:pointer;" @onclick="@( () => ShowVideoPlayer(@Video.Name) )">
                                                    <span>Play</span>
                                                </i>
                                                <img class="img-thumbnail" src="@VideoThumbnails[thumbnailKey].Data" style="cursor:pointer; width:100%;"
                                                    @onclick="@( () => ShowVideoPlayer(@Video.Name) )" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <i class="bi bi-play-circle" style="cursor:pointer;" @onclick="@( () => ShowVideoPlayer(@Video.Name) )">
                                                    <span>Play</span>
                                                </i>
                                                <img class="img-thumbnail"  style="cursor:pointer; width:100%;"
                                                    @onclick="@( () => ShowVideoPlayer(@Video.Name) )" />
                                            </div>
                                        }
                                    }
                                </CardBody>
                            </Card>
                        </td>
                        <td>@Path.GetFileNameWithoutExtension(Video.Name)</td>
                        <td>@((Video.UploadDate == null) ? "-" : ((DateTimeOffset)Video.UploadDate).ToString("d", new CultureInfo("en-GB")))</td>
                        <td><MudDatePicker
                            Culture=@(new CultureInfo("en-GB")) PickerVariant="PickerVariant.Dialog" DisableToolbar="true"
                            Date="@Video.SendDate" DateChanged="(x) => UpdateVideoSendDate(x, Video.Name)"
                            style="font-size: 14px; margin-top: -10px; color: #222"
                        /></td>
                        <td><input type="checkbox" checked="@Video.BirthdayVideo" @onclick="f => SetBirthdayVideo(Video.Name)"/></td>
                        <td>
                            <NavLink href="@($"videodetail?url={Video.Url}")" class="btn btn-primary table-btn">
                                <i class="fas fa-eye"></i>
                            </NavLink>
                        </td>


                        <td>
                            <button class="btn btn-primary table-btn" @onclick="f => DeleteVideo(Video.Name)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else
{
    <div class="alert @StatusClass">@Message</div>
    <a class="btn btn-outline-primary" @onclick="@NavigateToOverview">Back to video list</a>
}

@code {
    async void UpdateVideoSendDate(DateTime? sendDate, String name){
        // Set the new value first, to avoid double firing from the DateChanged event.
        var existingVideo = this.Videos.First(item => item.Name == name);
        DateTime? oldDate = existingVideo.SendDate;
        existingVideo.SendDate = sendDate;

        var returned = await SetVideoSendDate(name, sendDate);
        if (!returned) {
            existingVideo.SendDate = oldDate;
        }

        StateHasChanged();
    }
}