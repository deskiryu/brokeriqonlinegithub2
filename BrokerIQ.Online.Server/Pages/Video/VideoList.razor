@page "/videolist"
@inherits VideoListBase
@using System.Globalization
@using System.IO


<h1 class="page-title">All Videos</h1>

@if (!Saved)
{
    @if (Videos == null)
    {
        <div class="row ml-2 ">
            <div class="col-4 mt-2">
                <h3>Loading</h3>
            </div>
        </div>
        <div class="row ml-2">
            <div class="col-4">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
            </div>
        </div>
    }
    else
    {
        <div class="mt-5">
            <h5>Upload Video</h5>
        </div>
        <InputFile id="videofileinput" OnChange="LoadFiles" accept="video/mov,video/mp4,video/*" hidden multiple/>
        <MudButton HtmlTag="label"
           Variant="Variant.Filled"
           Color="Color.Primary"
           Style="@($"color:{Colors.Shades.Black};")"
           StartIcon="@Icons.Filled.CloudUpload"
           for="videofileinput">
            Upload Video
        </MudButton>
        <p>@status</p>
        <div class="">
            @if (VideoScanUploading)
            {
                <div class="mt-5">
                    Uploading video to virus scanning service...
                </div>
            }
            else if (VideoScanning)
            {
                <div class="mt-5">
                    Scanning video for viruses (@VideoScanningProgress %)
                </div>
            }
            else if (VideoUploading)
            {
                <div class="mt-5">
                    Scan complete. Uploading video to BrokerIQ...
                </div>
            }
            <div class="spin-row spin-row-bg">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" style="@SpinnerVisible" />
            </div>
        </div>

        <MudDialog @bind-IsVisible="RenameUploadVisibility">
            <TitleContent>
                Upload Video
            </TitleContent>
            <DialogContent>
                <MudTextField Label="Video Name" ID="inVal" @bind-Value="@VideoName" Type="InputType.Text" Placeholder="" HelperText="Enter video name" />
                    @if(IsAdmin){
                    <MudSelect id="brokerVideo" class="form-control" @bind-Value="@BrokerListId">
                        <MudSelectItem Value=0>No Broker</MudSelectItem>
                        @foreach (var broker in @Brokers)
                                {
                            <MudSelectItem Value=@broker.Id>@broker.Name</MudSelectItem>
                                }
                    </MudSelect>
                    }
            </DialogContent>
            <DialogActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="OnCancelPushed">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="UploadButtonPushed">Ok</MudButton>
            </DialogActions>

        </MudDialog>


        <MudTable Items="@Videos" id="table-video" class="table col-sm-12 table-striped ">
            <HeaderContent>
                    <MudTh class="video_table_col_width_parent">Watch</MudTh>
                    <MudTh class="">
                        <MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Server.Models.Video, object>(x=>x.Name)">Video Name</MudTableSortLabel>
                    </MudTh>
                    <MudTh class="">
                        <MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Server.Models.Video, object>(x=>x.UploadDate)">Uploaded</MudTableSortLabel>
                    </MudTh>
                    <MudTh class="">
                        <MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Server.Models.Video, object>(x=>x.SendDate)">Send Date</MudTableSortLabel>
                    </MudTh>
                    @if (IsAdmin)
                    {
                        <MudTh class="">
                            <MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Server.Models.Video, object>(x=>x.Broker)">Broker</MudTableSortLabel>
                        </MudTh>      
                    }

                    <MudTh class="">Birthday</MudTh>
                    <MudTh class="">Send</MudTh>
                    <MudTh class="">Delete</MudTh>
            </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Watch">
                            <div class="card video_table_col_width">
                                <div class="card_body video_card-body">
                                        @if (DisplayEmbeddedVideo[context.Name])
                                        {
                                            <div class="video_play">
                                            <video id="movie" class="video_play_size" controls preload autoplay>
                                                <source src='@context.Url#t=0.1'>
                                            </video>
                                            </div>

                                        }
                                        else
                                        {
                                            // thumbnails are always {Video.Name}.jpeg
                                            string thumbnailKey = $"{context.Name}.jpeg";
                                            if (VideoThumbnails.ContainsKey(thumbnailKey))
                                            {
                                                <div class="video_thumb">
                                                    <img class="img-thumbnail" src="@VideoThumbnails[thumbnailKey].Data" style="width:150px;"/>
                                                    <div class="play-button" @onclick="@( () => ShowVideoPlayer(@context.Name) )"></div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div>
                                                    <i class="bi bi-play-circle" style="cursor:pointer;" @onclick="@( () => ShowVideoPlayer(@context.Name) )">
                                                        <span>Play</span>
                                                    </i>
                                                    <img class="img-thumbnail"  style="cursor:pointer; width:100%;"
                                                        @onclick="@( () => ShowVideoPlayer(@context.Name) )" />
                                                </div>
                                            }
                                        }
                                 </div>
                            </div>

                        </MudTd>
                        <MudTd DataLabel="Video Name">@Path.GetFileNameWithoutExtension(context.Name)</MudTd>
                        <MudTd DataLabel="Uploaded">@((context.UploadDate == null) ? "-" : ((DateTimeOffset)context.UploadDate).ToString("g", new CultureInfo("en-GB")))</MudTd>
                        <MudTd DataLabel="Video Send Date">   
                            <div class="row">
                                <MudDatePicker Class="video_send_date"
                                Culture=@(new CultureInfo("en-GB")) PickerVariant="PickerVariant.Dialog" DisableToolbar="true"
                                Date="@context.SendDate" DateChanged="async (x) => await UpdateVideoSendDate(x, context.Name)"
                                style="font-size: 14px; margin-top: -10px">
                                </MudDatePicker>
                                </div>
                            <div class="row mt-2">
                                <MudCheckBox @bind-Checked="@context.SendDateTick" @onclick="async f => await SetSendDateTick(context.Name)" />
                                <label class="video_checkbox_label">Send on this date</label>

                            </div>
                        </MudTd>
                        @if (IsAdmin)
                        {
                            <MudTd DataLabel="Broker">@context.Broker</MudTd>              
                        }
                        <MudTd DataLabel="Birthday"><MudCheckBox @bind-Checked="@context.BirthdayVideo" @onclick="async f => await SetBirthdayVideo(context.Name)" /></MudTd>
                        <MudTd DataLabel="Send">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Link="@($"videodetail?url={context.Url}")" >
                                <i class="fas fa-paper-plane"></i>
                            </MudButton>
                        </MudTd>
                        <MudTd DataLabel="Delete">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"class="btn btn-primary table-btn" @onclick="f => DeleteVideo(context.Name)">
                                <i class="fas fa-trash"></i>
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
        </MudTable>
    }
}
else
{
    <div class="alert @StatusClass">@Message</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Back to video list</MudButton>
}
