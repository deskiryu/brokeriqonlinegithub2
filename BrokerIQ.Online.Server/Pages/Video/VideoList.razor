@page "/videolist"
@inherits VideoListBase
@using System.Globalization
@using System.IO
@using BrokerIQ.Dto.Models
@using BrokerIQ.Online.Services.Interface
@using BrokerIQ.Online.Server.Shared


<h1 class="page-title">All Videos</h1>

@if (!Saved)
{
    @if (Videos == null)
    {
        <div class="row ml-2 ">
            <div class="col-4 mt-2">
                <h3>Loading</h3>
            </div>
        </div>
        <div class="row ml-2">
            <div class="col-4">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
            </div>
        </div>
    }
    else
    {
        <div class="mt-5">
            <h5>Upload Video</h5>
        </div>
        <InputFile OnChange="LoadFiles" class="mt-2 btn btn-primary" accept="video/mov,video/mp4,video/*" />
        <p>@status</p>
        <div class="col-sm">
            @if (VideoScanUploading)
            {
                <div class="mt-5">
                    Uploading video to virus scanning service...
                </div>
            }
            else if (VideoScanning)
            {
                <div class="mt-5">
                    Scanning video for viruses (@VideoScanningProgress %)
                </div>
            }
            else if (VideoUploading)
            {
                <div class="mt-5">
                    Scan complete. Uploading video to BrokerIQ...
                </div>
            }
            <div class="spin-row spin-row-bg">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" style="@SpinnerVisible" />
            </div>
        </div>

        <MudDialog @bind-IsVisible="RenameUploadVisibility">
            <TitleContent>
                Upload & rename video
            </TitleContent>
            <DialogContent>

                <MudInputString ID="inVal" @bind-Value="@VideoName" Type="InputType.Text" Placeholder="" />
            </DialogContent>
            <DialogActions>
                <MudButton Color="Color.Secondary" OnClick="OnCancelPushed">Cancel</MudButton>
                <MudButton Color="Color.Primary" OnClick="UploadButtonPushed">Ok</MudButton>
            </DialogActions>
        </MudDialog>


        <MudTable Items="@Videos" id="table-video" class="table col-sm-12 table-striped ">
            <HeaderContent>
                    <MudTh class="col-md-1">Watch</MudTh>
                    <MudTh class="col-md-2">Video Name</MudTh>
                    <MudTh class="col-md-2">Uploaded</MudTh>
                    <MudTh class="col-md-1">Birthday</MudTh>
                    <MudTh class="col-md-1">Send</MudTh>
                    <MudTh class="col-md-1">Delete</MudTh>
            </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Watch">
                            <div class="card video_table_col_width">
                                <div class="card_body video_card-body">
                                        @if (DisplayEmbeddedVideo[context.Name])
                                        {
                                            <div class="video_play">
                                            <video id="movie" class="video_play_size" controls preload autoplay>
                                                <source src='@context.Url#t=0.1'>
                                            </video>
                                            </div>

                                        }
                                        else
                                        {
                                            // thumbnails are always {Video.Name}.jpeg
                                            string thumbnailKey = $"{context.Name}.jpeg";
                                            if (VideoThumbnails.ContainsKey(thumbnailKey))
                                            {
                                                <div class="video_thumb">
                                                    <img class="img-thumbnail" src="@VideoThumbnails[thumbnailKey].Data" style="width:150px;"/>
                                                    <div class="play-button" @onclick="@( () => ShowVideoPlayer(@context.Name) )"></div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div>
                                                    <i class="bi bi-play-circle" style="cursor:pointer;" @onclick="@( () => ShowVideoPlayer(@context.Name) )">
                                                        <span>Play</span>
                                                    </i>
                                                    <img class="img-thumbnail"  style="cursor:pointer; width:100%;"
                                                        @onclick="@( () => ShowVideoPlayer(@context.Name) )" />
                                                </div>
                                            }
                                        }
                                 </div>
                            </div>

                        </MudTd>
                        <MudTd DataLabel="Video Name">@Path.GetFileNameWithoutExtension(context.Name)</MudTd>
                        <MudTd DataLabel="Uploaded">@((context.Date == null) ? "-" : ((DateTimeOffset)context.Date).ToString("g", new CultureInfo("en-GB")))</MudTd>
                        <MudTd DataLabel="Birthday"><input type="checkbox" checked="@context.BirthdayVideo" @onclick="f => SetBirthdayVideo(context.Name)" /></MudTd>
                        <MudTd DataLabel="Send">
                            <NavLink href="@($"videodetail?url={context.Url}")" class="btn btn-primary table-btn">
                                <i class="fas fa-paper-plane"></i>
                            </NavLink>
                        </MudTd>
                        <MudTd DataLabel="Delete">
                            <button class="btn btn-primary table-btn" @onclick="f => DeleteVideo(context.Name)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </MudTd>
                    </RowTemplate>
        </MudTable>
    }
}
else
{
    <div class="alert @StatusClass">@Message</div>
    <a class="btn btn-outline-primary" @onclick="@NavigateToOverview">Back to video list</a>
}
