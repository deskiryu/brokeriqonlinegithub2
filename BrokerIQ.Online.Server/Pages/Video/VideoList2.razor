                    </MudDropZone>
                    <MudDropZone T="BrokerIQ.Online.Server.Models.Video" OnlyZone="true" Identifier="Insurance">
                        <div class="card " style="padding-left: 0px; padding-right: 0px">
                            <div class="card-header">Insurance Video</div>
