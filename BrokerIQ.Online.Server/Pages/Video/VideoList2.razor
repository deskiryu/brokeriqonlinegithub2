                               AdornmentColor="Color.Primary" ValueChanged="@((int value) => OnBrokerChanged(value))">
                        <MudSelectItem Value="0">Select</MudSelectItem>
                        @foreach (var item in @Brokers)
                        {
                            <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </div>
        }
        <div>
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
</div>
    }
    else
    {
        <div class="row">
    <InputFile id="videofileinput" OnChange="LoadFiles" accept="video/mov,video/mp4,video/*" hidden multiple />
    <MudButton HtmlTag="label" Class="col-2 ml-4" Variant="Variant.Filled" Color="Color.Primary"
        Style="@($"color:{Colors.Shades.Black};")" StartIcon="@Icons.Filled.CloudUpload" for="videofileinput">
        Upload Video
    </MudButton>
    <p class="col-5">@status</p>
</div>





        <div class="">
            @if (VideoUploading)
            {
                <div class="mt-5">
                        Uploading video to BrokerIQ...
                </div>

                <div class="spin-row spin-row-bg mt-5">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" style="@SpinnerVisible" />
                </div>                
            }

        </div>

        <MudDialog @bind-IsVisible="RenameUploadVisibility">
            <TitleContent>
                Upload Video
            </TitleContent>
            <DialogContent>
                <MudTextField Label="Video Name" ID="inVal" @bind-Value="@VideoName" Type="InputType.Text" Placeholder=""
                    HelperText="Enter video name" />
                @if (IsAdmin)
                {
                    <MudSelect id="brokerVideo" class="form-control" @bind-Value="@BrokerListId">
                        <MudSelectItem Value=0>No Broker</MudSelectItem>
                        @foreach (var broker in @Brokers)
                        {
                            <MudSelectItem Value=@broker.Id>@broker.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
            </DialogContent>
            <DialogActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"
                    OnClick="OnCancelPushed">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"
                    OnClick="UploadButtonPushed">Ok</MudButton>
            </DialogActions>

        </MudDialog>

