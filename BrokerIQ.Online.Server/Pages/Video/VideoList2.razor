        <MudTable Items="@Videos" id="table-video" class="table col-sm-12 table-striped "
                  Filter="x => x.SpecialVideo==false ">
            <HeaderContent>
                <MudTh class="video_table_col_width_parent">Watch</MudTh>
                <MudTh class="">
                    <MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Server.Models.Video, object>(x=>x.Name)">Video Name
                    </MudTableSortLabel>
                </MudTh>
                <MudTh class="">
                    <MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Server.Models.Video, object>(x=>x.UploadDate)">Uploaded
                    </MudTableSortLabel>
                </MudTh>
                <MudTh class="">
                    <MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Server.Models.Video, object>(x=>x.SendDate)">Send Date
                    </MudTableSortLabel>
                </MudTh>
                @if (IsAdmin)
                {
                    <MudTh class="">
                        <MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Server.Models.Video, object>(x=>x.BrokerName)">
                            Broker
                        </MudTableSortLabel>
                    </MudTh>
                }

                <MudTh class="">
                    Vetted
                </MudTh>


                <MudTh class="">Welcome</MudTh> 
                <MudTh class="">Birthday</MudTh>
                <MudTh class="">Mortgage</MudTh>
                <MudTh class="">Send</MudTh>
                <MudTh class="">Delete</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Watch">
                    <div class="card video_table_col_width">
                        <div class="card_body video_card-body">
                            @if (DisplayEmbeddedVideo[context.Id])
                            {
                                <div class="video_play">
                                    <video id="movie" class="video_play_size" controls preload>
                                        <source src='@context.Url#t=0.1'>
                                    </video>
                                </div>

                            }
                            else
                            {
                                <div class="video_thumb">
                                    <img class="img-thumbnail" src="@context.VideoThumbnailData" style="width:150px;" />
                                    <div class="play-button" @onclick="@( () => ShowVideoPlayer(@context.Id) )"></div>
                                </div>
                            }
                        </div>
                    </div>

                </MudTd>
                <MudTd DataLabel="Video Name">@Path.GetFileNameWithoutExtension(context.Name)</MudTd>
                <MudTd DataLabel="Uploaded">@((context.UploadDate == null) ? "-" :
            ((DateTimeOffset)context.UploadDate).ToString("g", new CultureInfo("en-GB")))</MudTd>
                    <MudTd DataLabel="Video Send Date">
                        <div class="row">
                            <MudDatePicker Class="video_send_date" Culture=@(new CultureInfo("en-GB"))
                                PickerVariant="PickerVariant.Dialog" DisableToolbar="true" Date="@context.SendDate"
                                DateChanged="async (x) => await UpdateVideoSendDate(x, context.Id)"
                                style="font-size: 14px; margin-top: -10px">
                            </MudDatePicker>
                        </div>
                        <div class="row mt-2">
                            <MudCheckBox Checked="@context.SendDateTick"
                            @onclick="async f => await SetSendDateTick(context.Id)" />
                            <label class="video_checkbox_label">Send on this date</label>

                        </div>
                    </MudTd>
                    @if (IsAdmin)
                {
                    <MudTd DataLabel="Broker">@context.BrokerName</MudTd>
                }

                <MudTd>
                    <MudCheckBox Checked="@context.Vetted" @onclick="async f => await SetVetted(context.Id)" />
                </MudTd>

                <MudTd DataLabel="Welcome">
                    <MudCheckBox Checked="@context.WelcomeVideo" @onclick="async f => await SetWelcomeVideo(context.Id)" />
                </MudTd>
                <MudTd DataLabel="Birthday">
                    <MudCheckBox Checked="@context.BirthdayVideo" @onclick="async f => await SetBirthdayVideo(context.Id)" />
                </MudTd>
                <MudTd DataLabel="Mortgage">
                    <MudCheckBox Checked="@context.MortgageVideo" @onclick="async f => await SetMortgageVideo(context.Id)" />
                </MudTd>
                <MudTd DataLabel="Send">
                    @if (!IsMinorAdmin)
                    {
                        <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Icon="@Icons.Material.Filled.Send"
                            Link="@($"videodetail/{context.Id}")" />
                    }
                </MudTd>
                <MudTd DataLabel="Delete">
                    <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Icon="@Icons.Material.Filled.DeleteForever"
                        @onclick="f => DeleteVideo(context.Id)" />
                </MudTd>
            </RowTemplate>
        </MudTable>*@
    }
}
else
{
    <div class="alert @StatusClass">@Message</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"
        OnClick="@NavigateToOverview" class="btn btn-link">Back to video list</MudButton>
}
