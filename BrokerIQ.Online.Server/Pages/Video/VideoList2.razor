                    </MudDropZone>
        </div>
        <MudListSubheader Class="mt-4 pb-2">Your videos</MudListSubheader>
                <MudDropZone T="BrokerIQ.Online.Server.Models.Video" Identifier="Files"  Class="d-flex flex-wrap flex-grow-1 pa-2 rounded">







                </MudDropZone>
    </ChildContent>

    <ItemRenderer>
