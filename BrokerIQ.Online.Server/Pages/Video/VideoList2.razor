                        </div>
                    </div>

                </div>
                <div DataLabel="Video Name">@Path.GetFileNameWithoutExtension(context.Name)</div>
@*                <div DataLabel="Uploaded">
                    @((context.UploadDate == null) ? "-" :
                        ((DateTimeOffset)context.UploadDate).ToString("g", new CultureInfo("en-GB")))
                </div>
                <div DataLabel="Video Send Date">
                    <div class="row">
                        <MudDatePicker Class="video_send_date" Culture=@(new CultureInfo("en-GB"))
                                       PickerVariant="PickerVariant.Dialog" DisableToolbar="true" Date="@context.SendDate"
                                       DateChanged="async (x) => await UpdateVideoSendDate(x, context.Id)"
                                       style="font-size: 14px; margin-top: -10px">
                        </MudDatePicker>
                    </div>
                    <div class="row mt-2">
                        <MudCheckBox Checked="@context.SendDateTick"
                        @onclick="async f => await SetSendDateTick(context.Id)" />
                        <label class="video_checkbox_label">Send on this date</label>

                    </div>
                </div>
                @if (IsAdmin)
                {
                    <div DataLabel="Broker">@context.BrokerName</div>
                }*@

                <div>Vetted
                    <MudCheckBox Checked="@context.Vetted" @onclick="async f => await SetVetted(context.Id)" />
                </div>

@*                <div DataLabel="Welcome">
                    <MudCheckBox Checked="@context.WelcomeVideo" @onclick="async f => await SetWelcomeVideo(context.Id)" />
                </div>
                <div DataLabel="Birthday">
                    <MudCheckBox Checked="@context.BirthdayVideo" @onclick="async f => await SetBirthdayVideo(context.Id)" />
                </div>
                <div DataLabel="Mortgage">
                    <MudCheckBox Checked="@context.MortgageVideo" @onclick="async f => await SetMortgageVideo(context.Id)" />
                </div>*@
                <div DataLabel="Send">Send
                    @if (!IsMinorAdmin)
                    {
                        <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Icon="@Icons.Material.Filled.Send"
                                       Link="@($"videodetail/{context.Id}")" />
                    }
                </div>
                <div DataLabel="Delete">Delete
                    <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Icon="@Icons.Material.Filled.DeleteForever"
                    @onclick="f => DeleteVideo(context.Id)" />
                </div>
    </ItemRenderer>
</MudDropContainer>

        @code {
    private async Task ItemUpdated(MudItemDropInfo<BrokerIQ.Online.Server.Models.Video> dropItem)
    {
        dropItem.Item.Identifier = dropItem.DropzoneIdentifier;
        await RefreshVideoDrag();
    }

    public class DropItem
    {
        public string Name { get; init; }
        public string Identifier { get; set; }
    }
}
