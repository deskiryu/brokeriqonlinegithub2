@page "/account/register"
@using System.IO;
@using BrokerIQ.Online.Models
@using BrokerIQ.Online.Services.Interface
@using BrokerIQ.Online.Models.Account
@using AutoMapper
@using BrokerIQ.Dto.Models
@using BrokerIQ.Online.Server.Shared
@inject IAccountService AccountService
@inject IDialogService DialogService
@inject ILogoService LogoService
@inject IAddressService AddressService
@inject NavigationManager NavigationManager
@inject IMapper mapper


<div class="card">
    <h4 class="card-header">Register</h4>
    <div class="card-body">
        <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <div class="form-group col-12">
                <label>Company Name</label>
                <InputText @bind-Value="model.Name" class="form-control" />
                <ValidationMessage For="@(() => model.Name)" />
            </div>
            <div class="form-group row" style="padding-left:15px">
                <div class="form-group col-6">
                    <label>Broker First Name</label>
                    <InputText @bind-Value="model.BrokerFirstName" class="form-control" />
                    <ValidationMessage For="@(() => model.BrokerFirstName)" />
                </div>
                <div class="form-group col-6">
                    <label>Broker Last Name</label>
                    <InputText @bind-Value="model.BrokerLastName" class="form-control" />
                    <ValidationMessage For="@(() => model.BrokerLastName)" />
                </div>
            </div>
            <div class="form-group row" style="padding-left:15px">
                <div class="form-group col-6">
                    <label>Email Address</label>
                    <InputText @bind-Value="model.EmailAddress" class="form-control" />
                    <ValidationMessage For="@(() => model.EmailAddress)" />
                </div>
                <div class="form-group col-6">
                    <label>Telephone Number</label>
                    <InputText @bind-Value="model.TelephoneNumber" class="form-control" />
                    <ValidationMessage For="@(() => model.TelephoneNumber)" />
                </div>
            </div>
            <div class="form-group row" style="padding-left:15px">
                <div class="form-group col-6">
                    <label>Address Line 1</label>
                    <InputText @bind-Value="model.AddressLine1" class="form-control" />
                    <ValidationMessage For="@(() => model.AddressLine1)" />
                </div>
                <div class="form-group col-6">
                    <label>Address Line 2</label>
                    <InputText @bind-Value="model.AddressLine2" class="form-control" />
                    <ValidationMessage For="@(() => model.AddressLine2)" />
                </div>
            </div>
            <div class="form-group row" style="padding-left:15px">
                <div class="form-group col-6">
                    <label>City</label>
                    <InputText @bind-Value="model.AddressLine3" class="form-control" />
                    <ValidationMessage For="@(() => model.AddressLine3)" />
                </div>
            </div>
            <div class="form-group row" style="padding-left:15px">
                <div class="form-group col-6">
                    <label>Postcode</label>
                    <InputText @bind-Value="model.Postcode" class="form-control" />
                    <ValidationMessage For="@(() => model.Postcode)" />
                </div>
                <div class="form-group col-6" style="">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};margin-top:12px")" OnClick="FindAddress" >Find Address</MudButton>
                     <MudProgressCircular Color="Color.Primary" Indeterminate="true" style="@SpinnerVisible" />
                </div>

                <div class="form-group col-12">
                    <MudSelect T="int"
                               Label="Addresses"
                               Placeholder="Select"
                               Disabled="DropdownDisabled"                           
                               @bind-Value="AddressId"
                               SelectedValuesChanged="@AutoCompleteFindAddress"
                               AdornmentColor="Color.Primary">
                        <MudSelectItem Value="0">Select</MudSelectItem>
                        @foreach (var item in @Addresses)
                        {
                            <MudSelectItem Value="@item.Item3">@item.Item2</MudSelectItem>
                        }
                    </MudSelect>
                </div>

            </div>

            <div class="form-group row" style="padding-left:15px">
                <div class="form-group col-6">
                    <label>Two Factor SMS Phone Number</label>
                    <InputText @bind-Value="model.TwoFactorPhoneNumber" class="form-control" />
                    <ValidationMessage For="@(() => model.TwoFactorPhoneNumber)" />
                    <div class="col-sm-1">
                        <MudCheckBox @bind-Checked="@model.TwoFactorUseBrokerPhoneNumber" />
                    </div>
                </div>
            </div>
            <div class="form-group row" style="padding-left:15px">
                <label class="form-group col-6">Company Logo </label>
                <div class="form-group col-6">
                    @if (model.LogoImage != null && model.LogoImage.Length > 0)
                    {
                        <img src="data:image/bmp;base64, @(Convert.ToBase64String(model.LogoImage))" />
                    }
                </div>
            </div>
            <div class="form-group row" style="padding-left:15px">
                <label class="form-group col-6">Choose company logo </label>
                <div class="form-group col-6">
                <InputFile id="logofileinput" OnChange="LoadFiles" accept="image/jpeg" hidden multiple/>
                <MudButton HtmlTag="label"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Style="@($"color:{Colors.Shades.Black};")"
                   StartIcon="@Icons.Filled.CloudUpload"
                   for="logofileinput">
                    Choose File
                </MudButton>
                </div>
                <div class="form-group col-6">
                    <label style="font-size:small">Ratio 2.2:1 Ideally 220px x 100px</label>
                </div>
            </div>

            <div class="form-group row" style="padding-left:15px">
                <div class="form-group col-6">
                    <label>Password</label>
                    <MudTextField @bind-Value="model.Password" Label="Password" InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="ShowPassword" AdornmentAriaLabel="Show Password"/>
                    <ValidationMessage For="@(() => model.Password)" />
                </div>
                <div class="form-group col-6">
                    <label>Confirm Password</label>
                    <MudTextField @bind-Value="model.ConfirmPassword" Label="Password" InputType="@PasswordInputConfirm" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIconConfirm" OnAdornmentClick="ShowPasswordConfirm" AdornmentAriaLabel="Show Password"/>
                    <ValidationMessage For="@(() => model.ConfirmPassword)" />
                </div>
            </div>
            <div class="form-group col-12">
                <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" disabled="@loading" class="btn btn-primary">
                    @if (loading)
                    {
                        <span class="spinner-border spinner-border-sm mr-1"></span>
                    }
                    Register
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"  Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Cancel</MudButton>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private AddUser model = new AddUser();
    private bool loading;
    public int AddressId { get; set; }
    public List<(Address, string, int)> Addresses = new List<(Address, string, int)>();
    public string SpinnerVisible { get; set; }
    public bool DropdownDisabled { get; set; }

    protected override async Task OnInitializedAsync()
    {
        SpinnerVisible = "display:none";
        DropdownDisabled = true;
    }

    bool isShow; InputType PasswordInput = InputType.Password;string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    void ShowPassword()
    {
        @if (isShow){isShow = false; PasswordInputIcon = Icons.Material.Filled.VisibilityOff; PasswordInput = InputType.Password;}
        else {isShow = true; PasswordInputIcon = Icons.Material.Filled.Visibility; PasswordInput = InputType.Text;}
    }

    bool isShowConfirm; InputType PasswordInputConfirm = InputType.Password;string PasswordInputIconConfirm = Icons.Material.Filled.VisibilityOff;

    void ShowPasswordConfirm()
    {
        @if (isShowConfirm){isShowConfirm = false; PasswordInputIconConfirm = Icons.Material.Filled.VisibilityOff; PasswordInputConfirm = InputType.Password;}
        else {isShowConfirm = true; PasswordInputIconConfirm = Icons.Material.Filled.Visibility; PasswordInputConfirm = InputType.Text;}
    }

    private async void OnValidSubmit()
    {
        loading = true;
        var brokerReturned = new BrokerDto();                                
        var dialogParams = new DialogParameters();
        try
        {
            var createBroker = mapper.Map<CreateBrokerDto>(model);
            brokerReturned = await AccountService.Register(createBroker);
            if (brokerReturned == null || string.IsNullOrEmpty(brokerReturned.EmailAddress))
            {
                throw new Exception("Registration failed");
            }

            if (createBroker.LogoImage != null && createBroker.LogoImage.Length > 0)
            {

                var memoryStream = new MemoryStream(createBroker.LogoImage);
                var fileName = brokerReturned.Id.ToString() + ".jpeg";
                memoryStream.Position = 0;
                await LogoService.UploadLogo(fileName, memoryStream, brokerReturned.Id);
            }

            dialogParams.Add("Message", $"Registration successful - Please check your email, including JUNK folders, for the verfication email");
            await DialogService.Show<AlertDialog>("Registration", dialogParams).Result;

        }
        catch (Exception ex)
        {
            dialogParams.Add("Message", ex.Message);
            await DialogService.Show<AlertDialog>("Registration", dialogParams).Result;
        }
        loading = false;
        StateHasChanged();

    }

    public async Task LoadFiles(InputFileChangeEventArgs e)
    {

        try
        {
            var file = e.GetMultipleFiles(1).FirstOrDefault();
            var ext = Path.GetExtension(file.Name);
            if (ext != ".jpeg" && ext != ".jpg")
            {
                throw new Exception("Jpeg files only");
            }
            if (file != null)
            {
                var memoryStream = new MemoryStream();
                await file.OpenReadStream(int.MaxValue).CopyToAsync(memoryStream);
                memoryStream.Position = 0;  
                model.LogoImage = memoryStream.ToArray();
            }
        }
        catch (Exception ex)
        {

        }
        finally
        {
            StateHasChanged();
        }
    }

    protected async Task FindAddress()
    {
        DropdownDisabled = true;
        SpinnerVisible = "";
        var ReturnedAddresses = await AddressService.GetAddressesFromPostcode(model.Postcode,"gb");
        Addresses.Clear();
        if(ReturnedAddresses!=null && ReturnedAddresses.Any())
        {
            for(int i=0; i<ReturnedAddresses.Count(); i++)
            {
                var item = ReturnedAddresses[i];
                var lineTwo = !string.IsNullOrEmpty(item.AddressLine2) ? $"{item.AddressLine2}, " : "";
                var lineCity = !string.IsNullOrEmpty(item.City) ? $"{item.City}, " : "";
                var completeAddress = $"{item.AddressLine1}, " +
                                      lineTwo +
                                      lineCity +
                                      item.Postcode;
                Addresses.Add((item, completeAddress, i));
            }
        }
        SpinnerVisible = "display:none";
        DropdownDisabled = false;

    }

    protected void AutoCompleteFindAddress()
    {
        var thisAddress = Addresses.FirstOrDefault(x => x.Item3 == AddressId);
        if(thisAddress.Item1 != null)
        {
            model.AddressLine1 = thisAddress.Item1.AddressLine1;
            model.AddressLine2 = thisAddress.Item1.AddressLine2;
            model.AddressLine3 = thisAddress.Item1.City;
            model.Postcode = thisAddress.Item1.Postcode;
        }
    }

    protected void NavigateToOverview()
    {
        NavigationManager.NavigateTo($"/account/login");
    }
}
