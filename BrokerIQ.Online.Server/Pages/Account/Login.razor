@page "/account/login"


@using Microsoft.Extensions.Options
@using BrokerIQ.Online.AppSettings
@using BrokerIQ.Online.Services.Interface
@using BrokerIQ.Online.Server.Helper
@using BrokerIQ.Dto.Response
@using BrokerIQ.Online.Server.Extensions

@inject IAccountService AccountService
@inject IAlertService AlertService
@inject NavigationManager NavigationManager
@inject LoggedInAppState MyLoggedInAppState
@inject IOptions<ReviewItAPIDetails> api
@inject IJSRuntime js

@functions {
    async void StartWarningTimer()
    {
        await Extensions.StartWarningTimer(js,api.Value.AutoLogoutTimeMs);
    }
}


<div class="card">
    <h4 class="card-header">Login</h4>
    <div class="card-body">
        <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
            <MudCard>
            <MudCardContent>
            <DataAnnotationsValidator />
                <MudTextField @bind-Value="model.EmailAddress" Label="Email Address" Variant="Variant.Text" Margin="Margin.Dense" />
                <ValidationMessage For="@(() => model.EmailAddress)" />

                <MudTextField @bind-Value="model.Password" Label="Password" InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="ShowPassword" AdornmentAriaLabel="Show Password"/>
                <ValidationMessage For="@(() => model.Password)" />

                @if (ShowVerifyCode)
                    {
                     <MudTextField @bind-Value="model.TwoFactorCode" Label="Two factor code" Variant="Variant.Text" Margin="Margin.Dense" />
                <ValidationMessage For="@(() => model.TwoFactorCode)" />                       
                    }

            </MudCardContent>
            <MudCardActions>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Class="ml-auto" Disabled="@Loading">Login</MudButton>
            </MudCardActions>
        </MudCard>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};margin-top:5px")" Link="account/register" class="btn btn-link">Register</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};margin-top:5px")" Link="account/resetpassword" class="btn btn-link">Forgot Password</MudButton>
        </EditForm>
    </div>
</div>

@code {

    private BrokerIQ.Online.Models.Account.Login model = new BrokerIQ.Online.Models.Account.Login();

    public bool Loading { get; set; }

    public bool ShowVerifyCode{ get; set; }

    bool isShow; InputType PasswordInput = InputType.Password;string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    void ShowPassword()
    {
        @if (isShow){isShow = false; PasswordInputIcon = Icons.Material.Filled.VisibilityOff; PasswordInput = InputType.Password;}
        else {isShow = true; PasswordInputIcon = Icons.Material.Filled.Visibility; PasswordInput = InputType.Text;}
    }

    private async void OnValidSubmit()
    {
        // reset alerts on submit
        AlertService.Clear();

        bool Success = true;
        Loading = true;
        var response = new LoginResponseDto();

        try
        {
            if(!ShowVerifyCode)
            {
                response = await AccountService.Login(model);               
            }
            else
            {
                response = await AccountService.LoginTwoFactor(model);              
            }

        }
        catch (Exception ex)
        {
            Success = false;
        }



#if !DEBUG   
        var isRunningWasm = await RunningWasm.IsWebAssembly(js);

        if (isRunningWasm && Success && response.IsAdmin)
        {
            AlertService.Error($"Admin users may only use the main site.");
        }
        else if (isRunningWasm && Success && response.RequiresTwoFactor == false && ShowVerifyCode == false)
        {
            if(!response.LoggedIn)
            {
                AlertService.Error("Could not log on the user with this email address / password");
            }
            else
            {
                AlertService.Error($"Two factor authentication required for this site, contact admin@brokeriq.co.uk to activate.");               
            }
        } 
        else 
#endif  
        if (Success && !response.LoggedIn && response.RequiresTwoFactor)
        {
            if (Success && response.RequiresTwoFactor)
            {
                ShowVerifyCode = true;
                AlertService.Error($"Please enter the code we sent you");
            }
        }
        else if (Success && response.LoggedIn && !response.IsCustomer)
        {
            ShowVerifyCode = false;
            if (Success && !response.EmailConfirmed)
            {
                AlertService.Error("Please check your email for the link to verify your account.");
            }
            else
            {
                MyLoggedInAppState.LoggedIn = response.LoggedIn;
                var user = await AccountService.GetUser();
                MyLoggedInAppState.IsAdmin = user.IsAdmin;
                MyLoggedInAppState.IsBroker = user.IsBroker;

                try
                {
                    await InvokeAsync(() =>
                    {
                        NavigationManager.NavigateTo("");
                        StartWarningTimer();

                    });

                }
                catch (Exception ex)
                {
                    AlertService.Error("Navigate failed: " + ex.Message);
                }
            }
        }
        else if (Success && !response.LoggedIn && response.IsLockedOut)
        {
            ShowVerifyCode = false;
            AlertService.Error($"Your account has been locked from too many login attempts. Please try again in {response.LockoutMinutes} minutes.");
        }
        else
        {
            ShowVerifyCode = false;
            AlertService.Error("Could not log on the user with this email address / password");
            Success = false;
        }

        Loading = false;
        StateHasChanged();
    }
}
