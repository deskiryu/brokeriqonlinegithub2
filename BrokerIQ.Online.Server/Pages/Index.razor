@page "/"
@using BrokerIQ.Online.Services.Interface
@using BrokerIQ.Dto.Enum;
@using Microsoft.Extensions.Options
@using BrokerIQ.Online.AppSettings

@inject IBrokerService BrokerService
@inject IBrokerStaffService BrokerStaffService
@inject IAccountService AccountService
@inject IOptions<ReviewItAPIDetails> api

@if (Broker != null)
{
    @if (BrokerStaff != null)
    {
        <div>
            <h3>Hello @BrokerStaff.FirstName @BrokerStaff.LastName</h3>
            <h2>for @Broker.Name </h2>
        </div>
    }
    else
    {
        <h3>Hello, @Broker.Name</h3>
    }

    <div>
        <h3>Welcome to your new Digital Customer Engagement platform.</h3>
    </div>
    <p></p>
    <p></p>
    @if (_showBrokerMatchingCode)
    {
        <div>
            <h5>Your unique broker code is @_brokerMatchingCode </h5>
            <h6>Share this code with your clients to seamlessly connect with them on YAH.</h6>
        </div>
    }


    <div class="form-group row">
        <div class="col-sm-8">
            @if (Broker.LogoImage != null && Broker.LogoImage.Length > 0)
            {
                <img src="data:image/bmp;base64, @(Convert.ToBase64String(Broker.LogoImage))"
                    style="height:100px; width:220px" />
            }
        </div>
    </div>

}
else
{
    <h3>Hello</h3>
}


<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <BrokerIQ.Online.Server.Components.BlogList />
</MudContainer>

@code {
    BrokerIQ.Online.Models.Broker Broker;
    BrokerIQ.Online.Models.BrokerStaff BrokerStaff;
    bool _showBrokerMatchingCode = false;
    string _brokerMatchingCode;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = await AccountService.GetUser();
            if (user != null)
            {
                if (user.IsBroker || user.IsAdminStaff || user.IsBrokerStaff)
                {
                    Broker = await BrokerService.GetBroker(user.MasterBrokerId);
                    if (Broker != null)
                    {

                        if (Broker != null && Broker.BrokerIdentifier != null && !string.IsNullOrEmpty(Broker.BrokerIdentifier.MatchingCode) &&
                        api.Value.IsYAHTheme)
                        {
                            _showBrokerMatchingCode = true;
                            _brokerMatchingCode = Broker.BrokerIdentifier.MatchingCode;
                        }

                    }
                }

                if (user.IsAdminStaff || user.IsBrokerStaff)
                {
                    var brokerStaffId = 0;
                    Int32.TryParse(user.Id, out brokerStaffId);
                    if (brokerStaffId > 0)
                    {
                        BrokerStaff = await BrokerStaffService.GetBrokerStaff(brokerStaffId);
                    }

                }
            }
        }
        catch
        {

        }



    }
}
