@page "/workflows"

@using BrokerIQ.Dto.Enum
@using BrokerIQ.Online.Server.Extensions

@inherits WorkflowsBase

<div class="mb-2">
    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Style="color: black" Size="Size.Medium"
               Href="/workflow">Add workflow</MudButton>
</div>
<MudTable Items="@BrokerWorkflows" Dense="true">
    <NoRecordsContent>
        <MudText>No workflows have been defined.</MudText>
    </NoRecordsContent>
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Trigger</MudTh>
        <MudTh></MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@(context.Name)</MudTd>
        <MudTd> @_triggerOptions.First(t => t.Id == context.TriggerId).Name</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Color="Color.Primary" Style="color:black" Size="Size.Small" Href="@($"workflow/{context.Id}")"/>
        </MudTd>
        <MudTd>
            @{
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick=@(r=> RemoveWorkflow(context)) />
            }
        </MudTd>
    </RowTemplate>
</MudTable>