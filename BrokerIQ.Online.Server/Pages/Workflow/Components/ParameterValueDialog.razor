@using BrokerIQ.Online.Server.Components
<MudDialog>
    <DialogContent>
        @foreach(var param in StepParameters){
            var activityParam = ActivityParameters.First(p => p.Order == param.Order);

            switch(activityParam.Type){
                case "text":
                    <MudTextField Label="@activityParam.Label" Variant="Variant.Text" Margin="Margin.Dense" @bind-Value="param.Value"/>
                    break;
                case "template":
                        <TemplateMessageEditor Broker="Broker" Customer="SampleCustomer" Connection="SampleConnection"
                        @bind-DefinedMessage="Template"
                        @bind-MessagePreview="Message" />
                    break;
                case "timespan":
                     <TimeControl @bind-Value="param.Value"/>
                    break;
                default:
                    continue;
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton OnClick="Confirm" Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black}")">Confirm</MudButton>
    </DialogActions>
</MudDialog>