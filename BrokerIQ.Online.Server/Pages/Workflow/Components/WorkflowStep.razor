<MudPaper Class="pa-1 ma-1">
@if(@InEditMode)
{
    <MudSelect T="int" @bind-Value="SelectedActivityId" Dense="true" Label="Action" >
        <MudSelectItem T="int" Value="0">Please Select</MudSelectItem>
        @foreach (var option in Activities)
        {
            <MudSelectItem T="int" Value="@option.Id">@option.Description</MudSelectItem>
        }
    </MudSelect>
    @if(ActivityParameters.Any()){
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="EditParameters" FullWidth="true">Parameters</MudButton>
    }
}
else{
    <div class="d-flex justify-space-between align-center">
        <MudText Typo="Typo.body2">Action</MudText>
        <MudSpacer/>
        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Dark" OnClick="@ResetStep"/>
    </div>
    <MudText>@SelectedAction</MudText>
    @if(Step.StepParameters.Any()){
        <div class="pl-1 mt-1">
            @ParametersText
        </div>
    }
}
</MudPaper>