<MudPaper Class="pa-2 ma-1"
          Elevation="3">
    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween">
        <MudMenu Label="@(SelectedActivity != null ? SelectedActivity.Name : "Choose Activity")"
                 Dense="true"> @foreach (var activity in Activities) {
                 <MudMenuItem OnClick="() => SetActivity(activity.Id)">@activity.Name
            </MudMenuItem>
                                  }
        </MudMenu>
        <MudChip Size="Size.Small" Color="@ActivityColor"
                 OnClick="EditParameters">@ActivityLabel</MudChip>
    </MudStack>
    <MudDivider Class="ma-1" />
    <MudText Class="ma-1"
             Typo="Typo.caption">@SelectedActivity.Description</MudText>
</MudPaper> @* @if(@InEditMode)
