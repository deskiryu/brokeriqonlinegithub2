<MudPaper Class="pa-1 ma-1">
    <MudStack Row="true">
        <MudSelect T="int" @bind-Value="Step.ActivityId" Dense="true" Label="Action">
            <MudSelectItem T="int" Value="0">Please Select</MudSelectItem>
            @foreach (var option in ActivityOptions)
            {
                <MudSelectItem T="int" Value="@option.Id">@option.Description</MudSelectItem>
            }
        </MudSelect>
        @if(ActivityParameters.Any()){
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default" OnClick="EditParameters"/>
        }
    </MudStack>
</MudPaper>