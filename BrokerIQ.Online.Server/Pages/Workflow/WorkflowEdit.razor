@page "/workflow"
@page "/workflow/{WorkflowId}"

@inherits WorkflowEditBase

@using BrokerIQ.Online.Server.Pages.Workflow.Components

<MudContainer Class="pa-2 mx-auto my-2" >
    <h4 class="page-title">Edit Workflow</h4>

    <MudPaper Class="pa-2">
        <MudStack Row="true">
            <MudTextField T="string" @bind-Value="Workflow.Name" Label="Workflow Name"
                Variant="Variant.Text" Margin="Margin.Dense" MaxLength="100" Error="@(string.IsNullOrWhiteSpace(Workflow.Name))"
                Required="true" RequiredError="Please name this workflow" Immediate="true"/>
        </MudStack>
        <WorkflowDiagram Workflow="Workflow" Activities="_activities" OnChanged="HandleChildChanged"/>
        <MudStack Row="true" Spacing="1" Class="mt-2" Justify="Justify.FlexEnd">
            @if(Workflow.Id != Guid.Empty){
                <MudButton Variant="Variant.Filled" Color="@ActiveButtonColour" OnClick="SetActiveStatus" >@ActiveButtonLabel</MudButton>
            }
            <MudButton Variant="Variant.Outlined" Href="workflows">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="@WorkflowIsNotValid" >Save</MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>