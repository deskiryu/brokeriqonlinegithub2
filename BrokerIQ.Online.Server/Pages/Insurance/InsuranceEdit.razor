

@page "/insuranceedit/{InsuranceId}/{CustomerId}"
@using BrokerIQ.Online.Models
@using BrokerIQ.Dto.Enum
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Extensions
@using BlazorDateRangePicker
@using BrokerIQ.Online.Services.Interface
@using System.IO

@inherits InsuranceEditBase

@inject IJSRuntime js
@functions {
    async void DownloadFile(InsuranceDocument sdoc)
    {
        await Extensions.SaveAs(js, sdoc.FileName, sdoc.File);
    }
    async void PreviewFile(InsuranceDocument sdoc)
    {
        var memoryStream = new MemoryStream(sdoc.File);
        await Extensions.PreviewFile(js, memoryStream);
    }
}

@if (!Saved)
{
    <section class="insurance-detail">

        <h4 class="page-title">Add or edit insurance</h4>

        <EditForm Model="@Insurance" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="col-12 row">
                <div class="col-10 row">
                    <div class="col-xs-12 col-sm-8">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Name Of Insurer</label>

                            <div class="col-sm-5">
                                <InputText id="lastName" class="form-control" @bind-Value="@Insurance.Name" placeholder="Enter name for this insurance"></InputText>
                                <ValidationMessage class="offset-sm-3" For="@(() => Insurance.Name)" />
                            </div>
                        </div>

                       <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Consumer Insurance</label>
                            <div class="col-sm-5">
                                 <InputSelect id="consumerInsurance" class="form-control" 
                                 ValueExpression="@(()=>InsuranceType)" 
                                  Value="@InsuranceType" 
                                  ValueChanged="@((int value) => OnValueChanged(value))">
                                    @if (ConsumerInsurances!=null && ConsumerInsurances.Any())
                                    {
                                        @foreach(var ci in ConsumerInsurances)
                                        {
                                                <option value=@ci.Item1>@ci.Item2</option>
                                        }
                                    }
                                </InputSelect>
                                <ValidationMessage class="offset-sm-3" For="@(() => InsuranceType)" />
                            </div>
                        </div>
 
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Or Business Insurance</label>
                            <div class="col-sm-5">
                                 <InputSelect id="businessInsurance" class="form-control"
                                 ValueExpression="@(()=>InsuranceType)" 
                                  Value="@InsuranceType" 
                                  ValueChanged="@((int value) => OnValueChanged(value))">
                                    @if (BusinessInsurances!=null && BusinessInsurances.Any())
                                    {
                                        @foreach(var bi in BusinessInsurances)
                                        {
                                                <option value=@bi.Item1>@bi.Item2</option>
                                        }
                                    }
                                </InputSelect>
                                <ValidationMessage class="offset-sm-3" For="@(() => InsuranceType)" />
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Notes (visible to client)</label>

                            <div class="col-sm-5">
                                <InputTextArea id="brokerNotes" cols="40" rows="5" @bind-Value="@Insurance.BrokerNotes" placeholder="Enter notes for this insurance which will be visible to the client"></InputTextArea>
                                <ValidationMessage class="offset-sm-3" For="@(() => Insurance.BrokerNotes)" />
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Contact</label>
                            <div class="col-sm-5">
                                <InputText id="lastName" class="form-control" @bind-Value="@Insurance.ContactNumber" placeholder="Enter telephone for this insurance"></InputText>
                                <ValidationMessage class="offset-sm-3" For="@(() => Insurance.ContactNumber)" />
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Cost PM and PY</label>
                            <div class="row col-sm-5">
                                <MudItem class="col" >
                                    <MudTextField @bind-Value="@Insurance.Cost" HelperText="Enter a cost" Format="F2" Adornment="Adornment.Start" AdornmentText="£" />
                                    <ValidationMessage class="offset-sm-3" For="@(() => Insurance.Cost)" />
                                </MudItem>
                                <MudRadioGroup class="col-sm-4" @bind-SelectedOption="@Insurance.Annual">
                                    <MudRadio Option="@true">Annual</MudRadio>
                                    <MudRadio Option="@false">Monthly</MudRadio>
                                </MudRadioGroup>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Start Date</label>
                            <div class="col-sm-5">
                                <DateRangePicker @bind-StartDate="StartDate" SingleDatePicker="true" class="form-control" Culture="@(System.Globalization.CultureInfo.GetCultureInfo("en-GB"))"></DateRangePicker>
                                <ValidationMessage class="offset-sm-3" For="@(() => Insurance.StartDate)" />
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Expiry Date</label>
                            <div class="col-sm-5">
                                <DateRangePicker @bind-StartDate="ExpiryDate" SingleDatePicker="true" class="form-control" Culture="@(System.Globalization.CultureInfo.GetCultureInfo("en-GB"))"></DateRangePicker>
                                <ValidationMessage class="offset-sm-3" For="@(() => Insurance.ExpiryDate)" />
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Review Date</label>
                            <div class="col-sm-5">
                                <DateRangePicker @bind-StartDate="ReviewDate" SingleDatePicker="true" class="form-control " Culture="@(System.Globalization.CultureInfo.GetCultureInfo("en-GB"))"></DateRangePicker>
                                <ValidationMessage class="offset-sm-3" For="@(() => Insurance.ReviewDate)" />
                            </div>
                            <div class="col-sm-2">
                                <label>Show</label>
                                <MudCheckBox @bind-Checked="@Insurance.ShowReviewDate" />
                            </div>
                        </div>


                        @if(Insurance.IsTermTypeInsurance){


                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Term Type</label>
                            <div class="col-sm-5">

                                <InputSelect id="termtype" class="form-control" @bind-Value="@TermType" onchange="">
                                    @if (true)
                                        {
                                            var names = Enum.GetNames(typeof(TermTypeEnum));
                                        @for (int i = 0; i < names.Length; i++)
                                            {
                                                var looped = (TermTypeEnum)i;
                                            <option value=@i>@looped.GetDisplayName()</option>
                                            }
                                        }
                                </InputSelect>
                                <ValidationMessage class="offset-sm-3" For="@(() => TermType)" />

                            </div>
                        </div>

                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label">Term</label>
                                <div class="col-sm-5">
                                    <MudItem class="col">
                                        <MudTextField @bind-Value="@Insurance.TermYears" HelperText="Enter a term" Format="" Adornment="Adornment.Start" AdornmentText="Years" />
                                        <ValidationMessage class="offset-sm-3 col-sm-7" For="@(() => Insurance.TermYears)" />
                                    </MudItem>
                                </div>
                                <div class="col-sm-2 mt-5">
                                    <label>Show</label>
                                    <MudCheckBox @bind-Checked="@Insurance.ShowTermYears" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label">Benefit Amount</label>
                                <div class="col-sm-5">
                                    <MudItem class="col" >
                                        <MudTextField @bind-Value="@Insurance.TermAmount" HelperText="Enter a benefit amount" Format="F2" Adornment="Adornment.Start" AdornmentText="£" />
                                        <ValidationMessage class="offset-sm-3 col-sm-7" For="@(() => Insurance.TermAmount)" />
                                    </MudItem>
                                </div>
                                <div class="col-sm-2 mt-5">
                                    <label>Show</label>
                                    <MudCheckBox @bind-Checked="@Insurance.ShowTermAmount" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label">Deferred Period</label>
                                <div class="col-sm-5">
                                    <MudItem class="col">
                                        <MudTextField @bind-Value="@Insurance.DeferredPeriodWeeks" HelperText="Enter a deferred period" Format="" Adornment="Adornment.Start" AdornmentText="Weeks" />
                                        <ValidationMessage class="offset-sm-3 col-sm-7" For="@(() => Insurance.DeferredPeriodWeeks)" />
                                    </MudItem>
                                </div>
                                <div class="col-sm-2 mt-5">
                                    <label>Show</label>
                                    <MudCheckBox @bind-Checked="@Insurance.ShowDeferredPeriodWeeks" />
                                </div>
                            </div>
                        }



                        @if (IsAdmin)
                        {
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label">Choose Broker</label>
                                <div class="col-sm-8">

                                    <InputSelect id="broker" class="form-control" @bind-Value="@BrokerListId">

                                        @foreach (var broker in @Brokers)
                                                {
                                            <option value=@broker.Id>@broker.Name</option>
                                                }
                                    </InputSelect>
                                    <ValidationMessage class="offset-sm-3" For="@(() => BrokerListId)" />

                                </div>
                            </div>
                        }
  
                        @if(Insurance!=null && Insurance.Id>0){

                            <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")">Save insurance</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")">Add insurance</MudButton>
                            <MudCheckBox @bind-Checked="@SendNotification" Class="ml-1 mt-2" />
                            <label class="mt-2">Send Notification</label>
                        }

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" Class="ml-4">Cancel</MudButton>

                        @if (Insurance.Id > 0)
                        {

                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@DeleteInsurance" Class="ml-4">Delete</MudButton>

                        }

                    </div>

                </div>
            </div>

        </EditForm>

    </section>
    

    <h4 class ="col-sm-4">Supporting Documents</h4>

    @if (Insurance.SupportingDocuments != null)
    {
        <div class="col-sm-6 mt-1">
            <div class="card">
                <div class="card-body">
                    <MudTable Items="@Insurance.SupportingDocuments" Hover="true" SortLabel="Sort By" Class="">
                        <RowTemplate>
                            <MudTd>@context.FileName</MudTd>
                            @if (Insurance.Id > 0)
                            {
                                <MudTd> <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => PreviewFile(context))" class="btn btn-link">View</MudButton></MudTd>
                                <MudTd> <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DownloadFile(context))" class="btn btn-link">Download</MudButton></MudTd>
                                <MudTd> <MudButton Variant="Variant.Filled" Color="Color.Error" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DeleteInsuranceFile(context.Id))" class="btn btn-link">Delete</MudButton></MudTd>
                            }
                            else
                            {            
                               <MudTd> <MudButton Variant="Variant.Filled" Color="Color.Error" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DeleteInsuranceFile(context.Id))" class="btn btn-link">Delete</MudButton></MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                </div>
            </div>
        </div>
    }
    <div class="col-sm-6 mt-1">
        <div class="card">
            <div class="card-body">
                <label class="card-title">Upload pdf files</label>
                <MudPaper @ondragenter="@(() => DragEnterStyle = "drag-enter")"
                            @ondragleave="@(() => DragEnterStyle = null)"
                            @ondragend="@(() => DragEnterStyle = null)"
                            Class=@("drag-drop-zone " + DragEnterStyle)>

                    <InputFile OnChange="LoadFiles" multiple class="drag-drop-input" accept="application/pdf"/>
                    <MudText Typo="Typo.subtitle1">Drag and drop pdf files here or click to browse</MudText>
                </MudPaper>
            </div>
        </div>
    </div>

    <label type="text" class="form-control-plaintext col-sm-4">@LoadFileStatus</label>
    <div class="col-sm">
        <div class="spin-row spin-row-bg">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" style="@SpinnerVisible" />
        </div>
    </div>

}
else
{
    <div class="alert @StatusClass">@Message</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Back to client overview</MudButton>
}

