@page "/insuranceedit/{InsuranceId}/{CustomerId}"

@using System.IO

@using Microsoft.Extensions.Options

@using BrokerIQ.Online.Models
@using BrokerIQ.Dto.Enum
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Extensions
@using BlazorDateRangePicker
@using BrokerIQ.Online.Services.Interface

@using BrokerIQ.Online.AppSettings

@inherits InsuranceEditBase

@inject IOptions<ReviewItAPIDetails> Options
@inject IJSRuntime js

@functions {
    async void DownloadFile(InsuranceDocument sdoc)
    {
        await Extensions.SaveAs(js, sdoc.FileName, sdoc.File);
    }
    async void PreviewFile(InsuranceDocument sdoc)
    {
        var memoryStream = new MemoryStream(sdoc.File);
        await Extensions.PreviewFile(js, memoryStream);
    }
}

@if (!Saved)
{
    <section class="insurance-detail">

        <h4 class="page-title">Add or edit insurance</h4>

        @if(Options.Value.CanLoadInsuranceFromFile && Insurance.Id == 0)
        {
            <MudPaper Class="pa-3 ma-2 col-sm-6" Outlined="true">
                <MudButton Variant="Variant.Filled" FullWidth="true" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@OpenAnalyzerDialog">Fill Details From File ...</MudButton>
            </MudPaper>
        }

        <EditForm Model="@Insurance" OnValidSubmit="@HandleValidSubmit" OnInvalidSubmit="@HandleInvalidSubmit" id="@FormId">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="col-12 row">
                <div class="col-10 row">
                    <div class="col-xs-12 col-sm-8">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Name Of Insurer</label>

                            <div class="col-sm-5">
                                <InputText id="lastName" class="form-control" @bind-Value="@Insurance.Name" placeholder="Enter name for this insurance"></InputText>
                                <ValidationMessage class="offset-sm-3" For="@(() => Insurance.Name)" />
                            </div>
                        </div>

                       <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Consumer Insurance</label>
                            <div class="col-sm-5">
                                 <InputSelect id="consumerInsurance" class="form-control" 
                                 ValueExpression="@(()=>InsuranceType)" 
                                  Value="@InsuranceType" 
                                  ValueChanged="@((int value) => OnValueChanged(value))">
                                    @if (ConsumerInsurances!=null && ConsumerInsurances.Any())
                                    {
                                        @foreach(var ci in ConsumerInsurances)
                                        {
                                                <option value=@ci.Item1>@ci.Item2</option>
                                        }
                                    }
                                </InputSelect>
                                <ValidationMessage class="offset-sm-3" For="@(() => InsuranceType)" />
                            </div>
                        </div>
                        @if(Broker != null && Broker.ProvidesBusinessInsuranceServices)
                        {
                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Or Business Insurance</label>
                                <div class="col-sm-5">
                                     <InputSelect id="businessInsurance" class="form-control"
                                     ValueExpression="@(()=>InsuranceType)" 
                                      Value="@InsuranceType" 
                                      ValueChanged="@((int value) => OnValueChanged(value))">
                                        @if (BusinessInsurances!=null && BusinessInsurances.Any())
                                        {
                                            @foreach(var bi in BusinessInsurances)
                                            {
                                                    <option value=@bi.Item1>@bi.Item2</option>
                                            }
                                        }
                                    </InputSelect>
                                    <ValidationMessage class="offset-sm-3" For="@(() => InsuranceType)" />
                                </div>
                            </div>
                        }
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Notes (visible to client)</label>

                            <div class="col-sm-5">
                                <InputTextArea id="brokerNotes" cols="40" rows="5" @bind-Value="@Insurance.BrokerNotes" placeholder="Enter notes for this insurance which will be visible to the client"></InputTextArea>
                                <ValidationMessage class="offset-sm-3" For="@(() => Insurance.BrokerNotes)" />
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Cost PM and PY</label>
                            <div class="row col-sm-5">
                                <MudItem class="col" >
                                    <MudTextField @bind-Value="@Insurance.Cost" Clearable="true" HelperText="Enter a cost" Format="F2" Adornment="Adornment.Start" AdornmentText="£" />
                                    <ValidationMessage class="offset-sm-3" For="@(() => Insurance.Cost)" />
                                </MudItem>
                                <MudRadioGroup class="col-sm-4" @bind-SelectedOption="@Insurance.Annual">
                                    <MudRadio Option="@true">Annual</MudRadio>
                                    <MudRadio Option="@false">Monthly</MudRadio>
                                </MudRadioGroup>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Start Date</label>
                            <div class="col-sm-5">
                                <DateRangePicker @bind-StartDate="StartDate" SingleDatePicker="true" class="form-control" Culture="@(System.Globalization.CultureInfo.GetCultureInfo("en-GB"))"></DateRangePicker>
                                <ValidationMessage class="offset-sm-3" For="@(() => Insurance.StartDate)" />
                            </div>
                            <div class="col-sm-2">
                                <MudCheckBox @bind-Checked="@Insurance.ShowStartDate" Label="Show"/>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Review Date</label>
                            <div class="col-sm-5">
                                <DateRangePicker @bind-StartDate="ReviewDate" SingleDatePicker="true" class="form-control " Culture="@(System.Globalization.CultureInfo.GetCultureInfo("en-GB"))"></DateRangePicker>
                                <ValidationMessage class="offset-sm-3" For="@(() => Insurance.ReviewDate)" />
                            </div>
                            <div class="col-sm-2">
                                <MudCheckBox @bind-Checked="@Insurance.ShowReviewDate" Label="Show"/>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Expiry Date</label>
                            <div class="col-sm-5">
                                <DateRangePicker @bind-StartDate="ExpiryDate" SingleDatePicker="true" class="form-control" Culture="@(System.Globalization.CultureInfo.GetCultureInfo("en-GB"))"></DateRangePicker>
                                <ValidationMessage class="offset-sm-3" For="@(() => Insurance.ExpiryDate)" />
                            </div>
                            <div class="col-sm-2">
                                <MudCheckBox @bind-Checked="@Insurance.ShowExpiryDate" Label="Show"/>
                            </div>
                        </div>


                        @if(BrokerIQ.Dto.Extensions.Extensions.IsTermTypeInsurance(Insurance.InsType)){

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Term Type</label>
                            <div class="col-sm-5">

                                <InputSelect id="termtype" class="form-control" @bind-Value="@TermType">
                                @{
                                    var names = Enum.GetNames(typeof(TermTypeEnum));
                                    for (int i = 0; i < names.Length; i++)
                                    {
                                        var looped = (TermTypeEnum)i;
                                        <option value=@i>@looped.GetDisplayName()</option>
                                    }
                                }
                                </InputSelect>
                                <ValidationMessage class="offset-sm-3" For="@(() => TermType)" />

                            </div>
                        </div>

                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Term</label>
                                <div class="col-sm-5">
                                    <MudItem class="col">
                                        <MudTextField @bind-Value="@Insurance.TermYears" HelperText="Enter a term" Format="" Adornment="Adornment.Start" AdornmentText="Years" />
                                        <ValidationMessage class="offset-sm-3 col-sm-7" For="@(() => Insurance.TermYears)" />
                                    </MudItem>
                                </div>
                                <div class="col-sm-2 mt-5">
                                    <MudCheckBox @bind-Checked="@Insurance.ShowTermYears" Label="Show"/>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Benefit Amount</label>
                                <div class="col-sm-5">
                                    <MudItem class="col" >
                                        <MudTextField @bind-Value="@Insurance.TermAmount" HelperText="Enter a benefit amount" Format="F2" Adornment="Adornment.Start" AdornmentText="£" />
                                        <ValidationMessage class="offset-sm-3 col-sm-7" For="@(() => Insurance.TermAmount)" />
                                    </MudItem>
                                </div>
                                <div class="col-sm-2 mt-5">
                                    <MudCheckBox @bind-Checked="@Insurance.ShowTermAmount" Label="Show"/>
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Deferred Period</label>
                                <div class="col-sm-5">
                                    <MudItem class="col">
                                        <MudTextField @bind-Value="@Insurance.DeferredPeriodWeeks" HelperText="Enter a deferred period" Format="" Adornment="Adornment.Start" AdornmentText="Weeks" />
                                        <ValidationMessage class="offset-sm-3 col-sm-7" For="@(() => Insurance.DeferredPeriodWeeks)" />
                                    </MudItem>
                                </div>
                                <div class="col-sm-2 mt-5">
                                    <MudCheckBox @bind-Checked="@Insurance.ShowDeferredPeriodWeeks" Label="Show" />
                                </div>
                            </div>
                        }

                        @if (BrokerIQ.Dto.Extensions.Extensions.IsSecondTermTypeInsurance(Insurance.InsType))
                        {
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label">Second Benefit Amount</label>
                                <div class="col-sm-5">
                                    <MudItem class="col">
                                        <MudTextField @bind-Value="@Insurance.SecondTermAmount" HelperText="Enter a benefit amount" Format="F2" Adornment="Adornment.Start" AdornmentText="£" />
                                        <ValidationMessage class="offset-sm-3 col-sm-7" For="@(() => Insurance.SecondTermAmount)" />
                                    </MudItem>
                                </div>
                                <div class="col-sm-2 mt-5">
                                    <MudCheckBox @bind-Checked="@Insurance.ShowSecondTermAmount" Label="Show" />
                                </div>
                            </div>
                        }

                        @if (BrokerIQ.Dto.Extensions.Extensions.IsFractureCoverInsurance(Insurance.InsType))
                        {
                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Fracture cover</label>
                                <div class="col-sm-5">
                                    <MudCheckBox @bind-Checked="@Insurance.FractureCover" />
                                </div>
                                <div class="col-sm-2">
                                    <MudCheckBox @bind-Checked="@Insurance.ShowFractureCover" Label="Show" />
                                </div>
                            </div>
                        }

                        @if (Insurance.InsType == InsuranceEnum.Life || Insurance.InsType == InsuranceEnum.CriticalIllness)
                        {
                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Is In Trust</label>
                                <div class="col-sm-5">
                                    <MudCheckBox @bind-Checked="@Insurance.IsInTrust" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Has Will</label>
                                <div class="col-sm-5">
                                    <MudCheckBox @bind-Checked="@Insurance.HasWill" />
                                </div>
                            </div>
                        }

                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Is Available to Client</label>
                            <div class="col-sm-5">
                                <MudCheckBox @bind-Checked="@AvailableToClient" />
                            </div>
                        </div>

                        @if(Insurance.Id == 0){
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">Send Notification</label>
                            <div class="col-sm-5">
                                <MudCheckBox @bind-Checked="@SendNotification" Disabled="@(!Insurance.AvailableToClient)"/>
                            </div>
                        </div>
                        }
                        
                        @if (Broker != null && Broker.ProvidesBusinessInsuranceServices && BrokerIQ.Dto.Extensions.Extensions.IsBusinessInsurance(Insurance.InsType))
                            {
                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Policy number</label>
                                <div class="col-sm-5">
                                    <MudItem class="col">
                                        <MudTextField @bind-Value="@Insurance.PolNumber" HelperText="Enter a policy number" Format="" />
                                        <ValidationMessage class="offset-sm-3 col-sm-7" For="@(() => Insurance.PolNumber)" />
                                    </MudItem>
                                </div>
                                <div class="col-sm-2 mt-5">
                                    <label>Show</label>
                                    <MudCheckBox @bind-Checked="@Insurance.ShowPolNumber" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Payment Method</label>
                                <div class="col-sm-5">

                                    <InputSelect id="termtype" class="form-control" @bind-Value="@PaymentMethod">
                                        @{
                                            var names = Enum.GetNames(typeof(PaymentMethodEnum));
                                            for (int i = 0; i < names.Length; i++)
                                            {
                                                var looped = (PaymentMethodEnum)i;
                                                <option value=@i>@looped.GetDisplayName()</option>
                                            }
                                        }
                                    </InputSelect>
                                    <ValidationMessage class="offset-sm-3" For="@(() => PaymentMethod)" />

                                </div>
                                <div class="col-sm-2 ">
                                    <label>Show</label>
                                    <MudCheckBox @bind-Checked="@Insurance.ShowPaymentMethod" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Retroactive Date</label>
                                <div class="col-sm-5">
                                    <DateRangePicker @bind-StartDate="ReviewDate" SingleDatePicker="true" class="form-control " Culture="@(System.Globalization.CultureInfo.GetCultureInfo("en-GB"))"></DateRangePicker>
                                    <ValidationMessage class="offset-sm-3" For="@(() => Insurance.RetroactiveDate)" />
                                </div>
                                <div class="col-sm-2">
                                    <label>Show</label>
                                    <MudCheckBox @bind-Checked="@Insurance.ShowRetroactiveDate" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Jurisdiction</label>
                                <div class="col-sm-5">
                                    <MudItem class="col">
                                        <MudTextField @bind-Value="@Insurance.Jurisdiction" HelperText="Enter a jurisdiction" Format=""  />
                                        <ValidationMessage class="offset-sm-3 col-sm-7" For="@(() => Insurance.Jurisdiction)" />
                                    </MudItem>
                                </div>
                                <div class="col-sm-2 mt-5">
                                    <label>Show</label>
                                    <MudCheckBox @bind-Checked="@Insurance.ShowJurisdiction" />
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-sm-3 col-form-label">Territorial Limit</label>
                                <div class="col-sm-5">
                                    <MudItem class="col">
                                        <MudTextField @bind-Value="@Insurance.TerritorialLimit" HelperText="Enter a territorial limit" Format=""  />
                                        <ValidationMessage class="offset-sm-3 col-sm-7" For="@(() => Insurance.TerritorialLimit)" />
                                    </MudItem>
                                </div>
                                <div class="col-sm-2 mt-5">
                                    <label>Show</label>
                                    <MudCheckBox @bind-Checked="@Insurance.ShowTerritorialLimit" />
                                </div>
                            </div>
                        }
                        @if (IsAdmin)
                        {
                            <div class="form-group row">
                                <label class="col-sm-4 col-form-label">Choose Broker</label>
                                <div class="col-sm-8">
                                    <InputSelect id="broker" class="form-control" @bind-Value="@BrokerListId">

                                        @foreach (var broker in @Brokers)
                                                {
                                            <option value=@broker.Id>@broker.Name</option>
                                                }
                                    </InputSelect>
                                    <ValidationMessage class="offset-sm-3" For="@(() => BrokerListId)" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </EditForm>

    </section>
    

    <h4 class ="col-sm-4">Supporting Documents</h4>

    @if (Insurance.SupportingDocuments != null)
    {
        <div class="col-sm-6 mt-1">
            <div class="card">
                <div class="card-body">
                    <MudTable Items="@Insurance.SupportingDocuments" Hover="true" SortLabel="Sort By">
                        <RowTemplate>
                            <MudTd>@context.FileName</MudTd>
                            @if (Insurance.Id > 0)
                            {
                                <MudTd> <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => PreviewFile(context))" class="btn btn-link">View</MudButton></MudTd>
                                <MudTd> <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DownloadFile(context))" class="btn btn-link">Download</MudButton></MudTd>
                                <MudTd> <MudButton Variant="Variant.Filled" Color="Color.Error" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DeleteInsuranceFile(context.Id))" class="btn btn-link">Delete</MudButton></MudTd>
                            }
                            else
                            {            
                               <MudTd> <MudButton Variant="Variant.Filled" Color="Color.Error" Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DeleteInsuranceFile(context.Id))" class="btn btn-link">Delete</MudButton></MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                </div>
            </div>
        </div>
    }

    <div class="col-sm-6 mt-1">
        <div class="card">
            <div class="card-body">
                <label class="card-title">Upload pdf files</label>
                    <div class="@HoverClass mt-1" @ondragenter="OnDragEnter" @ondragover="OnDragEnter" @ondragleave="OnDragLeave" @ondrop="OnDragLeave" >
                            <MudPaper class="drag-drop-zone">
                                <InputFile OnChange="LoadFiles" multiple Class="drag-drop-input" accept="application/pdf" />
                                <MudText Typo="Typo.subtitle1">Drag and drop pdf files here or click to browse</MudText>
                            </MudPaper>
                    </div>
            </div>
        </div>
    </div>

    <label type="text" class="form-control-plaintext col-sm-4">@LoadFileStatus</label>
    <div class="col-sm">
        <div class="spin-row spin-row-bg">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" style="@SpinnerVisible" />
        </div>
    </div>

    <div > 
        @if (Insurance?.Id > 0)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" Style="@($"color:{Colors.Shades.Black};")" OnClick="@DeleteInsurance" Class="mr-8">Delete</MudButton>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" Class="mr-1">Cancel</MudButton>

        @if(Insurance?.Id > 0){

            <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" form="@FormId" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" Class="mr-1">Save insurance</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" ButtonType="ButtonType.Submit" form="@FormId" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")">Add insurance</MudButton>
        }
    </div>
}
else
{
    <div class="alert @StatusClass">@Message</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Back to client overview</MudButton>
}
