@page "/messagelist"
@inherits MessageListBase
@using System.IO
@using BrokerIQ.Dto.Models
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Extensions
@using BrokerIQ.Online.Services.Interface
@using BrokerIQ.Online.Server.Helper

@if (!Saved)
{
    @if (BrokerNotificationsSubset == null)
    {
        <div>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
        </div>
    }
    else
    {
        @if (User.IsAdmin)
        {
            <div class="card mb-1">
                <div class="card-header">Filter</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-4 control_wrapper">
                            <MudSelect T="int"
                                       Label="Filter By Broker"
                                       Placeholder="Select"
                                       Clearable="true"
                                       @bind-Value="BrokerId"
                                       SelectedValuesChanged="@AutoCompleteClickBroker"
                                       AdornmentColor="Color.Primary">
                                <MudSelectItem Value="0">Select</MudSelectItem>
                                @foreach (var item in @Brokers)
                                {
                                    <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if ((User.IsBroker || User.IsAdminStaff))
        {
            <div class="row">
                <MudButton HtmlTag="label" Class="col-4 ml-4 mb-2" Variant="Variant.Filled" Color="Color.Primary" Disabled="AllMessagesRead"
                           Style="@($"color:{Colors.Shades.Black};")" StartIcon="@Icons.Filled.Delete" OnClick="@(async () => await ClearAllNotifications())">
                    Action All In System
                </MudButton>
            </div>
        }
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
            <MudTabPanel Text="Action stream">
                <BrokerNotificationTable User="@User" Brokers="@Brokers" Notifications="@(BrokerNotificationsSubset.Where(n=> !n.Read).ToList())" OnStatusToggle="@(async () => await RefreshMessages())" />
            </MudTabPanel>
            <MudTabPanel Text="Actioned">
                <BrokerNotificationTable User="@User" Brokers="@Brokers" Notifications="@(BrokerNotificationsSubset.Where(n=> n.Read).ToList())" OnStatusToggle="@(async () => await RefreshMessages())" />
            </MudTabPanel>
        </MudTabs>
    }
}
else
{
    <div class="alert @StatusClass">@Message</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Back to message list</MudButton>
}