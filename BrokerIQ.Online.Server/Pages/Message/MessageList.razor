@page "/messagelist"
@inherits MessageListBase
@using System.IO
@using BrokerIQ.Dto.Models
@using BrokerIQ.Online.Pages
@using BrokerIQ.Online.Server.Extensions
@using BrokerIQ.Online.Services.Interface
@using BrokerIQ.Online.Server.Helper
@inject IEmailService EmailService

<h3 class="page-title">Reminders</h3>

@if (!Saved)
{
    @if (BrokerNotificationsSubset == null)
    {
        <div>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header">Filter</div>
            <div class="card-body">
                @if (User.IsAdmin)
                {
                    <div class="row">

                        <div class="col-lg-4 control_wrapper">
                            <MudSelect T="int"
                                       Label="Filter By Broker"
                                       Placeholder="Select"
                                       Clearable="true"
                            @bind-Value="BrokerId"
                                       SelectedValuesChanged="@AutoCompleteClickBroker"
                                       AdornmentColor="Color.Primary">
                                <MudSelectItem Value="0">Select</MudSelectItem>
                                @foreach (var item in @Brokers)
                                {
                                    <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </div>
                }
            </div>
        </div>
        <MudTable Items="@BrokerNotificationsSubset" Hover="true" SortLabel="Sort By">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.BrokerNotification, object>(x=>x.Message)">Message</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<BrokerIQ.Online.Models.BrokerNotification, object>(x=>x.SentDate)">Sent</MudTableSortLabel></MudTh>
                @if (User.IsAdmin)
                {
                    <MudTh>Broker</MudTh>
                }
                else{
                    <MudTh Style="text-align:center"><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.BrokerNotification, object>(x=>x.Read)">Actioned</MudTableSortLabel></MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Message">
                    @if (context.HasLink)
                    {
                        var messageParts = @context.FormattedLinkMessage;
                        var url = context.HasEmbeddedLink ? messageParts[1] :
                                context.IsReferral ? "referrals" : $"clientdetail/{context.RelevantCustomerId}";

                        <span>@messageParts[0]</span>
                        <MudLink href="@url" Color="Color.Tertiary">
                            @messageParts[1]
                        </MudLink>
                        @messageParts[2]
                    }
                    else
                    {
                        @context.Message           
                    }
                </MudTd>
                <MudTd DataLabel="Sent">@context.SentDate.ToBiqDateTimeString()</MudTd>   
                @if (User.IsAdmin)
                {
                    <MudTd>@Brokers.FirstOrDefault(x => x.Id == context.BrokerId)?.Name</MudTd>
                }
                else{
                <MudTd Style="text-align:center">
                    @if (!context.Read){
                    <MudCheckBox @bind-Checked="@context.Read" @onclick="async f => await SetReminderReadStatus(context.Id)" />
                    }
                    else{
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" @onclick="async f => await SetReminderReadStatus(context.Id)" />
                    }
                </MudTd>
                }
            </RowTemplate>
            <PagerContent>
                <MudTablePager  PageSizeOptions="new int[]{10, 25, 50, 100}" />
            </PagerContent>
        </MudTable>

    }
}
else
{
    <div class="alert @StatusClass">@Message</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Back to message list</MudButton>
}