@page "/messagelist"
@inherits MessageListBase
@using System.IO
@using BrokerIQ.Dto.Models
@using BrokerIQ.Online.Services.Interface
@using BrokerIQ.Online.Server.Helper
@inject IEmailService EmailService
@inject MessageCountState MyMessageCountState

<h1 class="page-title">All Messages</h1>

@if (!Saved)
{
    @if (BrokerNotifications == null)
    {
        <div class="row ml-2 ">
            <div class="col-4 mt-2">
                <h3>Loading</h3>
            </div>
        </div>
        <div class="row ml-2">
            <div class="col-4">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
            </div>
        </div>
    }
    else
    {
        <table id="table-message" class="table col-sm-12 table-striped ">
            <thead>
                <tr>
                    <th class="col-md-6">Message</th>
                    <th class="col-md-4">Sent</th>
                    @if (IsAdmin)
                    {
                        <th>Broker</th>
                    }
                </tr>

            </thead>
            <tbody>
                @foreach (var message in BrokerNotifications)
                {
                    <tr style="@message.RowStyle">
                        <td>@Path.GetFileNameWithoutExtension(message.Message)</td>
                        <td>@(message.SentDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss"))</td>
                        @if (IsAdmin)
                        {
                            <td>@Brokers.FirstOrDefault(x => x.Id == message.BrokerId)?.Name</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
}
else
{
    <div class="alert @StatusClass">@Message</div>
    <a class="btn btn-outline-primary" @onclick="@NavigateToOverview">Back to message list</a>
}

@code{
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        MyMessageCountState.MessageCount = 0;
    }

}