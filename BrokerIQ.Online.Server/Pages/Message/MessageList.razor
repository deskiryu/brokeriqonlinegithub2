@page "/messagelist"
@inherits MessageListBase
@using System.IO
@using BrokerIQ.Dto.Models
@using BrokerIQ.Online.Services.Interface
@using BrokerIQ.Online.Server.Helper
@inject IEmailService EmailService
@inject MessageCountState MyMessageCountState

<h3 class="page-title">Reminders</h3>

@if (!Saved)
{
    @if (BrokerNotifications == null)
    {
        <div>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
        </div>
    }
    else
    {

        <MudTable Items="@BrokerNotifications" Hover="true" SortLabel="Sort By" >
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.BrokerNotification, object>(x=>x.Message)">Message</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.BrokerNotification, object>(x=>x.SentDate)">Sent</MudTableSortLabel></MudTh>
                @if (IsAdmin)
                {
                    <MudTh>Broker</MudTh>
                }
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Message">
                    @if (context.RelevantCustomerId > 0 && context.FormattedLinkMessage!=null && context.FormattedLinkMessage.Count==3)
                    {
                        @context.FormattedLinkMessage[0]
                        <MudLink href="@($"clientdetail/{@context.RelevantCustomerId}")" Color="Color.Tertiary">
                            @context.FormattedLinkMessage[1]
                        </MudLink>
                        @context.FormattedLinkMessage[2]
                    }
                    else
                    {
                        @context.Message           
                    }

                </MudTd>
                <MudTd DataLabel="Sent">@context.SentDate</MudTd>   
                @if (IsAdmin)
                {
                    <MudTd>@Brokers.FirstOrDefault(x => x.Id == context.BrokerId)?.Name</MudTd>
                }

            </RowTemplate>
            <PagerContent>
                <MudTablePager  PageSizeOptions="new int[]{10, 25, 50, 100}" />
            </PagerContent>
        </MudTable>

    }
}
else
{
    <div class="alert @StatusClass">@Message</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")" OnClick="@NavigateToOverview" class="btn btn-link">Back to messge list</MudButton>
}

@code{
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        MyMessageCountState.MessageCount = 0;
    }

}