@page "/referrals"
@inherits ClientReferralBase
@using BrokerIQ.Online.Pages
@using System
@using BrokerIQ.Online.Server.Extensions
@using Dto.Enum
@inject NavigationManager NavigationManager

<h3>Referrals</h3>

@if (!Saved)
{
    @if (ClientReferralsSent == null)
    {
        <div>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    Client referrals
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-6 control_wrapper mb-5">
                        <label>Filter By Referrer</label>
                        <input @bind-value="NameSearchTerm" @bind-value:event="oninput" placeholder="Type referrer name"
                            class="filter_customerBroker" />
                    </div>
                    <div class="col-lg-6 control_wrapper mb-5">
                        <label>Filter By Name</label>
                        <input @bind-value="ReferralSearchTerm" @bind-value:event="oninput" placeholder="Type name"
                            class="filter_customerBroker" />
                    </div>
                </div>

        @if (IsAdmin)
        {
                <div class="row mt-1">

                    <div class="col-lg-6 control_wrapper mb-5">
                        <MudSelect T="int" Label="Filter By Broker" Placeholder="Select" Clearable="true" @bind-Value="BrokerId"
                            SelectedValuesChanged="@AutoCompleteClickBroker" AdornmentColor="Color.Primary">
                            <MudSelectItem Value="0">Select</MudSelectItem>
                            @foreach (var item in @Brokers)
                            {
                                <MudSelectItem Value="@item.Id">@item.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </div>
        }
                <div class="card">
                    <div class="card-header">Email Invites</div>
                    <div class="card-body">
                        <MudTable Items="@FilteredClientReferrals" Hover="true" SortLabel="Sort By" MultiSelection="true"
                        @bind-SelectedItems="ClientReferralsSelected">
                            <HeaderContent>
                                @if (IsAdmin)
                                {
                                    <MudTh><MudTableSortLabel
                                        SortBy="new Func<BrokerIQ.Online.Models.ClientReferral, object>(x=>x.BrokerName)">Broker</MudTableSortLabel></MudTh>
                                }
                                <MudTh>
                                    <MudTableSortLabel
                                        SortBy="new Func<BrokerIQ.Online.Models.ClientReferral, object>(x=>x.CustomerName)">
                                        Referred By</MudTableSortLabel>
                                </MudTh>
                                <MudTh>
                                    <MudTableSortLabel
                                        SortBy="new Func<BrokerIQ.Online.Models.ClientReferral, object>(x=>x.ReferralName)">Name
                                    </MudTableSortLabel>
                                </MudTh>
                                <MudTh>
                                    <MudTableSortLabel Enabled="@false"
                                        SortBy="new Func<BrokerIQ.Online.Models.ClientReferral, object>(x=>x.ReferralEmailAddress)">
                                        Email</MudTableSortLabel>
                                </MudTh>
                                <MudTh>
                                    <MudTableSortLabel
                                        SortBy="new Func<BrokerIQ.Online.Models.ClientReferral, object>(x=>x.ReferralTelephoneNumber)">
                                        Phone</MudTableSortLabel>
                                </MudTh>
                                <MudTh>App Registered</MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<BrokerIQ.Online.Models.ClientReferral, object>(x=>x.ConvertedToProduct.GetDisplayName())">Status</MudTableSortLabel></MudTh>
                                <MudTh>Prize Awarded</MudTh>
                                <MudTh>Notes</MudTh>
                                <MudTh>Delete</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                @if (IsAdmin)
                                {
                                    <MudTd DataLabel="Broker">@context.BrokerName</MudTd>
                                }
                                <MudTd>
                                    <MudLink href="@($"clientdetail/{@context.CustomerId}")" Color="Color.Tertiary">
                                        @context.CustomerName
                                    </MudLink>
                                </MudTd>
                                <MudTd DataLabel="Name">@context.ReferralName</MudTd>
                                <MudTd DataLabel="Email">@context.ReferralEmailAddress</MudTd>
                                <MudTd DataLabel="Phone">@context.ReferralTelephoneNumber</MudTd>
                                <MudTd DataLabel="App Registered">
                                    <MudCheckBox @bind-Checked="@context.ConvertedLoggedIn" Disabled="true"></MudCheckBox>
                                </MudTd>
                                <MudTd DataLabel="Status">
                                    <MudMenu Dense="true">
                                        <ActivatorContent>
                                            <MudButton style="text-transform: none;" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowDropDown">@GetConvertedToProductDisplayName(context)</MudButton>
                                        </ActivatorContent>
                                        <ChildContent>
                                            @for (int i = 0; i < Enum.GetValues(typeof(ConvertedToProductEnum)).Length; i++)
                                            {
                                                var looped = (ConvertedToProductEnum)i;
                                                <MudMenuItem OnClick="@(e => OnConvertedToProductClick(context, (int)looped))">@looped.GetDisplayName()</MudMenuItem>
                                            }
                                        </ChildContent>
                                    </MudMenu>
                                </MudTd>
                                <MudTd DataLabel="Prize Awarded">
                                    <MudCheckBox @bind-Checked="@context.PrizeAwarded" @onclick="() => OnPrizeClick(context)">
                                    </MudCheckBox>
                                </MudTd>
                                <MudTd DataLabel="Notes">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                        Style="@($"color:{Colors.Shades.Black};")"
                                        OnClick="() => EditNote(context.ReferralNote, context)"
                                        class="btn btn-primary table-btn">
                                        <i class="fas fa-sticky-note"></i>
                                    </MudButton>
                                </MudTd>
                                <MudTd DataLabel="">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                        Style="@($"color:{Colors.Shades.Black};")" OnClick="@(f => DeleteLink(context.Id))">
                                        <i class="fas fa-trash"></i>
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
                            </PagerContent>
                        </MudTable>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="alert @StatusClass">@Message</div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="@($"color:{Colors.Shades.Black};")"
        OnClick="@NavigateToOverview" class="btn btn-link">Back to invite list</MudButton>
}

