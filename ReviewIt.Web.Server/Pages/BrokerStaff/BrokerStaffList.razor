@page "/brokerstafflist"
@using ReviewIt.Web.Services.Interface
@inherits BrokerStaffListBase

@inject INotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IAlertService AlertService


<h1 class="page-title">Employees</h1>

@if (!Saved)
{
    @if (BrokerStaff == null)
    {
        <div class="row ml-2 ">
            <div class="col-4 mt-2">
                <h3>Loading</h3>
            </div>
        </div>
        <div class="row ml-2">
            <div class="col-4">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
            </div>
        </div>
    }
    else
    {

        <NavLink href="@($"brokerstaffadd")" class="btn btn-primary mb-2">
            Add New Employee
        </NavLink>

        <div class="table-responsive">
            <table id="table-broker" class="table col-sm-12 table-striped ">
                <thead>
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        @if (IsAdmin)
                        {
                            <th>Broker</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bStaff in BrokerStaff)
                    {
                        <tr>
                            <td>@bStaff.FirstName</td>
                            <td>@bStaff.LastName</td>
                            <td>@bStaff.EmailAddress</td>
                            @if (IsAdmin)
                            {
                                var broker = @Brokers.FirstOrDefault(x => x.Id == bStaff.BrokerId);
                                <td>@broker.Name</td>
                            }
                            <NavLink href="@($"brokerStaffedit/{bStaff.Id}")" class="btn btn-primary table-btn">
                                <i class="fas fa-edit"></i>
                            </NavLink>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @code {

        }
    }
}
else
{
    <div class="alert @StatusClass">@Message</div>
    <a class="btn btn-outline-primary" @onclick="@NavigateToOverview">Back to employee list</a>
}

