@page "/audiolist"
@inherits AudioListBase
@using System.IO
@using BrokerIQ.Dto.Models
@using ReviewIt.Web.Services.Interface
@inject IEmailService EmailService
@inject IJSRuntime jsRuntime


<h1 class="page-title">All Audios</h1>

<button class="btn btn-primary table-btn ml-lg-2 mt-1" @onclick="AddRecording">
    Add Recording
</button>
@code
{

    private async Task AddRecording()
    {
        await VerifyBroker();
        var dialogParams = new DialogParameters();
        dialogParams.Add("BrokerId", BrokerId);
        var dialogOptions = new DialogOptions()
        {
            MaxWidth = MaxWidth.Medium
        };

        var result = await DialogService.Show<ReviewIt.Web.Server.Shared.AudioRecordDialog>("Record voice message", dialogParams, dialogOptions).Result;
        if (!result.Cancelled)
        {
            NavigationManager.NavigateTo($"/audiolist");
        }

    }
}

@if (!Saved)
{
    @if (Audios == null)
    {
        <div class="row ml-2 ">
            <div class="col-4 mt-2">
                <h3>Loading</h3>
            </div>
        </div>
        <div class="row ml-2">
            <div class="col-4">
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
            </div>
        </div>
    }
    else
    {
        <div class="mt-5">
            <h5>Upload Audio</h5>
        </div>

        <p>@status</p>
        <div class="col-sm">
            <div class="spin-row spin-row-bg">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" style="@SpinnerVisible" />
            </div>
        </div>

        <MudDialog @bind-IsVisible="RenameUploadVisibility">
            <TitleContent>
                Upload & rename Audio
            </TitleContent>
            <DialogContent>

                <MudInputString ID="inVal" @bind-Value="@AudioName" Type="InputType.Text" Placeholder="" />
            </DialogContent>
            <DialogActions>
                <MudButton Color="Color.Secondary" OnClick="OnCancelPushed">Cancel</MudButton>
                <MudButton Color="Color.Primary" OnClick="UploadButtonPushed">Ok</MudButton>
            </DialogActions>
        </MudDialog>


        <table id="table-Audio" class="table col-sm-12 table-striped ">
            <thead>
                <tr>
                    <th class="col-md-10">Uploaded Audio</th>
                    <th class="col-md-1">Listen</th>
                    <th class="col-md-1">Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var Audio in Audios)
                {
                    <tr>
                        <td>@Path.GetFileNameWithoutExtension(Audio.Name)</td>
                        <td>
                            <NavLink href="@($"audiodetail?url={Audio.Url}")" class="btn btn-primary table-btn">
                                <i class="fas fa-headphones"></i>
                            </NavLink>
                        </td>

                        <td>
                            <button class="btn btn-primary table-btn" @onclick="f => DeleteAudio(Audio.Name)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

}
else
{
    <div class="alert @StatusClass">@Message</div>
    <a class="btn btn-outline-primary" @onclick="@NavigateToOverview">Back to Audio list</a>
}

@code{

     public string SpinnerVisible { get; set; }

     protected override async Task OnInitializedAsync()
     {
         SpinnerVisible = "display:none";
     }


     public async Task UploadButtonPushed()
     {

     }
 } 
