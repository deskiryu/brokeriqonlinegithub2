@page "/account/login"


@using Microsoft.Extensions.Options
@using ReviewIt.Web.AppSettings
@using ReviewIt.Web.Services.Interface
@using ReviewIt.Web.Server.Helper
@using BrokerIQ.Dto.Response
@using ReviewIt.Web.Server.Extensions

@inject IAccountService AccountService
@inject IAlertService AlertService
@inject NavigationManager NavigationManager
@inject LoggedInAppState MyLoggedInAppState
@inject IOptions<ReviewItAPIDetails> api
@inject IJSRuntime js

@functions {
    async void StartWarningTimer()
    {
        await Extensions.StartWarningTimer(js,api.Value.AutoLogoutTimeMs);
    }
}


<div class="card">
    <h4 class="card-header">Login</h4>
    <div class="card-body">
        <EditForm Model="@model" OnValidSubmit="OnValidSubmit">
            <DataAnnotationsValidator />
            <div class="form-group">
                <label>Email Address</label>
                <InputText @bind-Value="model.EmailAddress" class="form-control" />
                <ValidationMessage For="@(() => model.EmailAddress)" />
            </div>
            <div class="form-group">
                <label>Password</label>
                <InputText @bind-Value="model.Password" type="password" class="form-control" />
                <ValidationMessage For="@(() => model.Password)" />
            </div>
            <button disabled="@Loading" class="btn btn-primary">
                @if (Loading)
                {
                    <span class="spinner-border spinner-border-sm mr-1"></span>
                }
                Login
            </button>
            <NavLink href="account/register" class="btn btn-link">Register</NavLink>
            <NavLink href="account/resetpassword" class="btn btn-link">Forgot Password</NavLink>
        </EditForm>
    </div>
</div>

@code {

    private ReviewIt.Web.Models.Account.Login model = new ReviewIt.Web.Models.Account.Login();

    public bool Loading { get; set; }

    private async void OnValidSubmit()
    {
        // reset alerts on submit
        AlertService.Clear();

        bool Success = true;
        Loading = true;
        var response = new LoginResponseDto();

        try
        {
            response = await AccountService.Login(model);
        }
        catch (Exception ex)
        {
            Success = false;
        }

        if (Success && response.LoggedIn && !response.IsCustomer)
        {
            if (Success && !response.EmailConfirmed)
            {
                AlertService.Error("Please check your email for the link to verify your account.");
            }
            else
            {
                MyLoggedInAppState.LoggedIn = response.LoggedIn;
                var user = await AccountService.GetUser();
                MyLoggedInAppState.IsAdmin = user.IsAdmin;
                MyLoggedInAppState.IsBroker = user.IsBroker;

                try
                {
                    await InvokeAsync(() =>
                    {
                        NavigationManager.NavigateTo("");
                        StartWarningTimer();

                    });

                }
                catch (Exception ex)
                {
                    AlertService.Error("Navigate failed: " + ex.Message);
                }
            }
        }
        else if (Success && !response.LoggedIn && response.IsLockedOut)
        {
            AlertService.Error($"Your account has been locked from too many login attempts. Please try again in {response.LockoutMinutes} minutes.");
        }
        else
        {
            AlertService.Error("Could not log on the user with this email address / password");
            Success = false;
        }

        Loading = false;
        StateHasChanged();
    }
}
