@using System.Net
@using System.Text
@using System.IO
@using ReviewIt.Web.Server.Extensions

@inject IJSRuntime js
@functions {
    async void PreviewFile(MemoryStream ms)
    {
        await Extensions.PreviewFile(js, ms);
    }
}

<MudDialog DisableSidePadding="true" Style="width:400px">
    <DialogContent>
        <MudContainer Style="max-height: 500px; overflow-y: scroll">
            @if (Loading)
            {
                <MudProgressCircular Indeterminate="true"></MudProgressCircular>
            }
            else
            {
                @if (@OverSized)
                {
                    <MudText Style="white-space: pre-line;">Some files were too big</MudText>
                    
                }
                @if (FileNameAndStreams.Any())
                {
                     <MudText Style="white-space: pre-line;">The following file(s) :</MudText>
                    @foreach(var fileName in FileNameAndStreams)
                    {
                        <MudText Style="white-space: pre-line; font-weight: bold; margin-top: 5px; margin-bottom: 5px">@fileName.Item1</MudText>                  
                        <MudButton Color="Color.Primary" OnClick="f => PreviewFile(fileName.Item2)">Preview Pdf</MudButton>                  
                    }

                    <MudText Style="white-space: pre-line;">will be sent to this customer: </MudText>
                    <MudText Style="white-space: pre-line; font-weight: bold; margin-top: 5px; margin-bottom: 5px">@Customer</MudText>
                    <MudText Style="white-space: pre-line;">along with a notification</MudText>                   
                }
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Ok">Continue</MudButton>
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public List<string> FileNames { get; set; }

    [Parameter] public string Customer { get; set; }

    [Parameter] public List<MemoryStream> MemoryStreams { get; set; }

    [Parameter] public string Oversize { get; set; }

    private List<(string, MemoryStream)> FileNameAndStreams { get; set; }

    public bool OverSized { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if(!string.IsNullOrEmpty(Oversize) &&  Oversize.Contains("true"))
        {
            OverSized = true;
        }

        Loading = false;
        FileNameAndStreams = new List<(string, MemoryStream)>();

        if(FileNames.Count == MemoryStreams.Count)
        {
            for(int i=0; i<FileNames.Count; i++)
            {
                FileNameAndStreams.Add((FileNames[i], MemoryStreams[i]));
            }            
        }

    }

    private bool Loading = false;

    private void Ok()
    {
        var ReallyOk = FileNameAndStreams.Any();
        if (ReallyOk)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            MudDialog.Close(DialogResult.Cancel());
        }

    }

    private void Cancel()
    {
        MudDialog.Close(DialogResult.Cancel());
    }
}